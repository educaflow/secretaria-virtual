{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "postgres": {
      "command": "sh",
      "args": [
        "-c",
        "[ -f ./ports.env ] && . ./ports.env; exec npx -y @modelcontextprotocol/server-postgres \"postgresql://educaflow:educaflow@localhost:${DB_PORT:-5432}/educaflow\""
      ]
    }
  }
}
