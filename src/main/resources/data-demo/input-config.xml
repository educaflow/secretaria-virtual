<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">


    <!-- Paso 1: Crear usuarios de autenticación (User) -->
    <input file="usuarios-demo.xml" root="datos">
        <bind node="usuarios/usuario" type="com.axelor.auth.db.User"
              search="self.code = :email" create="true" update="true"
              call="com.axelor.auth.AuthService:encrypt">
            <bind node="@email"      to="code"/>
            <bind node="@documento"  to="dni"/>
            <bind node="@name"      to="name"/>
            <bind node="@nombre"    to="nombre"/>
            <bind node="@apellidos" to="apellidos"/>
            <bind node="@email"     to="email"/>
            <bind node="@password"  to="password"/>
            <bind eval="'es'"       to="language"/>
            <bind eval="'users'" alias="groupCode"/>
            <bind to="group" search="self.code = :groupCode" update="false" create="false"/>
        </bind>
    </input>


    <!-- Paso 2: Crear CentroUsuario y actualizar centroActivo del User -->
    <input file="usuarios-demo.xml" root="datos">
        <bind node="centroUsuarios/centroUsuario"
              type="com.educaflow.subsystem.common.db.CentroUsuario"
              search="self.usuario.code = :usuarioCode AND self.centro.code = :centroCode"
              create="true" update="true">
            <bind node="@usuarioCode" alias="usuarioCode"/>
            <bind node="@centroCode"  alias="centroCode"/>
            <bind to="usuario"
                  type="com.axelor.auth.db.User"
                  search="self.code = :usuarioCode"
                  update="true" create="false">
                <bind to="centroActivo"
                      type="com.educaflow.subsystem.common.db.Centro"
                      search="self.code = :centroCode"
                      update="false" create="false"/>
            </bind>
            <bind to="centro"
                  type="com.educaflow.subsystem.common.db.Centro"
                  search="self.code = :centroCode"
                  update="false" create="false"/>
        </bind>
    </input>


    <!-- Paso 3: Crear CentroUsuarioTipoUsuario (sección plana, idempotente) -->
    <input file="usuarios-demo.xml" root="datos">
        <bind node="tipos/tipo"
              type="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
              search="self.centroUsuario.usuario.code = :usuarioCode AND self.centroUsuario.centro.code = :centroCode AND self.tipoUsuario.code = :tipoCode"
              create="true" update="false">
            <bind node="@usuarioCode" alias="usuarioCode"/>
            <bind node="@centroCode"  alias="centroCode"/>
            <bind node="@tipoCode"    alias="tipoCode"/>
            <bind to="centroUsuario"
                  type="com.educaflow.subsystem.common.db.CentroUsuario"
                  search="self.usuario.code = :usuarioCode AND self.centro.code = :centroCode"
                  update="false" create="false"/>
            <bind to="tipoUsuario"
                  type="com.educaflow.subsystem.common.db.TipoUsuario"
                  search="self.code = :tipoCode"
                  update="false" create="false"/>
        </bind>
    </input>


    <!-- Paso 4: Crear Perfil (idempotente por name) -->
    <input file="permisos-demo.xml" root="datos">
        <bind node="perfiles/perfil" type="com.educaflow.subsystem.security.db.Perfil"
              search="self.name = :name" create="true" update="false">
            <bind node="@name" to="name"/>
        </bind>
    </input>


    <!-- Paso 5a: Crear Ace con tipoUsuario (rol genérico) -->
    <input file="permisos-demo.xml" root="datos">
        <bind node="asignacionesTipoUsuario/asignacion" type="com.educaflow.subsystem.security.db.Ace"
              search="self.tipoUsuario.code = :tipoUsuarioCode AND self.perfil.name = :perfilName AND self.tramite.code = :tramiteCode"
              create="true" update="false">
            <bind node="@tipoUsuarioCode" alias="tipoUsuarioCode"/>
            <bind node="@perfilName"      alias="perfilName"/>
            <bind node="@tramiteCode"     alias="tramiteCode"/>
            <bind to="tipoUsuario"
                  type="com.educaflow.subsystem.common.db.TipoUsuario"
                  search="self.code = :tipoUsuarioCode"
                  update="false" create="false"/>
            <bind to="perfil"
                  type="com.educaflow.subsystem.security.db.Perfil"
                  search="self.name = :perfilName"
                  update="false" create="false"/>
            <bind to="tramite"
                  type="com.educaflow.subsystem.expedientes.db.Tramite"
                  search="self.code = :tramiteCode"
                  update="false" create="false"/>
        </bind>
    </input>


    <!-- Paso 5b: Crear Ace con tipoUsuario sobre TipoExpediente -->
    <input file="permisos-demo.xml" root="datos">
        <bind node="asignacionesTipoUsuarioTipoExpediente/asignacion" type="com.educaflow.subsystem.security.db.Ace"
              search="self.tipoUsuario.code = :tipoUsuarioCode AND self.perfil.name = :perfilName AND self.tipoExpediente.code = :tipoExpedienteCode"
              create="true" update="false">
            <bind node="@tipoUsuarioCode"    alias="tipoUsuarioCode"/>
            <bind node="@perfilName"         alias="perfilName"/>
            <bind node="@tipoExpedienteCode" alias="tipoExpedienteCode"/>
            <bind to="tipoUsuario"
                  type="com.educaflow.subsystem.common.db.TipoUsuario"
                  search="self.code = :tipoUsuarioCode"
                  update="false" create="false"/>
            <bind to="perfil"
                  type="com.educaflow.subsystem.security.db.Perfil"
                  search="self.name = :perfilName"
                  update="false" create="false"/>
            <bind to="tipoExpediente"
                  type="com.educaflow.subsystem.expedientes.db.TipoExpediente"
                  search="self.code = :tipoExpedienteCode"
                  update="false" create="false"/>
        </bind>
    </input>


    <!-- Paso 5c: Crear Ace con centroUsuario (usuario concreto en un centro) -->
    <input file="permisos-demo.xml" root="datos">
        <bind node="asignacionesCentroUsuario/asignacion" type="com.educaflow.subsystem.security.db.Ace"
              search="self.centroUsuario.usuario.code = :usuarioCode AND self.centroUsuario.centro.code = :centroCode AND self.perfil.name = :perfilName AND self.tramite.code = :tramiteCode"
              create="true" update="false">
            <bind node="@usuarioCode" alias="usuarioCode"/>
            <bind node="@centroCode"  alias="centroCode"/>
            <bind node="@perfilName"  alias="perfilName"/>
            <bind node="@tramiteCode" alias="tramiteCode"/>
            <bind to="centroUsuario"
                  type="com.educaflow.subsystem.common.db.CentroUsuario"
                  search="self.usuario.code = :usuarioCode AND self.centro.code = :centroCode"
                  update="false" create="false"/>
            <bind to="perfil"
                  type="com.educaflow.subsystem.security.db.Perfil"
                  search="self.name = :perfilName"
                  update="false" create="false"/>
            <bind to="tramite"
                  type="com.educaflow.subsystem.expedientes.db.Tramite"
                  search="self.code = :tramiteCode"
                  update="false" create="false"/>
        </bind>
    </input>


</xml-inputs>