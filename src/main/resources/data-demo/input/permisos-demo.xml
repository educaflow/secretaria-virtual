<?xml version="1.0" encoding="UTF-8"?>
<datos>

    <!-- AccessAssignment con actor = TipoUsuario (rol genérico) -->
    <asignacionesTipoUsuario>
        <!-- PROFESOR puede iniciar (CREADOR) el trámite JustificacionFaltaProfesorado -->
        <asignacion tipoUsuarioCode="PROFESOR"      perfilName="CREADOR"     tramiteCode="JustificacionFaltaProfesorado"/>
        <!-- JEFE_ESTUDIOS es el responsable de resolver (TRAMITADOR) el trámite JustificacionFaltaProfesorado -->
        <!--<asignacion tipoUsuarioCode="JEFE_ESTUDIOS" perfilName="TRAMITADOR" tramiteCode="JustificacionFaltaProfesorado"/>-->
        <!-- El alumno inicia el trámite: el perfil del estado inicial va SIEMPRE por tramiteCode. -->
        <asignacion tipoUsuarioCode="ALUMNO"         perfilName="CREADOR"     tramiteCode="AnulacionMatriculaCicloFormativo"/>
        <!-- El familiar la presenta en nombre del alumno. -->
        <asignacion tipoUsuarioCode="FAMILIAR"       perfilName="CREADOR"     tramiteCode="AnulacionMatriculaCicloFormativo"/>
        <!-- El personal administrativo del centro revisa (no hay cargo de administrativo en cargos.xml). -->
        <asignacion tipoUsuarioCode="ADMINISTRATIVO" perfilName="SECRETARIO"  tramiteCode="AnulacionMatriculaCicloFormativo"/>
        <!-- El supervisor solo consulta: TRAMITADOR es el perfil de consulta con el que abren las
             bandejas genéricas, y ningún estado abierto tiene formulario para él. -->
        <asignacion tipoUsuarioCode="SUPERVISOR"     perfilName="TRAMITADOR" tramiteCode="AnulacionMatriculaCicloFormativo"/>
    </asignacionesTipoUsuario>

    <!-- AccessAssignment con actor = TipoUsuario sobre TipoExpediente concreto -->
    <asignacionesTipoUsuarioTipoExpediente>
    </asignacionesTipoUsuarioTipoExpediente>

    <!-- AccessAssignment con actor = Cargo sobre TipoExpediente concreto -->
    <asignacionesCargoTipoExpediente>
        <asignacion cargoCode="JEFE_ESTUDIOS" perfilName="TRAMITADOR" tipoExpedienteCode="JustificacionFaltaProfesoradoV1"/>
        <asignacion cargoCode="JEFE_ESTUDIOS" perfilName="TRAMITADOR" tipoExpedienteCode="JustificacionFaltaProfesoradoV2"/>
        <!-- Un cargo solo se puede asignar por tipo de expediente: hay que repetir estas filas en
             cada versión nueva del trámite. -->
        <asignacion cargoCode="DIRECTOR"       perfilName="DIRECTOR"    tipoExpedienteCode="AnulacionMatriculaCicloFormativoV1"/>
        <asignacion cargoCode="SECRETARIO"     perfilName="TRAMITADOR" tipoExpedienteCode="AnulacionMatriculaCicloFormativoV1"/>
        <asignacion cargoCode="VICESECRETARIO" perfilName="TRAMITADOR" tipoExpedienteCode="AnulacionMatriculaCicloFormativoV1"/>
    </asignacionesCargoTipoExpediente>

    <!-- AccessAssignment con actor = CentroUsuario (usuario concreto en un centro) -->
    <asignacionesCentroUsuario>
        <!-- Ejemplo:
        <asignacion usuarioCode="c.guijarrorosaleny@edu.gva.es" centroCode="46019660" perfilName="CREADOR" tramiteCode="JustificacionFaltaProfesorado"/>
        -->
    </asignacionesCentroUsuario>

</datos>