<?xml version="1.0"?>
<xml-inputs priority="-1" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <!-- data-init GLOBAL: solo datos verdaderamente transversales que no pertenecen
         a un único sistema/subsistema.

         Los datos y permisos propios de cada sistema/subsistema viven ahora en el
         data-init de cada uno (p.ej. subsystem/common/data-init, system/gruposnotas/data-init),
         con priority="10", por lo que sus permisos se cargan ANTES que este auth.xml
         (priority="-1", el último). auth.xml define los roles y grupos transversales
         (admins, users) y los usuarios, y enlaza los permisos por nombre. -->

    <input file="auth.xml" root="auth">
        <bind node="permission" type="com.axelor.auth.db.Permission" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@object" to="object"/>
            <bind node="@condition" to="condition"/>
            <bind node="@conditionParams" to="conditionParams"/>
            <bind node="can/@create" to="canCreate"/>
            <bind node="can/@read" to="canRead"/>
            <bind node="can/@write" to="canWrite"/>
            <bind node="can/@remove" to="canRemove"/>
            <bind node="can/@export" to="canExport"/>
        </bind>

        <bind node="role" type="com.axelor.auth.db.Role" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@description" to="description"/>
            <bind node="permission" to="permissions" search="self.name = :name">
                <bind node="@name" to="name"/>
            </bind>
        </bind>

        <bind node="group" type="com.axelor.auth.db.Group" search="self.code = :code" create="false" update="true">
            <bind node="@code" to="code"/>
            <bind node="permission" to="permissions" search="self.name = :name">
                <bind node="@name" to="name"/>
            </bind>
        </bind>

        <bind node="users/user" type="com.axelor.auth.db.User" search="self.code = :code" create="true" update="true" call="com.axelor.auth.AuthService:encrypt">
            <bind node="@code" to="code"/>
            <bind node="@language" to="language"/>
            <bind node="@name" to="name"/>
            <bind node="@email" to="email"/>
            <bind node="@password" to="password"/>
            <bind node="@group" to="group" search="self.code = :group" update="false" create="false"/>
        </bind>
    </input>


</xml-inputs>