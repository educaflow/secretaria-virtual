<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <adapter name="DniAdapter" type="com.educaflow.system.importar.services.adapters.DniAdapter"/>

    <input root="centro"  file="dataFile">
        <bind node="docentes/docente | alumnos/alumno"
              type="com.axelor.auth.db.User"
              search="self.code = :code"
              call="com.educaflow.system.importar.services.validators.UserValidator:validate"
              update="true"
              create="true">
            <bind node="@documento" alias="documentoLimpio" adapter="DniAdapter"/>
            <bind to="dni" eval="documentoLimpio"/>
            <bind to="code" eval="documentoLimpio"/>
            <bind to="password" eval="com.axelor.inject.Beans.get(Class.forName('com.axelor.auth.AuthService')).encrypt(documentoLimpio)"/>
            <bind node="@nombre" to="nombre"/>
            <bind node="@email1" to="email"/>

            <bind node="@apellido1" alias="apellido1"/>
            <bind node="@apellido2" alias="apellido2"/>
            <bind to="apellidos" eval="(apellido1 + ' ' + apellido2).trim()" />
            <bind to="language" eval="'es'"/>
            <bind to="forcePasswordChange" eval="true"/>
        </bind>
    </input>
<!-- Comentario para probar el hash -->

</xml-inputs>