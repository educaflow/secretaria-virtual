<?xml version="1.0" encoding="UTF-8"?>
<xml-inputs xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <adapter name="DniAdapter" type="com.educaflow.subsystem.importacion.adapters.DniAdapter"/>

    <!-- Los atributos del nodo raiz se guardan en el context con el nombre atributoRaiz -->
    <input root="centro" file="dataFile">
        <bind node="docentes/docente"
              type="com.educaflow.subsystem.registrousuario.db.UsuarioAutorizado"
              search="self.centro.code = :codigoRaiz AND self.curso = :cursoRaiz AND self.dni = :dniLimpio AND self.tipoUsuario.code = :tipoCodigo"
              update="true"
              create="true">

            <bind node="@documento" alias="dniLimpio" adapter="DniAdapter"/>

            <bind eval="'PROFESOR'" alias="tipoCodigo"/>
            <bind to="tipoUsuario"
                    type="com.educaflow.subsystem.common.db.TipoUsuario"
                    search="self.code = :tipoCodigo"
                    create="false"
                    update="false"
            />

            <bind to="dni" eval="dniLimpio"/>
            <bind to="curso" eval="cursoRaiz"/>
            <bind to="centro"
                  type="com.educaflow.subsystem.common.db.Centro"
                  search="self.code = :codigoRaiz"
                  create="false"
                  update="false"
            />
        </bind>
    </input>
</xml-inputs>