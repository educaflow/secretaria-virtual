<?xml version="1.0" encoding="UTF-8"?>
<xml-inputs xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <adapter name="DniAdapter" type="com.educaflow.subsystem.importacion.adapters.DniAdapter"/>
    <adapter name="TipoUsuarioAdapter" type="com.educaflow.system.importar.services.adapters.TipoUsuarioAdapter"/>

    <input root="centro" file="dataFile">
        <bind node="codigo" alias="centroActual" search="self.code = :@codigo" />

        <bind node="docentes/docente | alumnos/alumno"
              type="com.educaflow.subsystem.common.db.CentroUsuario"
              search="self.usuario.code = :documentoLimpio AND self.centro = :centroActual"
              update="true"
              create="true">

            <bind node="@documento" alias="documentoLimpio" adapter="DniAdapter"/>

            <bind to="usuario"
                  type="com.axelor.auth.db.User"
                  search="self.code = :documentoLimpio"
                  create="false"
                  update="false">
            </bind>

            <bind to="centro" eval="centroActual"/>

            <bind to="centroUsuarioTipoUsuario" type="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario" update="true" create="true">
                <bind to="tipoUsuario" eval="_node.name" adapter="TipoUsuarioAdapter"/>
            </bind>
        </bind>
    </input>
</xml-inputs>