<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <adapter name="DniAdapter" type="com.educaflow.subsystem.importacion.adapters.DniAdapter"/>

    <!--
        CSV de una sola columna con cabecera "dni".
        El centro y el curso llegan por contexto (centroCodigo, curso) inyectados por el servicio.
    -->
    <input file="data.csv"
           type="com.educaflow.subsystem.registrousuario.db.UsuarioAutorizado"
           search="self.centro.code = :centroCodigo AND self.curso = :curso AND self.dni = :dni AND self.tipoUsuario.code = 'PROFESOR_EXTERNO'"
           update="false"
           create="true">

        <bind to="dni" column="dni" adapter="DniAdapter"/>

        <bind to="curso" eval="curso"/>

        <bind to="centro"
              type="com.educaflow.subsystem.common.db.Centro"
              search="self.code = :centroCodigo"
              create="false"
              update="false"/>

        <bind to="tipoUsuario"
              type="com.educaflow.subsystem.common.db.TipoUsuario"
              search="self.code = 'PROFESOR_EXTERNO'"
              create="false"
              update="false"/>
    </input>
</csv-inputs>
