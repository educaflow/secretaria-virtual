<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <input root="centro"  file="alumnos">
        <bind node="docentes/docente" type="com.axelor.auth.db.User" search="self.dni = :documento">
            <bind node="@documento" to="dni"/>
            <bind node="@documento" to="code"/>
            <bind node="@email1" to="email"/>
            <bind node="concat(@nombre, ' ', @apellido1, ' ', @apellido2)" to="name"/>
            <bind to="group" eval="" />
        </bind>
    </input>

