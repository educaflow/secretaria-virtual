<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <adapter name="DocumentAdapter" type="com.educaflow.subsystem.common.importar.DocumentAdapter"/>

    <input root="centro"  file="usuarios">
        <bind node="docentes/docente | alumnos/alumno" type="com.axelor.auth.db.User" search="self.code = :code" call="com.educaflow.subsystem.common.importar.UserValidator:validate" update="true" create="true">
            <bind node="@documento" to="dni" adapter="DocumentAdapter"/>
            <bind node="@documento" to="code" adapter="DocumentAdapter"/>

            <bind node="@nombre" alias="nombre"/>
            <bind node="@apellido1" alias="apellido1"/>
            <bind node="@apellido2" alias="apellido2"/>
            <bind to="name" eval="nombre + ' ' + apellido1 + ' ' + apellido2" if="apellido2 != null"/>
            <bind to="name" eval="nombre + ' ' + apellido1" if="apellido2 == null || apellido2.empty"/>

            <bind to="email" node="@email1"/>

            <bind to="group" search="self.code = 'users'"/>
            <bind to="forcePasswordChange" eval="true"/>
        </bind>

        <!--<bind node="alumnos/alumno" type="com.axelor.auth.db.User" search="self.code = :code" call="com.educaflow.shared.common.importar.UserValidator:validate" update="true" create="true">
            <bind node="@documento" to="dni" adapter="DocumentAdapter"/>
            <bind node="@documento" to="code" adapter="DocumentAdapter"/>

            <bind node="@nombre" alias="nombre"/>
            <bind node="@apellido1" alias="apellido1"/>
            <bind node="@apellido2" alias="apellido2"/>
            <bind to="name" eval="nombre + ' ' + apellido1 + ' ' + apellido2" if="apellido2 != null"/>
            <bind to="name" eval="nombre + ' ' + apellido1" if="apellido2 == null || apellido2.empty"/>

            <bind to="email" node="@email1"/>

            <bind to="group" search="self.code = 'users'"/>
        </bind>-->

    </input>


</xml-inputs>