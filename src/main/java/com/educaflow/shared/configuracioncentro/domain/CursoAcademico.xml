<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

    <module name="configuracioncentro" package="com.educaflow.shared.configuracioncentro.db"/>
    <entity name="CursoAcademico" repository="abstract">
        <string name="code"/>
        <string name="name" namecolumn="true"/>

        <many-to-one name="centro" ref="com.educaflow.shared.common.db.Centro" required="true"/>


        <one-to-many
                name="cursoAcademicoUsuarios"
                ref="com.educaflow.shared.configuracioncentro.db.CursoAcademicoUsuario"
                mappedBy="cursoAcademico"
                title="NO"
        />


        <many-to-one name="importarProfesores" ref="com.axelor.meta.db.MetaFile" title="Fichero profesores" transient="true"/>
        <many-to-one name="importarAlumnos" ref="com.axelor.meta.db.MetaFile" title="Fichero alumnos" transient="true"/>
    </entity>

</domain-models>