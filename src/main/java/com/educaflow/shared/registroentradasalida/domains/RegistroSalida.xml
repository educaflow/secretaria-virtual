<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">

    <module name="registroentradasalida" package="com.educaflow.shared.registroentradasalida.db"/>
    <entity name="RegistroSalida"  repository="abstract">
        <many-to-one name="centro" ref="com.educaflow.shared.common.db.Centro"  />
        <string name="numeroRegistro"  title="Num.__!! registro" namecolumn="true"  />
        <datetime name="fecha" />
        <many-to-one name="documentoOriginal" ref="com.axelor.meta.db.MetaFile" required="true" title="documento Original"/>
        <many-to-one name="documento" ref="com.axelor.meta.db.MetaFile" required="true" title="Documento de salida"/>
        <one-to-many name="anexos" ref="com.axelor.meta.db.MetaFile" title="Anexos" />

        <entity-listener class="com.educaflow.shared.registroentradasalida.db.repo.RegistroSalidaListener"/>
    </entity>

</domain-models>