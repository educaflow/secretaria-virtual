<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">

    <module name="auth" package="com.axelor.auth.db"/>

    <entity name="User" id="Usuario">
        <many-to-one name="centroActivo"       ref="com.educaflow.shared.common.db.Centro" title="Centro Activo" />
        <string name="dni" title="DNI"  />
        <string name="nombre" title="Nombre"  />
        <string name="apellidos" title="Apellidos"  />
    </entity>
</domain-models>