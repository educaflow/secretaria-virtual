<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.0.xsd">



    <form name="user-preferences-form" id="secretariavirtual-user-preferences-form" title="Preferencias" model="com.axelor.auth.db.User" extension="true">

        <extend target="//field[@name='image']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='email']">
            <attribute name="readonly" value="true"/>
        </extend>
        <extend target="//field[@name='theme']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='singleTab']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='noHelp']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//field[@name='language']">
            <insert position="after">
                <field name="noHelp" />
            </insert>
        </extend>

        <extend target="//field[@name='language']">
            <insert position="before">
                <field name="centroActivo"
                       title="Cambiar a Centro:"
                       widget="suggest"
                       domain="self.id IN (SELECT cu.centro.id FROM CentroUsuario cu WHERE cu.usuario.id = :__user__)"/>
            </insert>
        </extend>

        <extend target="//panel[@if='__repo__(UserToken).isPermitted()']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//panel[@if='__repo__(MFA).isPermitted()']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//field[@name='image']">
            <insert position="after">
                <field name="dni"    colSpan="4" />
                <field name="nombre"  colSpan="4" />
                <field name="apellidos"   colSpan="4"  />
            </insert>
        </extend>

        <extend target="//field[@name='email']">
            <insert position="after">
                <field name="centroActivo"  />
            </insert>
        </extend>

    </form>



</object-views>
