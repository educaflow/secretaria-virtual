<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <menuitem name="firma-menu"  title="Firmar documentos"  groups="admins"  order="550"/>

    <menuitem name="firma-todos-menu"  parent="firma-menu" title="Todos" action="firma-todos-main-action" groups="admins" order="2"  />
    <menuitem name="firma-pendientes-menu"  parent="firma-menu" title="Pendientes" action="firma-pendientes-main-action" groups="admins" order="2"  />
    <menuitem name="firma-firmados-menu"  parent="firma-menu" title="Firmados" action="firma-firmados-main-action" groups="admins" order="2"  />
    <menuitem name="firma-rechazados-menu"  parent="firma-menu" title="Rechazados" action="firma-rechazados-main-action" groups="admins" order="2"  />

    <action-view name="firma-todos-main-action"  title="Todos los documentos firmados" model="com.educaflow.subsystem.firma.db.Firma"  >
        <view type="grid" name="firma-Firma-main-grid"/>
        <view type="form" name="firma-Firma-main-form"/>
        <view-param name="show-toolbar" value="false"/>
    </action-view>

    <action-view name="firma-pendientes-main-action"  title="Documentos Pendientes de firmas" model="com.educaflow.subsystem.firma.db.Firma"  >
        <view type="grid" name="firma-Firma-main-grid"/>
        <view type="form" name="firma-Firma-main-form"/>
        <view-param name="show-toolbar" value="false"/>
        <domain>self.estadoFirma= :estadoFirma and firmante.id= :firmanteId</domain>
        <context name="estadoFirma" expr="PENDIENTE"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

    <action-view name="firma-firmados-main-action"  title="Documentos ya firmados" model="com.educaflow.subsystem.firma.db.Firma"  >
        <view type="grid" name="firma-Firma-main-grid"/>
        <view type="form" name="firma-Firma-main-form"/>
        <view-param name="show-toolbar" value="false"/>
        <domain>self.estadoFirma= :estadoFirma and firmante.id= :firmanteId</domain>
        <context name="estadoFirma" expr="FIRMADO"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

    <action-view name="firma-rechazados-main-action"  title="Documentos que se han rechazado firmar" model="com.educaflow.subsystem.firma.db.Firma"  >
        <view type="grid" name="firma-Firma-main-grid"/>
        <view type="form" name="firma-Firma-main-form"/>
        <view-param name="show-toolbar" value="false"/>
        <domain>self.estadoFirma= :estadoFirma and firmante.id= :firmanteId</domain>
        <context name="estadoFirma" expr="RECHAZADO"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>


</object-views>