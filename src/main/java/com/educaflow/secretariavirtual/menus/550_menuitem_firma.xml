<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <menuitem name="firma-menuitem"  title="Firmar documentos"  groups="admins"  order="550"/>

    <menuitem name="firma-todos-menuitem"      parent="firma-menuitem" title="Todos"      action="firma-TareaFirma-todos-action"      groups="admins" order="1"/>
    <menuitem name="firma-pendiente-menuitem"  parent="firma-menuitem" title="Pendientes" action="firma-TareaFirma-pendiente-action"  groups="admins" order="2"/>
    <menuitem name="firma-firmado-menuitem"    parent="firma-menuitem" title="Firmados"   action="firma-TareaFirma-firmado-action"    groups="admins" order="3"/>
    <menuitem name="firma-rechazado-menuitem"  parent="firma-menuitem" title="Rechazados" action="firma-TareaFirma-rechazado-action"  groups="admins" order="4"/>

    <action-view name="firma-TareaFirma-todos-action" title="Todos los documentos firmados" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <view type="grid" name="firma-TareaFirma-todos-grid"/>
        <view type="form" name="firma-TareaFirma-todos-form"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="reload-grid" value="true"/>
    </action-view>

    <action-view name="firma-TareaFirma-pendiente-action" title="Documentos pendientes de firma" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <view type="grid" name="firma-TareaFirma-pendiente-grid"/>
        <view type="form" name="firma-TareaFirma-pendiente-form"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="reload-grid" value="true"/>
        <domain>self.estadoTareaFirma= :estadoTareaFirma and firmante.id= :firmanteId</domain>
        <context name="estadoTareaFirma" expr="PENDIENTE"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

    <action-view name="firma-TareaFirma-firmado-action" title="Documentos ya firmados" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <view type="grid" name="firma-TareaFirma-firmado-grid"/>
        <view type="form" name="firma-TareaFirma-firmado-form"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="reload-grid" value="true"/>
        <domain>self.estadoTareaFirma= :estadoTareaFirma and firmante.id= :firmanteId</domain>
        <context name="estadoTareaFirma" expr="FIRMADO"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

    <action-view name="firma-TareaFirma-rechazado-action" title="Documentos que se han rechazado firmar" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <view type="grid" name="firma-TareaFirma-rechazado-grid"/>
        <view type="form" name="firma-TareaFirma-rechazado-form"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="reload-grid" value="true"/>
        <domain>self.estadoTareaFirma= :estadoTareaFirma and firmante.id= :firmanteId</domain>
        <context name="estadoTareaFirma" expr="RECHAZADO"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

</object-views>

