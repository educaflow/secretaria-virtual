<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.2.xsd">


    <menuitem name="subsysExpedientes-tiposExpedientes-menuitem" title="Tipos de Expedientes" groups="admins"/>
    <menuitem name="subsysExpedientes.TipoExpediente-menuitem" parent="subsysExpedientes-tiposExpedientes-menuitem" title="Tipos Expedientes" action="subsysExpedientes.TipoExpediente-mantenimiento-action" groups="admins"/>
    <menuitem name="subsysExpedientes.TipoExpediente-prueba-menuitem" parent="subsysExpedientes-tiposExpedientes-menuitem" title="Editar Prueba" action="subsysExpedientes.TipoExpediente-prueba-action" groups="admins"/>


    <action-view name="subsysExpedientes.TipoExpediente-mantenimiento-action" title="tipos de expedientes" model="com.educaflow.subsystem.expedientes.db.TipoExpediente">
        <view type="grid" name="subsysExpedientes.TipoExpediente-grid"/>
        <view type="form" name="subsysExpedientes.TipoExpediente-form"/>
    </action-view>
    <action-view name="subsysExpedientes.TipoExpediente-prueba-action" title="Tipo Expediente" model="com.educaflow.subsystem.expedientes.db.TipoExpediente"  >
        <view type="form" name="subsysExpedientes.TipoExpediente-form" />
        <context name="_showRecord" expr="3" />
    </action-view>


    <grid name="subsysExpedientes.TipoExpediente-grid" title="Listado tipos expediente" model="com.educaflow.subsystem.expedientes.db.TipoExpediente">
        <field name="code"  />
        <field name="name"  />
        <field name="fqcnEventManager" />
    </grid>

    <form name="subsysExpedientes.TipoExpediente-form" title="Mantenimiento de Tipos Expedientes" model="com.educaflow.subsystem.expedientes.db.TipoExpediente" width="large">
        <panel title="Datos" >
            <field name="code"  />
            <field name="name"  />
            <field name="versionExpediente" />
            <field name="openDate" />
            <field name="closeDate" />
            <field name="fqcnEventManager" />
            <field name="tramite"
                   type="many-to-one"
                   target="com.educaflow.subsystem.expedientes.db.Tramite"
            />
        </panel>
    </form>

</object-views>