<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <menuitem name="subsysExpedientes-prueba-dashboard-menuitem" title="Prueba Búsqueda" action="subsysExpedientes-prueba-dashboard-action" groups="admins,users" order="999"/>

    <action-view name="subsysExpedientes-prueba-dashboard-action" title="Prueba de Búsqueda">
        <view type="dashboard" name="subsysExpedientes-prueba-dashboard"/>
    </action-view>

    <dashboard name="subsysExpedientes-prueba-dashboard" title="Expedientes" onInit="subsysExpedientes-prueba-dashboard-oninit-action"  searchModel="com.educaflow.subsystem.expedientes.db.SearchExpedientes">
        <search-fields>
            <field name="estado" widget="boolean-radio" x-true-text="Abierto" x-false-text="Cerrado" />
            <field name="anyo" type="integer" title="Año" />
        </search-fields>

        <dashlet   action="subsysExpedientes-buscar-action"/>
    </dashboard>


    <action-view name="subsysExpedientes-buscar-action" title="Buscando expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="tree" name="subsysExpedientes-buscar-tree"/>
        <context name="_profile" expr="RESPONSABLE"/>
    </action-view>


    <action-record name="subsysExpedientes-prueba-dashboard-oninit-action" model="com.educaflow.subsystem.expedientes.db.SearchExpedientes" >
        <field name="estado" expr="eval: true" />
        <field name="anyo" expr="eval: java.time.Year.now().value" />
    </action-record>

    <tree name="subsysExpedientes-buscar-tree" title="Expedientes">

        <column name="name"  title="Nombre"/>
        <column name="numeroExpediente" width="100px" title="Número Expediente"/>
        <column name="createdBy" width="200px" title="Creado por"/>
        <column name="nameState" width="30%" title="Estado"/>
        <column name="fechaUltimoEstado" type="date" width="100px" title="Fecha"/>


        <node model="com.educaflow.subsystem.expedientes.db.Tramite" domain="EXISTS (SELECT 1 FROM Expediente e WHERE e.abierto=:estado and ((:anyo is null) OR (:anyo=0) OR (YEAR(e.fechaUltimoEstado)=:anyo)) AND e.tipoExpediente.tramite=self)" >
            <field name="name" as="name"/>
        </node>

        <node model="com.educaflow.subsystem.expedientes.db.Expediente" domain="(self.abierto=:estado) and ((:anyo is null) OR (:anyo=0) OR (YEAR(self.fechaUltimoEstado)=:anyo))" parent="tipoExpediente.tramite" draggable="false" onClick="subsysExpedientes-event-view-action">
            <field name="name"/>
            <field name="numeroExpediente"/>
            <field name="createdBy"/>
            <field name="nameState"/>
            <field name="fechaUltimoEstado"/>
        </node>

    </tree>








</object-views>