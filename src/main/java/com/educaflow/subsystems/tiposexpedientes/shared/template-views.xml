<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.0.xsd">

    <form name="exp-Expediente-Templates" title="Expediente" model="com.educaflow.shared.expedientes.db.Expediente">
        <panel name="exp-Expediente-header" colSpan="12">
            <panel colSpan="12">
                <field name="createdBy" title="Creado por" readonly="true" colSpan="3"/>
                <field name="nameState" readonly="true" colSpan="6" title="Estado"/>
                <field name="fechaUltimoEstado" readonly="true" colSpan="2"/>
                <button name="mostrar-historial-estados" icon="assignment" title="" css="btn-link" onClick="expediente-historial-estados-action" colSpan="1"/>
            </panel>
        </panel>

        <panel name="exp-Expediente-footer" colSpan="12" itemSpan="2" showFrame="false">
            <field name="errorMessajesField" showTitle="false" readonly="true" colSpan="12">
                <viewer depends="errorMensajes" ><![CDATA[
                    <>
                    <Box>
                        {errorMensajes.length > 0 ? (
                        <div className="alert alert-danger fade show" role="alert">
                            <ul >
                                {errorMensajes.map((errorMensaje, index) => (
                                <li key={index}>
                                    {errorMensaje.label ? (<strong>{errorMensaje.label}:&nbsp;&nbsp;</strong>) : null}
                                    {errorMensaje.message}
                                </li>
                                ))}
                            </ul>
                        </div>
                        ) : (
                        <span></span>
                        )}
                    </Box>
                    </>
                    ]]></viewer>
            </field>
        </panel>
    </form>


    <action-view name="expediente-historial-estados-action" title="Mostrar historial estados" model="com.educaflow.shared.expedientes.db.HistorialEstado">
        <view type="grid" name="expediente-historial-estados-grid"/>
        <view type="form" name="expediente-historial-estados-form"/>

        <view-param name="popup" value="true"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="popup-save" value="false"/>
        <domain>self.expediente.id=:idExpediente</domain>
        <context name="idExpediente" expr="eval: id"/>
    </action-view>


    <grid name="expediente-historial-estados-grid" title="Historial Estados" model="com.educaflow.shared.expedientes.db.HistorialEstado"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false"
          canSave="false" orderBy="fecha"
    >
        <field name="createdBy"/>
        <field name="nameEvent"/>
        <field name="nameState"/>
        <field name="fecha"/>
        <field name="registroEntrada"/>
        <field name="registroSalida"/>
    </grid>

    <form name="expediente-historial-estados-form" title="Registro" model="com.educaflow.shared.expedientes.db.HistorialEstado">
        <panel-tabs>
            <panel name="registroEntrada" title="Registro de Entrada" colSpan="12" hideIf="registroEntrada==null">
                <field name="registroEntrada.documentoOriginalFirmado" widget="binary-link"  colSpan="12"/>
                <field name="registroEntrada.documentoResguardoPresentacion" widget="binary-link"  colSpan="12"/>
                <panel-related name="registroEntradaAnexos" title="Anexos" field="registroEntrada.anexos" colSpan="12" form-view="registroAnexos-form"  grid-view="registroAnexos-grid"  />
            </panel>
            <panel name="registroSalida" title="Registro de salida" colSpan="12"  hideIf="registroSalida==null">

            </panel>
        </panel-tabs>
    </form>

    <form name="registroAnexos-form" title="Anexo" canAttach="false"  model="com.axelor.meta.db.MetaFile">
        <panel title="">
            <field name="fileName" colSpan="10"/>
            <field name="content" widget="binary" title="Descargar" colSpan="2"/>
        </panel>
    </form>

    <grid name="registroAnexos-grid" title="Anexos" model="com.axelor.meta.db.MetaFile">
        <field name="fileName"/>
    </grid>

</object-views>