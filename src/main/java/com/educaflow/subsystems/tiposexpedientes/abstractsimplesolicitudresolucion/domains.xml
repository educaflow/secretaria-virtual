<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">


    <module name="expedientes" package="com.educaflow.shared.expedientes.db"/>
    <entity name="AbstractSimpleSolicitudResolucion" extends="Expediente" >
        <string name="disconformidad" title="Explicar los datos a subsanar"  />
        <string name="resolucion"  title="Motivo del rechazo" />


        <enum name="tipoResolucion" title="Tipo resolución" ref="AbstractSimpleSolicitudResolucionTipoResolucion" />



    </entity>
    <enum name="AbstractSimpleSolicitudResolucionTipoResolucion">
        <item name="ACEPTAR" title="Resolver positivamente"/>
        <item name="RECHAZAR" title="Resolver negativamente(Rechazar)"/>
        <item name="SUBSANAR_DATOS" title="Solicitar subsanación de datos"/>
    </enum>
</domain-models>
