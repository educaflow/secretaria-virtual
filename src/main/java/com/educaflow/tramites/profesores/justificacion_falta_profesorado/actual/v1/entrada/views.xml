<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************  -->
    <!-- ******************************** PENDIENTE_DOCUMENTO_ESCANEADO ******************************  -->
    <!-- *********************************************************************************************  -->
    <!-- Solo se llega a este estado en papel (InitialEventManagerImpl), y el papel lo presenta siempre el
         TRAMITADOR, así que es él quien adjunta la solicitud escaneada. -->
    <form state="PENDIENTE_DOCUMENTO_ESCANEADO" profile="TRAMITADOR">
        <include-panels>
            -subsanacion
            solicitud-escaneada-upload
        </include-panels>

        <panel name="avisoPendienteDocumentoEscaneadoTramitador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Adjunte escaneada en PDF la solicitud que ha entregado firmada la persona que la presenta. En el paso siguiente copiará sus datos</help>
        </panel>

        <footer>
            <buttons-left>
                <button name="DELETE" colSpan="3" css="btn-danger" outline="true" title="Borrar el expediente"  icon="trash"  onClick="subsysTramitador-event-action" prompt="¿Está seguro que desea borrar el expediente?"/>
            </buttons-left>
            <buttons-right>
                <button name="CONTINUAR" colSpan="3" title="Siguiente" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>
    <form state="PENDIENTE_DOCUMENTO_ESCANEADO">
        <include-panels>
            -datos-profesor
            -datos-falta-view
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud todavía no se ha presentado: está pendiente de que se adjunte escaneada la solicitud entregada en papel</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- *************************************** ENTRADA_DATOS ***************************************  -->
    <!-- *********************************************************************************************  -->
    <form state="ENTRADA_DATOS" profile="CREADOR" >
        <include-panels>
            -subsanacion
            -datos-profesor
            datos-falta
            justificante-upload
        </include-panels>
        <footer>
            <buttons-left>
                <button name="DELETE" colSpan="3" css="btn-danger" outline="true" title="Borrar el expediente"  showIf="!presentadoEnPapel" icon="trash"  onClick="subsysTramitador-event-action" prompt="¿Está seguro que desea borrar el expediente?"/>
                <button name="BACK"   colSpan="3"                  outline="true" title="Atrás"                 showIf="presentadoEnPapel"                onClick="subsysTramitador-event-action" />
            </buttons-left>
            <buttons-right>
                <button name="GUARDAR_DATOS" colSpan="3" title="Siguiente" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- El estado lo comparten las dos formas de presentar, así que tiene un form por perfil: el de arriba para
         quien presenta telemáticamente (CREADOR) y este para quien registra el papel (TRAMITADOR). -->
    <form state="ENTRADA_DATOS" profile="TRAMITADOR"
          onLoad="subsysExpedientes-persona-interesada-onLoad-action">
        <include-panels>
            -subsanacion
            datos-profesor-editable
            datos-falta
            justificante-upload
            -solicitud-escaneada-view
        </include-panels>

        <panel name="avisoEntradaDatosTramitador" colSpan="12" showFrame="false">
            <!-- Con el perfil TRAMITADOR también se llega aquí cuando la solicitud es telemática (por ejemplo, tras
                 pedir una subsanación): entonces el turno es de quien la presentó y no hay nada que hacer. -->
            <help variant="info" colSpan="12" showIf="!presentadoEnPapel">La solicitud está pendiente de que el profesor complete o corrija los datos y la presente</help>
            <help variant="info" colSpan="12" showIf="presentadoEnPapel">Copie los datos de la solicitud entregada en papel que ha adjuntado escaneada. Al presentarla se registrará su entrada</help>
        </panel>

        <footer>
            <buttons-left>
                <button name="DELETE" showIf="presentadoEnPapel" colSpan="3" css="btn-danger" outline="true" title="Borrar el expediente"  icon="trash"  onClick="subsysTramitador-event-action" prompt="¿Está seguro que desea borrar el expediente?"/>
                <button name="BACK" showIf="presentadoEnPapel" colSpan="3" outline="true" title="Atrás" onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="GUARDAR_DATOS" showIf="presentadoEnPapel" colSpan="3" title="Presentar la solicitud" onClick="subsysTramitador-event-action"
                        prompt="Va a presentar la solicitud entregada en papel. Una vez presentada no podrá modificarla"/>
            </buttons-right>
        </footer>
    </form>
    <form state="ENTRADA_DATOS">
        <include-panels>
            -subsanacion
            -datos-profesor
            -datos-falta-view
            -justificante-view
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud está pendiente de que el profesor complete y guarde los datos de la falta</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- **********************************************************************************************  -->
    <!-- *********************************** PENDIENTE_PRESENTACION ***********************************  -->
    <!-- **********************************************************************************************  -->
    <form state="PENDIENTE_PRESENTACION" profile="CREADOR" onLoad="exp-JustificacionFaltaProfesoradoV1-PENDIENTE_PRESENTACION-onLoad-action">
        <include-panels>
            -pdfSolicitud
            firma-solicitud
        </include-panels>

        <footer>
            <buttons-left>
                <button name="BACK" colSpan="3" outline="true" title="Atrás" onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="PRESENTAR" colSpan="3" title="Firmar con AutoFirma__!! y Presentar la solicitud"
                        showIf="situacionFirma=='SIN_CERTIFICADO'"
                        onClick="serial:exp-JustificacionFaltaProfesoradoV1-firmarDocumentacionParaPresentar-action,subsysTramitador-event-action"
                        prompt="¿Esta seguro que desea presentar la documentación?&lt;br&gt;No podrá deshacer esta acción"/>
                <button name="PRESENTAR" colSpan="3" title="Firmar y Presentar la solicitud"
                        showIf="firmaEnServidor"
                        onClick="serial:subsysTramitador-event-action,exp-JustificacionFaltaProfesoradoV1-set-claveCertificado-null-action"
                        prompt="¿Esta seguro que desea presentar la documentación?&lt;br&gt;No podrá deshacer esta acción"/>
            </buttons-right>
        </footer>
    </form>
    <form state="PENDIENTE_PRESENTACION">
        <include-panels>
            -pdfSolicitud
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud está pendiente de que el profesor la firme y la presente</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <action-group name="exp-JustificacionFaltaProfesoradoV1-PENDIENTE_PRESENTACION-onLoad-action">
        <action name="exp-JustificacionFaltaProfesoradoV1-set-situacionFirma-action"/>
    </action-group>

    <action-record name="exp-JustificacionFaltaProfesoradoV1-set-situacionFirma-action"
                   model="com.educaflow.subsystem.expedientes.db.JustificacionFaltaProfesoradoV1">
        <field name="situacionFirma"
               expr="call:com.educaflow.subsystem.criptografia.controller.CertificadoDigitalController:getSituacionFirma()"/>
        <field name="firmaEnServidor"
               expr="call:com.educaflow.subsystem.criptografia.controller.CertificadoDigitalController:isFirmaEnServidor()"/>
    </action-record>

    <!-- firmaSolicitante: el campoFirma de documentospdf/solicitud.xml, el mismo que CAMPO_FIRMA_SOLICITUD
         del PhaseEventManagerImpl de esta fase. MUST NOT cambiarse aquí sin cambiarlo allí. -->
    <action-method name="exp-JustificacionFaltaProfesoradoV1-firmarDocumentacionParaPresentar-action"  >
        <call
                class="com.educaflow.tramites.util.firma.FirmaClienteController"
                method='firmarDocumentoEnCampo(id,"pdfSolicitud","pdfSolicitudFirmada","firmaSolicitante")'
        />
    </action-method>

    <action-record name="exp-JustificacionFaltaProfesoradoV1-set-claveCertificado-null-action"
                   model="com.educaflow.subsystem.expedientes.db.JustificacionFaltaProfesoradoV1">
        <field name="claveCertificado" expr="eval: null"/>
    </action-record>

    <action-record name="exp-JustificacionFaltaProfesoradoV1-onChange-tipoJornadaFalta-action"
                   model="com.educaflow.subsystem.expedientes.db.JustificacionFaltaProfesoradoV1">
        <field name="fechaFin"   expr="eval: null" if="tipoJornadaFalta != 'VARIOS_DIAS_COMPLETOS' &amp;&amp; tipoJornadaFalta != 'VARIOS_DIAS_PRIMERO_PARCIAL'"/>
        <field name="horaInicio" expr="eval: null" if="tipoJornadaFalta != 'UNAS_HORAS_UN_DIA' &amp;&amp; tipoJornadaFalta != 'VARIOS_DIAS_PRIMERO_PARCIAL'"/>
        <field name="horaFin"    expr="eval: null" if="tipoJornadaFalta != 'UNAS_HORAS_UN_DIA'"/>
    </action-record>

</object-views>
