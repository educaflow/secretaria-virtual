<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- **********************************************************************************************  -->
    <!-- ************************************ PENDIENTE_RESOLUCION ************************************  -->
    <!-- **********************************************************************************************  -->
    <form state="PENDIENTE_RESOLUCION" profile="DIRECTOR" >
        <include-panels>
            -datos-profesor
            -datos-falta-view
            -justificante-view
            -pdfSolicitudFirmada
            resolucion
        </include-panels>
        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="RESOLVER" colSpan="3" colOffset="9" title="Resolver el expediente" onClick="subsysTramitador-event-action" prompt="¿Esta seguro que desea resolver el expediente?&lt;br&gt;No podrá deshacer esta acción"/>
            </buttons-right>
        </footer>
    </form>

    <form state="PENDIENTE_RESOLUCION">
        <include-panels>
            -datos-profesor
            -datos-falta-view
            -pdfJustificanteRegistroEntrada
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud está pendiente de que la dirección del centro la resuelva</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>


    <!-- **********************************************************************  -->
    <!-- ****************************** ACEPTADO ******************************  -->
    <!-- **********************************************************************  -->
    <form state="ACEPTADO">
        <include-panels>
            -datos-profesor
            -datos-falta-view
            -pdfResolucion
            -resolucion-view
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">El expediente está cerrado: la falta ha sido justificada</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>


    <!-- **********************************************************************  -->
    <!-- ****************************** RECHAZADO ******************************  -->
    <!-- **********************************************************************  -->
    <form state="RECHAZADO">
        <include-panels>
            -datos-profesor
            -datos-falta-view
            -pdfResolucion
            -resolucion-view
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">El expediente está cerrado: la falta no ha sido justificada</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="3" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>
</object-views>
