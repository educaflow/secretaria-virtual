<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <form name="exp-PruebaV1-Templates" width="large" title="Prueba" model="com.educaflow.subsystem.expedientes.db.PruebaV1" groups="admins,users" >
        <panel name="datos-solicitante" title="Datos Solicitante">
            <field name="solicita" colSpan="9"/>
            <field name="justificante"  widget="binary-link" colSpan="3" x-accept=".pdf"/>
            <field name="ciclo" colSpan="6" grid-view="subsysSistemaEducativo.Ciclo-search-grid" form-view="subsysSistemaEducativo.Ciclo-view-form" />
        </panel>
        <panel-related name="fcts-panel" title="FCT's__!!" field="formacionesCentrosTrabajo" colSpan="12" form-view="exp-PruebaV1-FormacionCentroTrabajo-form" grid-view="exp-PruebaV1-FormacionCentroTrabajo-grid"/>
        <panel name="datos-resolucion" title="Datos Resolución">
            <field name="motivo" colSpan="12"/>
        </panel>
        <panel name="datos-fct" colSpan="12">
            <field name="alumno" colSpan="6"   />
            <field name="a2"  widget="binary-link" colSpan="6" colOffset="6"/>
            <field name="a3"  widget="binary-link" colSpan="6"/>
        </panel>
        <panel name="nombre-alumno" colSpan="12">
            <field name="alumno" title="Nombre" colSpan="6" />
        </panel>

        <panel-tabs name="firma-fct">
            <panel title="Anexo A2" itemSpan="12">
                <button name="FIRMAR-A2" title="Firmar A2" onClick="" colSpan="12" />
                <field name="alumno" showTitle="false" readonly="true">
                    <viewer depends="a2" ><![CDATA[
                        <>
                        <Box as="iframe" height="400" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${a2.id}/content/download?inline=true&name=${a2.fileName}`} ></Box>
                        </>
                        ]]></viewer>
                </field>
            </panel>
            <panel title="Anexo A3" itemSpan="12">
                <button name="FIRMAR-A3" title="Firmar A3" onClick="" colSpan="12" />
                <field name="alumno" showTitle="false" readonly="true"  colSpan="12">
                    <viewer depends="a3"><![CDATA[
                        <>
                        <Box as="iframe" height="400" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${a3.id}/content/download?inline=true&name=${a3.fileName}`} ></Box>
                        </>
                        ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>




    <grid name="exp-PruebaV1-FormacionCentroTrabajo-grid" title="FCT's__!!" model="com.educaflow.subsystem.expedientes.db.FormacionCentroTrabajo" groups="admins,users" canEdit="false" edit-icon="false" canSave="true">
        <field name="alumno" />
    </grid>
    <form name="exp-PruebaV1-FormacionCentroTrabajo-form" title="Detalle FCT" model="com.educaflow.subsystem.expedientes.db.FormacionCentroTrabajo" groups="admins,users" onValidate="subsysExpedientes-validate-on-save-child-action" validateSignal="misenyal" canSave="true" >
        <include-panels header="false">
            datos-fct
        </include-panels>
        <footer />
    </form>
    <form name="exp-PruebaV1-FormacionCentroTrabajo-firma-form" title="Detalle FCT" model="com.educaflow.subsystem.expedientes.db.FormacionCentroTrabajo" groups="admins,users" canSave="true">
        <include-panels header="false">
            nombre-alumno
            firma-fct
        </include-panels>
        <footer />
    </form>




</object-views>
