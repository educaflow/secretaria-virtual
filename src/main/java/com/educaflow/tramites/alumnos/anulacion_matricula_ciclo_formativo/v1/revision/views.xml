<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************  -->
    <!-- ************************************* PENDIENTE_REVISION ************************************  -->
    <!-- *********************************************************************************************  -->
    <form state="PENDIENTE_REVISION" profile="TRAMITADOR">
        <include-panels>
            -devolucion-view
            -persona-solicitante
            -datos-alumno
            -matricula
            -presentacion-descarga
            -solicitud-firmada-visor
            revision
        </include-panels>

        <panel name="avisoPendienteRevisionSecretario" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Compruebe los datos de la solicitud y elija el sentido de la revisión: si hay algún error, pida al alumno que lo subsane; si no, acepte o rechace la anulación y la resolución irá a la firma del director</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="CONTINUAR" colSpan="2" title="Siguiente"
                        onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <form state="PENDIENTE_REVISION">
        <include-panels>
            -datos-alumno
            -matricula
            -presentacion
            -solicitud-firmada-descarga
        </include-panels>

        <panel name="avisoPendienteRevisionGenerica" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud está pendiente de revisión por la secretaría del centro</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones propias de la fase REVISION **************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="exp-AnulacionMatriculaCicloFormativoV1-limpiar-revision-action"
                   model="com.educaflow.subsystem.expedientes.db.AnulacionMatriculaCicloFormativoV1">
        <field name="motivoRechazo"    expr="eval: null" if="sentidoRevision != 'RECHAZAR'"/>
        <field name="textoSubsanacion" expr="eval: null" if="sentidoRevision != 'SUBSANAR'"/>
    </action-record>

</object-views>
