<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************  -->
    <!-- ************************************ PENDIENTE_RESOLUCION ***********************************  -->
    <!-- *********************************************************************************************  -->
    <form state="PENDIENTE_RESOLUCION" profile="TRAMITADOR">
        <include-panels>
            -persona-solicitante
            -datos-alumno
            -matricula
            -presentacion-descarga
            -pdfSolicitudFirmada
            resolucion
        </include-panels>

        <panel name="avisoPendienteResolucionTramitador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Acepte o rechace la anulación. Se generará la resolución y se le pondrá a firmar al secretario y después al director del centro en su bandeja de firmas</help>
        </panel>

        <footer>
            <buttons-left>
                <button name="BACK" colSpan="2" outline="true" title="Atrás"
                        onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="RESOLVER" colSpan="4" title="Enviar a la firma"
                        onClick="subsysTramitador-event-action"
                        prompt="Va a generar la resolución y a enviarla a la firma del secretario y del director del centro"/>
            </buttons-right>
        </footer>
    </form>

    <form state="PENDIENTE_RESOLUCION">
        <include-panels>
            -datos-alumno
            -matricula
            -presentacion
            -solicitud-firmada-descarga
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud está pendiente de que la secretaría del centro la resuelva</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones propias de la fase RESOLUCION ************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="exp-AnulacionMatriculaCicloFormativoV1-limpiar-resolucion-action"
                   model="com.educaflow.subsystem.expedientes.db.AnulacionMatriculaCicloFormativoV1">
        <field name="motivoRechazo" expr="eval: null" if="tipoResolucion != 'RECHAZAR'"/>
    </action-record>

</object-views>
