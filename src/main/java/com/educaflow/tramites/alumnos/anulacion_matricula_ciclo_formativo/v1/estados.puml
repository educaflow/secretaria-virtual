@startuml

state ENTRADA {
    state "PENDIENTE_DOCUMENTO_ESCANEADO" as ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO
    state "ENTRADA_DATOS" as ENTRADA_ENTRADA_DATOS
    state "PENDIENTE_PRESENTACION" as ENTRADA_PENDIENTE_PRESENTACION
}

state VERIFICACION {
    state "PENDIENTE_VERIFICACION" as VERIFICACION_PENDIENTE_VERIFICACION
}

state RESOLUCION {
    state "PENDIENTE_RESOLUCION" as RESOLUCION_PENDIENTE_RESOLUCION
}

state FIRMA {
    state "PENDIENTE_FIRMA_SECRETARIO" as FIRMA_PENDIENTE_FIRMA_SECRETARIO
    state "PENDIENTE_FIRMA_DIRECTOR" as FIRMA_PENDIENTE_FIRMA_DIRECTOR
}

state CIERRE {
    state "ACEPTADA" as CIERRE_ACEPTADA
    state "RECHAZADA" as CIERRE_RECHAZADA
}

[*] --> ENTRADA_ENTRADA_DATOS : [presentadoEnPapel=false]
[*] --> ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO : [presentadoEnPapel=true]

ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO -> [*] : DELETE
ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO --> ENTRADA_ENTRADA_DATOS : CONTINUAR

ENTRADA_ENTRADA_DATOS -> [*] : DELETE
ENTRADA_ENTRADA_DATOS --> ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO : BACK[presentadoEnPapel=true]
ENTRADA_ENTRADA_DATOS --> ENTRADA_PENDIENTE_PRESENTACION : GUARDAR_DATOS[presentadoEnPapel=false]
ENTRADA_ENTRADA_DATOS --> VERIFICACION_PENDIENTE_VERIFICACION : GUARDAR_DATOS[presentadoEnPapel=true]

ENTRADA_PENDIENTE_PRESENTACION --> ENTRADA_ENTRADA_DATOS : BACK
ENTRADA_PENDIENTE_PRESENTACION --> VERIFICACION_PENDIENTE_VERIFICACION : PRESENTAR

VERIFICACION_PENDIENTE_VERIFICACION --> RESOLUCION_PENDIENTE_RESOLUCION : VERIFICAR[resultadoVerificacion=CORRECTO]
VERIFICACION_PENDIENTE_VERIFICACION --> ENTRADA_ENTRADA_DATOS : VERIFICAR[resultadoVerificacion=SUBSANAR, presentadoEnPapel=false]
VERIFICACION_PENDIENTE_VERIFICACION --> ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO : VERIFICAR[resultadoVerificacion=SUBSANAR, presentadoEnPapel=true]

RESOLUCION_PENDIENTE_RESOLUCION --> VERIFICACION_PENDIENTE_VERIFICACION : BACK
RESOLUCION_PENDIENTE_RESOLUCION --> FIRMA_PENDIENTE_FIRMA_SECRETARIO : RESOLVER

FIRMA_PENDIENTE_FIRMA_SECRETARIO --> FIRMA_PENDIENTE_FIRMA_DIRECTOR : FIRMAR
FIRMA_PENDIENTE_FIRMA_SECRETARIO --> RESOLUCION_PENDIENTE_RESOLUCION : RECHAZAR_FIRMA

FIRMA_PENDIENTE_FIRMA_DIRECTOR --> CIERRE_ACEPTADA : FIRMAR[tipoResolucion=ACEPTAR]
FIRMA_PENDIENTE_FIRMA_DIRECTOR --> CIERRE_RECHAZADA : FIRMAR[tipoResolucion=RECHAZAR]
FIRMA_PENDIENTE_FIRMA_DIRECTOR --> RESOLUCION_PENDIENTE_RESOLUCION : RECHAZAR_FIRMA

CIERRE_ACEPTADA : closed
CIERRE_RECHAZADA : closed

note right of ENTRADA_PENDIENTE_DOCUMENTO_ESCANEADO
  El estado inicial lo decide el
  InitialEventManagerImpl según presentadoEnPapel.
end note

note right of ENTRADA_ENTRADA_DATOS
  GUARDAR_DATOS en papel: registro de entrada con el
  escaneado (pdfSolicitudFirmada) y a verificación.
end note

note right of FIRMA_PENDIENTE_FIRMA_SECRETARIO
  FIRMAR y RECHAZAR_FIRMA son eventos de sistema:
  los dispara el servidor cuando el secretario y,
  después, el director firman o rechazan la
  resolución en su bandeja de firmas.
end note

@enduml
