@startuml

state SOLICITUD {
    state "PENDIENTE_DOCUMENTO_ESCANEADO" as SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO
    state "DATOS_SOLICITUD" as SOLICITUD_DATOS_SOLICITUD
    state "PENDIENTE_FIRMA" as SOLICITUD_PENDIENTE_FIRMA
}

state REVISION {
    state "PENDIENTE_REVISION" as REVISION_PENDIENTE_REVISION
}

state RESOLUCION {
    state "PENDIENTE_FIRMA_DIRECTOR" as RESOLUCION_PENDIENTE_FIRMA_DIRECTOR
    state "ACEPTADA" as RESOLUCION_ACEPTADA
    state "RECHAZADA" as RESOLUCION_RECHAZADA
}

[*] --> SOLICITUD_DATOS_SOLICITUD : [presentadoEnPapel=false]
[*] --> SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO : [presentadoEnPapel=true]

SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO -> [*] : DELETE
SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO --> SOLICITUD_DATOS_SOLICITUD : CONTINUAR

SOLICITUD_DATOS_SOLICITUD -> [*] : DELETE
SOLICITUD_DATOS_SOLICITUD --> SOLICITUD_PENDIENTE_FIRMA : CONTINUAR[presentadoEnPapel=false]
SOLICITUD_DATOS_SOLICITUD --> REVISION_PENDIENTE_REVISION : CONTINUAR[presentadoEnPapel=true]
SOLICITUD_DATOS_SOLICITUD --> SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO : VOLVER[presentadoEnPapel=true]

SOLICITUD_PENDIENTE_FIRMA --> SOLICITUD_DATOS_SOLICITUD : VOLVER
SOLICITUD_PENDIENTE_FIRMA --> REVISION_PENDIENTE_REVISION : PRESENTAR

REVISION_PENDIENTE_REVISION --> RESOLUCION_PENDIENTE_FIRMA_DIRECTOR : CONTINUAR[sentidoRevision=ACEPTAR]
REVISION_PENDIENTE_REVISION --> RESOLUCION_PENDIENTE_FIRMA_DIRECTOR : CONTINUAR[sentidoRevision=RECHAZAR]
REVISION_PENDIENTE_REVISION --> SOLICITUD_DATOS_SOLICITUD : CONTINUAR[sentidoRevision=SUBSANAR, presentadoEnPapel=false]
REVISION_PENDIENTE_REVISION --> SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO : CONTINUAR[sentidoRevision=SUBSANAR, presentadoEnPapel=true]

RESOLUCION_PENDIENTE_FIRMA_DIRECTOR --> RESOLUCION_ACEPTADA : FIRMAR[sentidoRevision=ACEPTAR]
RESOLUCION_PENDIENTE_FIRMA_DIRECTOR --> RESOLUCION_RECHAZADA : FIRMAR[sentidoRevision=RECHAZAR]
RESOLUCION_PENDIENTE_FIRMA_DIRECTOR --> REVISION_PENDIENTE_REVISION : DEVOLVER

RESOLUCION_ACEPTADA : closed
RESOLUCION_RECHAZADA : closed

note right of SOLICITUD_PENDIENTE_DOCUMENTO_ESCANEADO
  El estado inicial lo decide el
  InitialEventManagerImpl según presentadoEnPapel.
end note

note right of SOLICITUD_DATOS_SOLICITUD
  CONTINUAR en papel: registro de entrada con el
  escaneado (pdfSolicitudFirmada) y a revisión.
end note

@enduml
