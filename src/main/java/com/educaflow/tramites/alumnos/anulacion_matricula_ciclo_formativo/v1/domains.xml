<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">


    <module name="expedientes" package="com.educaflow.subsystem.expedientes.db"/>

    <entity name="AnulacionMatriculaCicloFormativoV1" extends="Expediente">

        <many-to-one name="ciclo" title="Ciclo formativo"
                     ref="com.educaflow.subsystem.sistemaeducativo.db.Ciclo" />

        <!-- Datos del centro y del curso -->
        <string name="cursoAcademico" title="Curso académico" />
        <string name="nombreCentro" title="Centro" />
        <string name="localidadCentro" title="Localidad del centro" />

        <date name="fechaSolicitud" title="Fecha de la solicitud" />

        <!-- Presentación -->
        <datetime name="fechaHoraPresentacion" title="Fecha y hora de presentación" />

        <!-- Verificación de la secretaría -->
        <enum name="resultadoVerificacion" title="Resultado de la verificación"
              ref="ResultadoVerificacionAnulacionMatriculaCicloFormativoV1" />
        <string name="textoSubsanacion" title="Qué hay que subsanar" large="true" />
        <date name="fechaVerificacion" title="Fecha de la verificación" />
        <many-to-one name="verificadoPor" title="Verificado por" ref="com.axelor.auth.db.User" />

        <!-- Resolución que propone la secretaría -->
        <enum name="tipoResolucion" title="Tipo resolución"
              ref="TipoResolucionAnulacionMatriculaCicloFormativoV1" />
        <string name="motivoRechazo" title="Motivo del rechazo" large="true" />

        <!-- Resolución -->
        <date name="fechaResolucion" title="Fecha de la resolución" />

        <!-- Documentos -->
        <many-to-one name="pdfSolicitud" title="Solicitud de anulación"
                     ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfSolicitudFirmada" title="Solicitud de anulación firmada"
                     ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfJustificanteRegistroEntrada" title="Justificante de presentación"
                     ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfResolucion" title="Resolución sin firmar"
                     ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfResolucionFirmada" title="Resolución"
                     ref="com.axelor.meta.db.MetaFile" />

        <!-- Lo reescribe entero el build (RichDomainXmlTask): MUST NOT escribirse aquí nada propio. -->
        <extra-code-model>
        <![CDATA[

            public enum TipoDocumentoPdf {
                SOLICITUD("/com/educaflow/tramites/alumnos/anulacion_matricula_ciclo_formativo/v1/documentospdf/solicitud.xml"),
                RESOLUCION("/com/educaflow/tramites/alumnos/anulacion_matricula_ciclo_formativo/v1/documentospdf/resolucion.xml");

                private final String fileName;

                // Constructor privado del enum
                TipoDocumentoPdf(String fileName) {
                    this.fileName = fileName;
                }

                // Getter
                public String getFileName() {
                    return fileName;
                }
            }


            public com.educaflow.base.infrastructure.pdf.DocumentoPdf getDocumentoPdf(TipoDocumentoPdf tipoDocumentoPdf) {
                return com.educaflow.subsystem.expedientes.util.ExpedienteDocumentoPdfUtil.getDocumentoPdf(this, tipoDocumentoPdf.getFileName());
            }

        ]]>
        </extra-code-model>
    </entity>

    <enum name="ResultadoVerificacionAnulacionMatriculaCicloFormativoV1">
        <item name="CORRECTO" title="La solicitud es correcta"/>
        <item name="SUBSANAR" title="Pedir subsanación"/>
    </enum>

    <enum name="TipoResolucionAnulacionMatriculaCicloFormativoV1">
        <item name="ACEPTAR"  title="Aceptar la anulación"/>
        <item name="RECHAZAR" title="Rechazar la anulación"/>
    </enum>

</domain-models>
