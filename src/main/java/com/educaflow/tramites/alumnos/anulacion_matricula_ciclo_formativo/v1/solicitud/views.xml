<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************  -->
    <!-- ************************************** DATOS_SOLICITUD **************************************  -->
    <!-- *********************************************************************************************  -->
    <form state="DATOS_SOLICITUD" profile="CREADOR"
          onLoad="exp-AnulacionMatriculaCicloFormativoV1-DATOS_SOLICITUD-onLoad-action">
        <include-panels>
            -subsanacion
            persona-solicitante-editable
            datos-alumno
            matricula
        </include-panels>

        <panel name="avisoDatosSolicitudCreador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12" showIf="!presentadoEnPapel">Para presentar la solicitud necesitará firmarla con su certificado digital desde este mismo ordenador</help>
            <help variant="info" colSpan="12" showIf="presentadoEnPapel">Copie los datos de la solicitud entregada en papel que ha adjuntado escaneada. Al presentarla se registrará su entrada</help>
            <field name="presentadoEnPapel" hidden="true"/>
        </panel>

        <panel name="solicitudEscaneadaDatosSolicitud" title="Solicitud entregada en papel" colSpan="12" showIf="presentadoEnPapel">
            <field name="pdfSolicitudFirmada" title="Solicitud escaneada (PDF)" widget="binary-link" readonly="true" colSpan="8"/>
        </panel>

        <footer>
            <buttons-left>
                <button name="DELETE" colSpan="3" css="btn-danger" outline="true" icon="trash"
                        title="Borrar el expediente"
                        onClick="subsysTramitador-event-action"
                        prompt="Se va a eliminar el expediente y no podrá recuperarlo"/>
                <button name="VOLVER" colSpan="2" outline="true" title="Atrás"
                        showIf="presentadoEnPapel"
                        onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="CONTINUAR" colSpan="2" title="Siguiente"
                        showIf="!presentadoEnPapel"
                        onClick="subsysTramitador-event-action"/>
                <button name="CONTINUAR" colSpan="4" title="Presentar la solicitud"
                        showIf="presentadoEnPapel"
                        onClick="subsysTramitador-event-action"
                        prompt="Va a presentar la solicitud de anulación entregada en papel. Una vez presentada no podrá modificarla"/>
            </buttons-right>
        </footer>
    </form>

    <!-- El estado lo comparten las dos formas de presentar, así que tiene un form por perfil: el de arriba para
         quien presenta telemáticamente (CREADOR) y este para quien registra el papel (TRAMITADOR). Aquí
         presentadoEnPapel es siempre true, por eso no se bifurca nada con showIf. -->
    <form state="DATOS_SOLICITUD" profile="TRAMITADOR"
          onLoad="exp-AnulacionMatriculaCicloFormativoV1-DATOS_SOLICITUD-onLoad-action">
        <include-panels>
            -subsanacion
            persona-solicitante-editable
            datos-alumno
            matricula
        </include-panels>

        <panel name="avisoDatosSolicitudTramitador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Copie los datos de la solicitud entregada en papel que ha adjuntado escaneada. Al presentarla se registrará su entrada</help>
        </panel>

        <panel name="solicitudEscaneadaDatosSolicitudTramitador" title="Solicitud entregada en papel" colSpan="12">
            <field name="pdfSolicitudFirmada" title="Solicitud escaneada (PDF)" widget="binary-link" readonly="true" colSpan="8"/>
        </panel>

        <footer>
            <buttons-left>
                <button name="DELETE" colSpan="3" css="btn-danger" outline="true" icon="trash"
                        title="Borrar el expediente"
                        onClick="subsysTramitador-event-action"
                        prompt="Se va a eliminar el expediente y no podrá recuperarlo"/>
                <button name="VOLVER" colSpan="2" outline="true" title="Atrás"
                        onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="CONTINUAR" colSpan="4" title="Presentar la solicitud"
                        onClick="subsysTramitador-event-action"
                        prompt="Va a presentar la solicitud de anulación entregada en papel. Una vez presentada no podrá modificarla"/>
            </buttons-right>
        </footer>
    </form>

    <form state="DATOS_SOLICITUD">
        <include-panels>
            -subsanacion
            -persona-solicitante
            -datos-alumno
            -matricula
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud todavía no se ha presentado: está pendiente de que el alumno complete o corrija los datos</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ************************************** PENDIENTE_FIRMA **************************************  -->
    <!-- *********************************************************************************************  -->
    <form state="PENDIENTE_FIRMA" profile="CREADOR"
          onLoad="exp-AnulacionMatriculaCicloFormativoV1-PENDIENTE_FIRMA-onLoad-action">
        <include-panels>
            -subsanacion
            -solicitud-visor
        </include-panels>

        <panel name="avisoPendienteFirmaCreador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Revise la solicitud antes de firmarla. Necesitará su certificado digital instalado en este ordenador y la aplicación de firma del ciudadano</help>
        </panel>

        <panel name="firmaSolicitudSituacion" title="" colSpan="12" showFrame="false" readonly="true">
            <field name="situacionFirma" type="string" showIf="false" readonly="true"/>
            <field name="firmaEnServidor" type="boolean" showIf="false" readonly="true"/>
        </panel>

        <panel name="firmaSolicitudSinCertificado" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='SIN_CERTIFICADO'">
            <help variant="info" colSpan="12"><![CDATA[Para presentar la solicitud debe tener la aplicación de <a href="https://sede.serviciosmin.gob.es/es-es/firmaelectronica/paginas/autofirma.aspx" target="_blank">AutoFirma</a> instalada y un certificado digital válido]]></help>
        </panel>

        <panel name="firmaSolicitudDispositivoConPin" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='DISPOSITIVO_CON_PIN'">
            <help variant="info" colSpan="12"><![CDATA[La solicitud se firmará en el servidor con su certificado digital.]]></help>
        </panel>

        <panel name="firmaSolicitudDispositivoSinPin" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='DISPOSITIVO_SIN_PIN'">
            <help variant="info" colSpan="12"><![CDATA[La solicitud se firmará en el servidor con su certificado digital. Introduzca el PIN de su dispositivo criptográfico.]]></help>
            <field name="claveCertificado" title="PIN" widget="password" required="true" colSpan="4"/>
        </panel>

        <panel name="firmaSolicitudFicheroConClave" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='FICHERO_CON_CLAVE'">
            <help variant="info" colSpan="12"><![CDATA[La solicitud se firmará en el servidor con su certificado digital.]]></help>
        </panel>

        <panel name="firmaSolicitudFicheroSinClave" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='FICHERO_SIN_CLAVE'">
            <help variant="info" colSpan="12"><![CDATA[La solicitud se firmará en el servidor con su certificado digital. Introduzca la contraseña de su certificado.]]></help>
            <field name="claveCertificado" title="Contraseña" widget="password" required="true" colSpan="4"/>
        </panel>

        <panel name="firmaSolicitudSinDni" title="Firma de la solicitud" colSpan="12"
               showIf="situacionFirma=='SIN_DNI'">
            <help variant="warning" colSpan="12"><![CDATA[No es posible firmar la solicitud porque su usuario no tiene un documento de identidad. Póngase en contacto con el administrador.]]></help>
        </panel>

        <footer>
            <buttons-left>
                <button name="VOLVER" colSpan="2" outline="true" title="Atrás"
                        onClick="subsysTramitador-event-action"/>
            </buttons-left>
            <buttons-right>
                <button name="PRESENTAR" colSpan="4" title="Firmar y presentar la solicitud"
                        showIf="situacionFirma=='SIN_CERTIFICADO'"
                        onClick="serial:exp-AnulacionMatriculaCicloFormativoV1-firmarSolicitud-action,subsysTramitador-event-action"
                        prompt="Va a firmar y presentar la solicitud de anulación. Una vez presentada no podrá modificarla"/>
                <button name="PRESENTAR" colSpan="4" title="Firmar y presentar la solicitud"
                        showIf="firmaEnServidor"
                        onClick="serial:subsysTramitador-event-action,exp-AnulacionMatriculaCicloFormativoV1-set-claveCertificado-null-action"
                        prompt="Va a firmar y presentar la solicitud de anulación. Una vez presentada no podrá modificarla"/>
            </buttons-right>
        </footer>
    </form>

    <form state="PENDIENTE_FIRMA">
        <include-panels>
            -datos-alumno
            -matricula
            -solicitud-descarga
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud todavía no se ha presentado: está pendiente de que el alumno la firme</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ******************************** PENDIENTE_DOCUMENTO_ESCANEADO ******************************  -->
    <!-- *********************************************************************************************  -->
    <!-- Solo se llega a este estado en papel (InitialEventManagerImpl), y el papel lo presenta siempre el
         TRAMITADOR, así que es él quien adjunta la solicitud escaneada. -->
    <form state="PENDIENTE_DOCUMENTO_ESCANEADO" profile="TRAMITADOR">
        <include-panels>
            -subsanacion
            solicitud-escaneada-upload
        </include-panels>

        <panel name="avisoPendienteDocumentoEscaneadoTramitador" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">Adjunte escaneada en PDF la solicitud que ha entregado firmada la persona que la presenta. En el paso siguiente copiará sus datos</help>
        </panel>

        <footer>
            <buttons-left>
                <button name="DELETE" colSpan="3" css="btn-danger" outline="true" icon="trash"
                        title="Borrar el expediente"
                        onClick="subsysTramitador-event-action"
                        prompt="Se va a eliminar el expediente y no podrá recuperarlo"/>
            </buttons-left>
            <buttons-right>
                <button name="CONTINUAR" colSpan="2" title="Siguiente"
                        onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <form state="PENDIENTE_DOCUMENTO_ESCANEADO">
        <include-panels>
            -datos-alumno
            -matricula
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La solicitud todavía no se ha presentado: está pendiente de que se adjunte escaneada la solicitud entregada en papel</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones propias de la fase SOLICITUD *************************  -->
    <!-- *********************************************************************************************  -->
    <action-group name="exp-AnulacionMatriculaCicloFormativoV1-DATOS_SOLICITUD-onLoad-action">
        <action name="subsysExpedientes-persona-solicitante-onLoad-action"/>
        <action name="subsysExpedientes-persona-interesada-onLoad-action"/>
        <action name="exp-AnulacionMatriculaCicloFormativoV1-DATOS_SOLICITUD-required-action"/>
    </action-group>

    <action-attrs name="exp-AnulacionMatriculaCicloFormativoV1-DATOS_SOLICITUD-required-action">
        <attribute for="ciclo"         name="required" expr="true"/>
    </action-attrs>

    <action-group name="exp-AnulacionMatriculaCicloFormativoV1-PENDIENTE_FIRMA-onLoad-action">
        <action name="exp-AnulacionMatriculaCicloFormativoV1-set-situacionFirma-action"/>
    </action-group>

    <action-record name="exp-AnulacionMatriculaCicloFormativoV1-set-situacionFirma-action"
                   model="com.educaflow.subsystem.expedientes.db.AnulacionMatriculaCicloFormativoV1">
        <field name="situacionFirma"
               expr="call:com.educaflow.tramites.util.firma.FirmaServidorController:getSituacionFirma()"/>
        <field name="firmaEnServidor"
               expr="call:com.educaflow.tramites.util.firma.FirmaServidorController:isFirmaEnServidor()"/>
    </action-record>

    <!-- firmaSolicitante: el campoFirma de documentospdf/solicitud.xml, el mismo que CAMPO_FIRMA_SOLICITUD
         del PhaseEventManagerImpl de esta fase. MUST NOT cambiarse aquí sin cambiarlo allí. -->
    <action-method name="exp-AnulacionMatriculaCicloFormativoV1-firmarSolicitud-action">
        <call class="com.educaflow.tramites.util.firma.FirmaClienteController"
              method='firmarDocumentoEnCampo(id,"pdfSolicitud","pdfSolicitudFirmada","firmaSolicitante")'/>
    </action-method>

    <action-record name="exp-AnulacionMatriculaCicloFormativoV1-set-claveCertificado-null-action"
                   model="com.educaflow.subsystem.expedientes.db.AnulacionMatriculaCicloFormativoV1">
        <field name="claveCertificado" expr="eval: null"/>
    </action-record>

</object-views>
