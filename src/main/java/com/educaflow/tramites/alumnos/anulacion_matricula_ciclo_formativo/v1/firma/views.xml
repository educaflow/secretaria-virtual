<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://axelor.com/xml/ns/object-views"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************  -->
    <!-- ********************************* PENDIENTE_FIRMA_SECRETARIO ********************************  -->
    <!-- *********************************************************************************************  -->
    <!-- El estado no tiene botones: sus dos eventos (FIRMAR y RECHAZAR_FIRMA) son de sistema y los dispara el
         servidor cuando el secretario firma o rechaza la resolución en su bandeja de firmas. -->


    <form state="PENDIENTE_FIRMA_SECRETARIO">
        <include-panels>
            -datos-alumno
            -matricula
            -resolucion-a-firmar
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La resolución está pendiente de la firma del secretario</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ********************************* PENDIENTE_FIRMA_DIRECTOR **********************************  -->
    <!-- *********************************************************************************************  -->
    <!-- El estado no tiene botones: sus dos eventos (FIRMAR y RECHAZAR_FIRMA) son de sistema y los dispara el
         servidor cuando el director firma o rechaza la resolución en su bandeja de firmas, que
         ya lleva la firma del secretario. -->

    <form state="PENDIENTE_FIRMA_DIRECTOR">
        <include-panels>
            -datos-alumno
            -matricula
            -resolucion-a-firmar
        </include-panels>

        <panel name="avisoEstadoExpediente" colSpan="12" showFrame="false">
            <help variant="info" colSpan="12">La resolución está pendiente de la firma del director</help>
        </panel>

        <footer>
            <buttons-left/>
            <buttons-right>
                <button name="EXIT" colSpan="2" title="Salir" onClick="subsysTramitador-event-action"/>
            </buttons-right>
        </footer>
    </form>

</object-views>
