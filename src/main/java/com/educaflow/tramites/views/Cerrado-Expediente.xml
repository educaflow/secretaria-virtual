<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysExpedientes.Expediente@Cerrados-action"  title="Expedientes cerrados" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="grid" name="subsysExpedientes.Expediente@Cerrados-grid"/>
        <domain>self.abierto=false </domain>
        <context name="_profile" expr="RESPONSABLE"/>
    </action-view>
    <grid name="subsysExpedientes.Expediente@Cerrados-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          action="subsysExpedientes-event-view-action"
    >
        <field name="numeroExpediente"/>
        <field name="tipoExpediente.name"/>
        <field name="namePhase"/>
        <field name="nameState"/>
        <field name="fechaUltimoEstado"/>
    </grid>




</object-views>