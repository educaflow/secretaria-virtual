<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">



    <!-- La bandeja «Expedientes Esperando» se pinta con un GRID y no con un tree a propósito: la vista
         tree de Axelor pide los hijos de cada nodo con el tamaño de página por defecto (40) y SIN paginación
         (axelor-front, views/tree/tree.tsx → onSearchNode llama a ds.search sin limit ni offset; la barra de
         paginación del árbol solo gobierna el nodo raíz), así que en cuanto un trámite supera los 40
         expedientes abiertos el resto queda INALCANZABLE desde la bandeja. El grid sí pagina y conserva la
         agrupación por trámite con groupBy. MUST NOT volver a colgar aquí un tree de expedientes mientras
         el framework no pagine los hijos. -->
    <action-view name="subsysExpedientes.Expediente@Esperando-action" title="Expedientes esperando a que otra persona realice una tarea"  model="com.educaflow.subsystem.expedientes.db.Expediente" >
        <view type="grid" name="subsysExpedientes.Expediente@Esperando-grid"/>
        <domain>self.abierto=true AND (self.centro.id IN (SELECT cu.centro.id FROM CentroUsuario cu WHERE cu.usuario.id = :usuarioId) OR :esAdministrador = true)</domain>
        <context name="_profile" expr="RESPONSABLE"/>
        <context name="usuarioId" expr="eval: __user__?.id"/>
        <context name="esAdministrador" expr="eval: __user__?.group?.code == 'admins'"/>
    </action-view>

    <grid name="subsysExpedientes.Expediente@Esperando-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false"
          canSave="false"
          action="subsysExpedientes-event-view-action"
    >
        <field name="numeroExpediente"/>
        <field name="tipoExpediente.name"/>
        <field name="createdBy"/>
        <field name="namePhase"/>
        <field name="nameState"/>
        <field name="fechaUltimoEstado"/>
    </grid>




</object-views>