<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <form name="subsysExpedientes-templates-form" title="Expediente" model="com.educaflow.subsystem.expedientes.db.Expediente">

        <panel name="subsysExpedientes-template-header-panel" colSpan="12" title="Información general" >
            <!--
                Dos filas de 12. Al añadir la fase, meter los cinco elementos en una sola fila
                obligaba a recortar "Creado por" (3->2) y "Estado" (4->3), y los campos readonly se
                pintan con white-space: nowrap y overflow: hidden, sin elipsis: los nombres reales
                (nombre + apellidos) se cortaban en seco. La fecha (un datetime que pinta
                dd/MM/yyyy HH:mm) y el botón (título de 27 caracteres) ya estaban al límite, así que
                el recorte no se podía trasladar a ellos.
            -->
            <panel colSpan="12">
                <field name="createdBy" title="Creado por" readonly="true" colSpan="4"/>
                <field name="namePhase" readonly="true" colSpan="4" title="Fase"/>
                <field name="nameState" readonly="true" colSpan="4" title="Estado"/>
            </panel>
            <panel colSpan="12">
                <field name="fechaUltimoEstado" readonly="true" colSpan="3"/>
                <field name="perfilEstado" readonly="true" colSpan="3"/>
                <button name="mostrar-historial-estados"  title="Ver el historial de estados" outline="true" onClick="subsysExpedientes.Expediente-verHistorialEstados-action" colSpan="3" colOffset="3"/>
            </panel>
        </panel>

        <panel name="persona-solicitante" title="Persona que presenta la solicitud" colSpan="12"
               showIf="presentadoEnRepresentacion">
            <field name="personaSolicitante.apellidos" title="Apellidos" colSpan="5" readonly="true"/>
            <field name="personaSolicitante.nombre"    title="Nombre"    colSpan="4" readonly="true"/>
            <field name="personaSolicitante.dni"       title="DNI/NIE"   colSpan="3" readonly="true"/>
            <field name="presentadoEnRepresentacion" hidden="true"/>
        </panel>

        <!-- Versión editable de persona-solicitante, para el estado en el que se teclean los datos: en papel y en
             representación nadie más rellena al solicitante. La identificación la bloquea
             subsysExpedientes-persona-solicitante-onLoad-action en los demás modos, por lo mismo que se explica
             en persona-interesada. -->
        <panel name="persona-solicitante-editable" title="Persona que presenta la solicitud" colSpan="12"
               showIf="presentadoEnRepresentacion">
            <field name="personaSolicitante" showTitle="false" colSpan="12"
                   canNew="false" canSelect="false" canRemove="false" x-show-icons="false">
                <editor x-show-titles="true">
                    <field name="apellidos" colSpan="5" required="true"/>
                    <field name="nombre"    colSpan="4" required="true"/>
                    <field name="dni" title="DNI/NIE" colSpan="3" required="true"/>
                </editor>
            </field>
            <field name="presentadoEnRepresentacion" hidden="true"/>
            <field name="presentadoEnPapel" hidden="true"/>
        </panel>

        <!-- Axelor pinta siempre de solo lectura un campo con punto, así que lo editable va en un <editor>.
             Dentro del editor no se puede usar _parent en showIf/readonlyIf, y un campo con punto del form
             (personaInteresada.nombre) le pasa sus atributos al campo nombre del editor: por eso la
             identificación la bloquea subsysExpedientes-persona-interesada-onLoad-action. -->
        <panel name="persona-interesada" title="Persona interesada" colSpan="12">
            <field name="personaInteresada" showTitle="false" colSpan="12"
                   canNew="false" canSelect="false" canRemove="false">
                <editor x-show-titles="true">
                    <field name="apellidos" colSpan="5"/>
                    <field name="nombre"    colSpan="4"/>
                    <field name="dni" title="DNI/NIE" colSpan="3"/>
                    <field name="email"     colSpan="6"/>
                    <field name="telefono"  colSpan="6"/>
                    <field name="direccion" colSpan="12"/>
                    <field name="municipio" colSpan="8" canNew="false" canEdit="false" canView="false"/>
                    <field name="cp"        colSpan="4"/>
                </editor>
            </field>
            <field name="presentadoEnRepresentacion" hidden="true"/>
            <field name="presentadoEnPapel" hidden="true"/>
        </panel>

        <panel name="subsysExpedientes-template-footer-panel" colSpan="12" itemSpan="2" showFrame="false">
            <field name="errorMessajesField" showTitle="false" readonly="true" colSpan="12">
                <viewer depends="errorMensajes" ><![CDATA[
                    <>
                    <Box>
                        {errorMensajes.length > 0 ? (
                        <div className="alert alert-danger fade show" role="alert">
                            <ul >
                                {errorMensajes.map((errorMensaje, index) => (
                                <li key={index}>
                                    {errorMensaje.label || errorMensaje.fieldName ? (<strong>{errorMensaje.label || errorMensaje.fieldName}:&nbsp;&nbsp;</strong>) : null}
                                    {errorMensaje.message}
                                </li>
                                ))}
                            </ul>
                        </div>
                        ) : (
                        <span></span>
                        )}
                    </Box>
                    </>
                    ]]></viewer>
            </field>
        </panel>
    </form>


    <action-attrs name="subsysExpedientes-persona-interesada-onLoad-action">
        <attribute for="personaInteresada.apellidos" name="readonly" expr="eval: presentadoEnRepresentacion != true &amp;&amp; presentadoEnPapel != true"/>
        <attribute for="personaInteresada.nombre"    name="readonly" expr="eval: presentadoEnRepresentacion != true &amp;&amp; presentadoEnPapel != true"/>
        <attribute for="personaInteresada.dni"       name="readonly" expr="eval: presentadoEnRepresentacion != true &amp;&amp; presentadoEnPapel != true"/>
    </action-attrs>

    <action-attrs name="subsysExpedientes-persona-solicitante-onLoad-action">
        <attribute for="personaSolicitante.apellidos" name="readonly" expr="eval: presentadoEnPapel != true"/>
        <attribute for="personaSolicitante.nombre"    name="readonly" expr="eval: presentadoEnPapel != true"/>
        <attribute for="personaSolicitante.dni"       name="readonly" expr="eval: presentadoEnPapel != true"/>
    </action-attrs>


    <action-view name="subsysExpedientes.Expediente-verHistorialEstados-action" title="Historial estados" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="form" name="subsysExpedientes.Expediente-verHistorialEstados-form"/>

        <view-param name="popup" value="true"/>
        <view-param name="show-toolbar" value="false"/>
        <view-param name="popup-save" value="false"/>
        <context name="_showRecord" expr="eval: __id__"/>
    </action-view>

    <form name="subsysExpedientes.Expediente-verHistorialEstados-form" title="Historial de estados del expediente" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <panel name="expediente" title="Expediente" colSpan="12" >
            <field name="numeroExpediente" colSpan="2" />
            <field name="name" colSpan="10"/>
        </panel>
        <panel-related name="estados" title="Historial de estados" field="historialEstados" colSpan="12" form-view="subsysExpedientes.Expediente.HistorialEstado-form"  grid-view="subsysExpedientes.Expediente.HistorialEstado-grid"  />
    </form>


    <grid name="subsysExpedientes.Expediente.HistorialEstado-grid" title="Historial de estados" model="com.educaflow.subsystem.expedientes.db.HistorialEstado"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false"
          canSave="false" orderBy="fecha" canViewOnClick="true"
    >
        <field name="createdBy"/>
        <field name="nameEvent"/>
        <field name="namePhase"/>
        <field name="nameState"/>
        <field name="fecha"/>
        <field name="registroEntrada"/>
        <field name="registroSalida"/>
    </grid>

    <form name="subsysExpedientes.Expediente.HistorialEstado-form" title="Registro" model="com.educaflow.subsystem.expedientes.db.HistorialEstado"
          canAttach="false"
        >
        <panel-tabs hideIf="(registroEntrada==null) &amp;&amp; (registroSalida==null)">
            <panel name="registroEntrada" title="Registro de Entrada" colSpan="12" hideIf="registroEntrada==null">
                <field name="registroEntrada.numeroRegistro" />
                <field name="registroEntrada.documentoOriginalFirmado" widget="binary-link"  colSpan="12"/>
                <field name="registroEntrada.documentoResguardoPresentacion" widget="binary-link"  colSpan="12"/>
                <panel-related name="RegistroEntrada.Anexos" title="Anexos" field="registroEntrada.anexos" colSpan="12" grid-view="subsysExpedientes.Expediente.HistorialEstado.RegistroEntrada.Anexos.MetaFile-grid" form-view="subsysExpedientes.Expediente.HistorialEstado.RegistroEntrada.Anexos.MetaFile-form"    />
            </panel>
            <panel name="registroSalida" title="Registro de salida" colSpan="12"  hideIf="registroSalida==null">
                <field name="registroSalida.numeroRegistro" />
                <field name="registroSalida.documento" widget="binary-link"  colSpan="12"/>
                <panel-related name="registroSalidaAnexos" title="Anexos" field="registroSalida.anexos" colSpan="12"  grid-view="subsysExpedientes.Expediente.HistorialEstado.RegistroSalida.Anexos.MetaFile-grid" form-view="subsysExpedientes.Expediente.HistorialEstado.RegistroSalida.Anexos.MetaFile-form"   />
            </panel>
        </panel-tabs>

        <panel showFrame="false" colSpan="12" hideIf="(registroEntrada!=null) || (registroSalida!=null)">
            <help variant="warning" colSpan="12">
                <![CDATA[
                    <>
                    En este estado no se generó ningún registro de entrada ni de salida, por lo que no hay información adicional que mostrar.
                    </>
                ]]>
            </help>
        </panel>
    </form>


    <grid name="subsysExpedientes.Expediente.HistorialEstado.RegistroEntrada.Anexos.MetaFile-grid" title="Anexos" model="com.axelor.meta.db.MetaFile"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          canViewOnClick="true" >
        <field name="fileName"/>
    </grid>
    <form name="subsysExpedientes.Expediente.HistorialEstado.RegistroEntrada.Anexos.MetaFile-form" title="Anexo" canAttach="false"  model="com.axelor.meta.db.MetaFile">
        <panel title="">
            <field name="fileName" colSpan="10"/>
            <field name="content" widget="binary" title="Descargar" colSpan="2"/>
        </panel>
    </form>


    <grid name="subsysExpedientes.Expediente.HistorialEstado.RegistroSalida.Anexos.MetaFile-grid" title="Anexos" model="com.axelor.meta.db.MetaFile"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          canViewOnClick="true"
    >
        <field name="fileName"/>
    </grid>
    <form name="subsysExpedientes.Expediente.HistorialEstado.RegistroSalida.Anexos.MetaFile-form" title="Anexo" canAttach="false"  model="com.axelor.meta.db.MetaFile">
        <panel title="">
            <field name="fileName" colSpan="10"/>
            <field name="content" widget="binary" title="Descargar" colSpan="2"/>
        </panel>
    </form>




</object-views>
