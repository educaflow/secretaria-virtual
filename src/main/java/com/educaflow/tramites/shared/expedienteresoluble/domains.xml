<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <!-- Misma unidad de persistencia que Expediente (JOINED): la clase generada vive en
         com.educaflow.subsystem.expedientes.db aunque el XML esté en tramites/shared/,
         porque el paquete lo declara el <module>, no la carpeta. -->
    <module name="expedientes" package="com.educaflow.subsystem.expedientes.db"/>

    <!-- Entidad base COMPARTIDA por los trámites que se tramitan con resolución firmada:
         solicitud generada, firma de la solicitud, registro de entrada, resolución,
         firma de la resolución y registro de salida. No es un trámite (no tiene
         TipoExpedienteInstance): cada tipo la extiende con sus propios datos y
         declara extends="ExpedienteResoluble" en lugar de extends="Expediente". -->
    <entity name="ExpedienteResoluble" extends="Expediente">

        <!-- Títulos neutros, sin el nombre del trámite: la entidad es compartida y cada tipo
             (anulación, justificación...) puede re titular los campos en su vista. -->
        <!-- Documentos -->
        <many-to-one name="pdfSolicitud" title="Solicitud" ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfSolicitudFirmada" title="Solicitud firmada" ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfJustificanteRegistroEntrada" title="Justificante de presentación" ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfResolucion" title="Resolución sin firmar" ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfResolucionFirmada" title="Resolución" ref="com.axelor.meta.db.MetaFile" />
        <many-to-one name="pdfResolucionFirmadaRegistroSalida" title="Resolución registrada" ref="com.axelor.meta.db.MetaFile" />

        <!-- Fechas -->
        <datetime name="fechaHoraPdfSolicitud" title="Fecha y hora de creación de la solicitud" />
        <datetime name="fechaHoraPdfSolicitudFirmada" title="Fecha y hora de la firma de la solicitud" />
        <datetime name="fechaHoraPdfJustificanteRegistroEntrada" title="Fecha y hora de creación del justificante del registro de entrada" />
        <datetime name="fechaHoraPdfResolucion" title="Fecha y hora de creación de la resolución" />
        <datetime name="fechaHoraPdfResolucionFirmada" title="Fecha y hora de firma de la resolución" />
        <datetime name="fechaHoraPdfResolucionFirmadaRegistroSalida" title="Fecha y hora de creación de la resolución en el registro de salida" />

        <!-- Verificación de la solicitud (fase común VERIFICACION) -->
        <enum name="resultadoVerificacion" title="Resultado de la verificación" ref="ResultadoVerificacion" />
        <string name="textoSubsanacion" title="Qué hay que subsanar" large="true" />
        <date name="fechaVerificacion" title="Fecha de la verificación" />

    </entity>

    <enum name="ResultadoVerificacion">
        <item name="CORRECTO" title="La solicitud es correcta"/>
        <item name="SUBSANAR" title="Pedir subsanación"/>
    </enum>

</domain-models>