<?xml version="1.0" encoding="UTF-8"?>
<fragmento xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/educaflow/EducaFlowBuildTools/master/src/main/resources/com/educaflow/common/buildtools/xml2pdf/documento.xsd">

    <titulo>
        <valenciano>Justificació de falta del professorat</valenciano>
        <castellano>Justificación de falta del profesorado</castellano>
    </titulo>

    <seccion>
        <valenciano>Centre docent de presentació</valenciano>
        <castellano>Centro docente de presentación</castellano>
        <fila>
            <campo nombreCampo="self.centro.name" colspan="4">
                <valenciano>Nom</valenciano>
                <castellano>Nombre</castellano>
            </campo>
            <campo nombreCampo="self.centro.code" colspan="4">
                <valenciano>Codi</valenciano>
                <castellano>Código</castellano>
            </campo>
            <campo nombreCampo="self.centro.municipio.name" colspan="4">
                <valenciano>Municipi</valenciano>
                <castellano>Municipio</castellano>
            </campo>
        </fila>
    </seccion>

    <seccion>
        <valenciano>Dades de l'interessat</valenciano>
        <castellano>Datos del interesado</castellano>
        <fila>
            <campo nombreCampo="self.personaInteresada.dni" colspan="4">
                <valenciano>DNI</valenciano>
            </campo>
            <campo nombreCampo="self.personaInteresada.apellidos" colspan="4">
                <valenciano>Cognoms</valenciano>
                <castellano>Apellidos</castellano>
            </campo>
            <campo nombreCampo="self.personaInteresada.nombre" colspan="4">
                <valenciano>Nom</valenciano>
                <castellano>Nombre</castellano>
            </campo>
        </fila>
    </seccion>

    <seccion>
        <valenciano>Declara que</valenciano>
        <castellano>Declara que</castellano>
        <fila>
            <campo nombreCampo="self.dias" colspan="4">
                <valenciano>Els dies</valenciano>
                <castellano>Los días</castellano>
            </campo>
            <campo nombreCampo="self.mes" colspan="4">
                <valenciano>Del mes</valenciano>
                <castellano>Del mes</castellano>
            </campo>
            <campo nombreCampo="String.valueOf(self.anyo)" colspan="4">
                <valenciano>De l'any</valenciano>
                <castellano>Del año</castellano>
            </campo>
        </fila>
        <fila>
            <texto colspan="12">
                <valenciano>No ha pogut impartir les següents hores</valenciano>
                <castellano>No ha podido impartir las siguientes horas</castellano>
            </texto>
            <check nombreCampo="self.tipoJornadaFalta==com.educaflow.subsystem.expedientes.db.TipoJornadaFaltaJustificacionFaltaProfesoradoV1.TODA_LA_JORNADA" colspan="12">
                <valenciano>Tota la jornada</valenciano>
                <castellano>Toda la jornada</castellano>
            </check>
            <check nombreCampo="self.tipoJornadaFalta==com.educaflow.subsystem.expedientes.db.TipoJornadaFaltaJustificacionFaltaProfesoradoV1.JORNADA_PARCIAL" colspan="12">
                <valenciano>Jornada parcial. De ${self.horaInicio;0.6} hores a ${self.horaFin;0.6} hores</valenciano>
                <castellano>Jornada parcial. De ${self.horaInicio;0.6} horas a ${self.horaFin;0.6} horas</castellano>
            </check>
        </fila>
        <fila>
            <campo nombreCampo="self.motivoFalta" colspan="12">
                <valenciano>Pel motiu següent</valenciano>
                <castellano>Por el motivo siguiente</castellano>
            </campo>
            <campo nombreCampo="self.otroMotivo" colspan="12" />
        </fila>
    </seccion>

    <seccion>
        <valenciano>Documentació aportada</valenciano>
        <castellano>Documentación aportada</castellano>
        <fila>
            <campo nombreCampo="self.justificante.fileName" colspan="12" />
            <campo nombreCampo='"    " + com.educaflow.base.util.MetaFileUtil.sha256(self.justificante)' colspan="12" />
        </fila>
    </seccion>

</fragmento>
