<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">



    <action-view name="subsysSistemaEducativo.FamiliaProfesional@Main-action" title="Familias profesionales"  model="com.educaflow.subsystem.sistemaeducativo.db.FamiliaProfesional">
        <view type="grid" name="subsysSistemaEducativo.FamiliaProfesional@Main-grid"/>
        <view type="form" name="subsysSistemaEducativo.FamiliaProfesional@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysSistemaEducativo.FamiliaProfesional@Main-grid" title="Familia profesional" model="com.educaflow.subsystem.sistemaeducativo.db.FamiliaProfesional"
          groups="admins"
          canNew="true"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="false"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true"
    >
        <hilite color="danger" if="archived"/>
        <field name="code" width="200px" />
        <field name="name" />
        <field name="archived"  width="100px" />

    </grid>

    <form name="subsysSistemaEducativo.FamiliaProfesional@Main-form" title="Familia Profesional"  model="com.educaflow.subsystem.sistemaeducativo.db.FamiliaProfesional"
          groups="admins"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="FamiliaProfesional" title="">
            <field name="code" colSpan="3" />
            <field name="name" colOffset="9" />
        </panel>

        <panel-related name="ciclos" field="ciclos" grid-view="subsysSistemaEducativo.Ciclo@Search-grid" form-view="subsysSistemaEducativo.Ciclo@View-form" colSpan="12" canEdit="false" canNew="false" canRemove="false" />

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="delete" css="btn-danger" colSpan="2"  outline="true" showIf="(id != null)"/>
            <button name="btnCancel" title="Cancelar" onClick="back"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="save,force-back"  colSpan="2"  />
        </panel>
    </form>


</object-views>
