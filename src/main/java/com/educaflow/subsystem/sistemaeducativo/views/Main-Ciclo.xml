<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>


    <action-view name="subsysSistemaEducativo.Main@Ciclo-action" title="Ciclos" model="com.educaflow.subsystem.sistemaeducativo.db.Ciclo">
        <view type="grid" name="subsysSistemaEducativo.Main@Ciclo-grid"/>
        <view type="form" name="subsysSistemaEducativo.Main@Ciclo-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysSistemaEducativo.Main@Ciclo-grid" model="com.educaflow.subsystem.sistemaeducativo.db.Ciclo" newButtonTitle="Añadir un nuevo ciclo" allowSearchFields="true" orderBy="name"
          canAdvanceSearch="false" canRefresh="false" canNew="true" editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true" title=""
    >
        <field name="code" width="200px" />
        <field name="name" />
        <field name="familiaProfesional" />
    </grid>

    <form name="subsysSistemaEducativo.Main@Ciclo-form" title="Ciclo" model="com.educaflow.subsystem.sistemaeducativo.db.Ciclo"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel name="Ciclo" title="Ciclo">
            <field name="code" colSpan="3" />
            <field name="name" colOffset="3" colSpan="6" />
            <field name="familiaProfesional" colOffset="6" colSpan="6" grid-view="subsysSistemaEducativo.Ref@FamiliaProfesional-grid" form-view="subsysSistemaEducativo.Ref@FamiliaProfesional-form" />
            <field name="grado" colOffset="6" colSpan="3"              grid-view="subsysSistemaEducativo.Ref@Grado-grid"  form-view="subsysSistemaEducativo.Ref@Grado-form"  domain="(self.code='D' OR self.code='E')" />
            <field name="nivel" colSpan="3"                            grid-view="subsysSistemaEducativo.Ref@Nivel-grid"  form-view="subsysSistemaEducativo.Ref@Nivel-form"  showIf="grado.code=='D'" requiredIf="grado.code=='D'" domain="(self.code='D' OR self.code='E')"/>
        </panel>

        <panel-related name="cursos" field="cursos"  title="Cursos"
            grid-view="subsysSistemaEducativo.Main@Ciclo.Curso-grid"
            form-view="subsysSistemaEducativo.Main@Ciclo.Curso-form"
            colSpan="12" newButtonTitle="Añadir un nuevo curso"
            showFooter="false" canEdit="false" canRemove="false" forceEdit="true"
        />

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="subsysSistemaEducativo.Main@Ciclo-btnDelete-action" css="btn-danger" colSpan="2"  outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysSistemaEducativo.Main@Ciclo-btnCancel-action"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="subsysSistemaEducativo.Main@Ciclo-btnSave-action"  colSpan="2"  />
        </panel>

    </form>

    <?sv-primary-actions?>
    <action-group name="subsysSistemaEducativo.Main@Ciclo-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo-btnSave-action">
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="back"/>
    </action-group>

    <?sv-validations?>


    <?sv-rules?>


    <?sv-remotes?>





    <?sv-view?>


    <grid name="subsysSistemaEducativo.Main@Ciclo.Curso-grid" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"  allowSearchFields="true" orderBy="name"
          canAdvanceSearch="false" canRefresh="false" canNew="true" newButtonTitle="Añadir un nuevo curso" editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true" title=""
    >
        <field name="code" width="150px" />
        <field name="name" width="200px" />
        <field name="leyEducativa"   />
    </grid>

    <form name="subsysSistemaEducativo.Main@Ciclo.Curso-form" title="Curso" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"
          width="large"
          onNew="subsysSistemaEducativo.Main@Ciclo.Curso-onNew-action"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false"
    >
        <panel name="Curso" title="">
            <field name="ciclo" showIf="false"/>
            <field name="code" colSpan="3" />
            <field name="name" colOffset="3" colSpan="6"/>
            <field name="leyEducativa" colSpan="6" grid-view="subsysSistemaEducativo.Ref@LeyEducativa-grid" form-view="subsysSistemaEducativo.Ref@LeyEducativa-form" />
        </panel>

        <panel-related name="modulos" field="modulos"  title="Módulos"
                       grid-view="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-grid"
                       form-view="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-form"
                       colSpan="12"
                       showFooter="false"
                       newButtonTitle="Añadir un nuevo módulo"
                       canEdit="false"
                       canRemove="false"
                       forceEdit="true"
        />
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso-btnDelete-action" css="btn-danger" colSpan="2"  outline="true" showIf="(id!=null) || (cid != null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso-btnCancel-action"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso-btnSave-action"  colSpan="2"  />
        </panel>
    </form>



    <?sv-primary-actions?>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso-btnDelete-action">
        <action name="delete-modal"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso-btnCancel-action">
        <action name="close"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso-btnSave-action">
        <action name="save-modal"/>
    </action-group>

    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso-onNew-action">
        <action name="subsysSistemaEducativo.Main@Ciclo.Curso-set-ciclo-parent-action"/>
    </action-group>

    <?sv-validations?>


    <?sv-rules?>
    <action-record name="subsysSistemaEducativo.Main@Ciclo.Curso-set-ciclo-parent-action" model="com.educaflow.subsystem.sistemaeducativo.db.Curso">
        <field name="ciclo" expr="eval: __parent__"/>
    </action-record>

    <?sv-remotes?>



    <?sv-view?>

    <grid name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-grid" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo" allowSearchFields="true" orderBy="modulo.name"
          canAdvanceSearch="false" canRefresh="false" canNew="true" newButtonTitle="Añadir un nuevo módulo" editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true" title=""
    >
        <field name="modulo" />
    </grid>

    <form name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-form" title="Módulo" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo"
          onNew="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="CursoModulo" title="">
            <field name="curso" showIf="false"/>
            <field name="modulo" colSpan="6" grid-view="subsysSistemaEducativo.Ref@Modulo-grid" form-view="subsysSistemaEducativo.Ref@Modulo-form" />
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnDelete-action" css="btn-danger" colSpan="2"  outline="true" showIf="(id!=null) || (cid != null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnCancel-action"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnSave-action"  colSpan="2"  />
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnDelete-action">
        <action name="delete-modal"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnCancel-action">
        <action name="close"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-btnSave-action">
        <action name="save-modal"/>
    </action-group>

    <action-group name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-onNew-action">
        <action name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-set-curso-parent-action"/>
    </action-group>


    <?sv-validations?>




    <?sv-rules?>
    <action-record name="subsysSistemaEducativo.Main@Ciclo.Curso.CursoModulo-set-curso-parent-action" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo">
        <field name="curso" expr="eval: __parent__"/>
    </action-record>

    <?sv-remotes?>


</object-views>