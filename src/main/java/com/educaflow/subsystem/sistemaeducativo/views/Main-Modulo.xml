<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>

    <action-view name="subsysSistemaEducativo.Main@Modulo-action" title="Módulos" model="com.educaflow.subsystem.sistemaeducativo.db.Modulo">
        <view type="grid" name="subsysSistemaEducativo.Main@Modulo-grid"/>
        <view type="form" name="subsysSistemaEducativo.Main@Modulo-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysSistemaEducativo.Main@Modulo-grid" title="" model="com.educaflow.subsystem.sistemaeducativo.db.Modulo"
          groups="admins"
          orderBy="name" canNew="true" newButtonTitle="Añadir un nuevo módulo"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="true"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true">
        <hilite color="danger" if="archived"/>
        <field name="code" width="200px" />
        <field name="name" />
        <field name="archived" width="100px" />
    </grid>

    <form name="subsysSistemaEducativo.Main@Modulo-form" title="Módulo" model="com.educaflow.subsystem.sistemaeducativo.db.Modulo"
          groups="admins"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel name="Modulo" title="Módulo">
            <field name="code" colSpan="3" />
            <field name="name" colOffset="3" colSpan="6" />
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar" onClick="subsysSistemaEducativo.Main@Modulo-btnDelete-action" css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysSistemaEducativo.Main@Modulo-btnCancel-action" colSpan="2" colOffset="6" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="subsysSistemaEducativo.Main@Modulo-btnSave-action" colSpan="2"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="subsysSistemaEducativo.Main@Modulo-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Modulo-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="subsysSistemaEducativo.Main@Modulo-btnSave-action">
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="back"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
