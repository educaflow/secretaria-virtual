<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysSistemaEducativo.Curso@Main-action" title="Cursos" model="com.educaflow.subsystem.sistemaeducativo.db.Curso">
        <view type="grid" name="subsysSistemaEducativo.Curso@Main-grid"/>
        <view type="form" name="subsysSistemaEducativo.Curso@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysSistemaEducativo.Curso@Main-grid" title="Curso" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"
          groups="admins"
          canNew="true" newButtonTitle="Nuevo curso"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="false"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true"
    >
        <hilite color="danger" if="archived"/>
        <field name="code" width="150px" />
        <field name="name" />
        <field name="archived" width="100px" />
    </grid>

    <form name="subsysSistemaEducativo.Curso@Main-form" title="Curso" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"
          groups="admins"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Curso" title="">
            <field name="code" colSpan="3" />
            <field name="name" colOffset="9"  colSpan="6"/>
            <field name="ciclo" colOffset="6" colSpan="6" />
            <field name="leyEducativa" colSpan="12" />
        </panel>

        <panel-related name="cursos" field="modulos"
                       grid-view="subsysSistemaEducativo.Curso.CursoModulo@Main-grid"
                       form-view="subsysSistemaEducativo.Curso.CursoModulo@Main-form"
                       colSpan="12"
        />

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="delete" css="btn-danger" colSpan="2"  outline="true" showIf="(id != null)"/>
            <button name="btnCancel" title="Cancelar" onClick="back"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="save,force-back"  colSpan="2"  />
        </panel>

    </form>

    <grid name="subsysSistemaEducativo.Curso@Search-grid" title="Curso" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"
          groups="admins,users"
          orderBy="name"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="ciclo.familiaProfesional" />
        <field name="ciclo"  />
        <field name="name" />
    </grid>

    <form name="subsysSistemaEducativo.Curso@View-form" title="Curso" model="com.educaflow.subsystem.sistemaeducativo.db.Curso"
          groups="admins"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Curso" title="">
            <field name="code" colSpan="3" readonly="true" />
            <field name="name" colOffset="9"  colSpan="6" readonly="true"/>
            <field name="ciclo" colOffset="6" colSpan="6" readonly="true" />
            <field name="leyEducativa" colSpan="12" />
        </panel>
    </form>

    <!-- ******************************************************************************************************** -->
    <!-- ********************************* Vistas de CursoModulo hijos de Curso ********************************* -->
    <!-- ******************************************************************************************************** -->


    <grid name="subsysSistemaEducativo.Curso.CursoModulo@Main-grid" title="Curso-Módulos" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo"
          groups="admins"
          canNew="true"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="false"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true"
    >
        <field name="modulo" />
    </grid>

    <form name="subsysSistemaEducativo.Curso.CursoModulo@Main-form" title="Curso-Módulo" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo"
          groups="admins"
          onNew="subsysSistemaEducativo.Curso.CursoModulo@Main-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="CursoModulo" title="">
            <field name="curso"  colSpan="6" showIf="false" />
            <field name="modulo" colSpan="6" colOffset="6" />
        </panel>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de las tareas principales ****************************  -->
    <!-- *********************************************************************************************  -->
    <action-group name="subsysSistemaEducativo.Curso.CursoModulo@Main-onNew-action">
        <action name="subsysSistemaEducativo.Curso.CursoModulo@Main-set-curso-parent-action"/>
    </action-group>




    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de Validaciones en local  ****************************  -->
    <!-- *********************************************************************************************  -->




    <!-- *********************************************************************************************  -->
    <!-- ************************ Acciones básicas que cambian campos simples ************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="subsysSistemaEducativo.Curso.CursoModulo@Main-set-curso-parent-action" model="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo">
        <field name="curso" expr="eval: __parent__"/>
    </action-record>




    <!-- *********************************************************************************************  -->
    <!-- ************************** Acciones de llamadas Remotas al servidor *************************  -->
    <!-- *********************************************************************************************  -->


</object-views>
