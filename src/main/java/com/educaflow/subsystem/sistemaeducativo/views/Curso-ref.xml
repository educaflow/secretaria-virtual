            <field name="code" colSpan="3" readonly="true" />
            <field name="name" colOffset="3" colSpan="6" readonly="true"/>
            <field name="ciclo" colOffset="6" colSpan="6" readonly="true" />
            <field name="leyEducativa" colSpan="12" readonly="true"/>
        </panel>
    </form>

</object-views>
