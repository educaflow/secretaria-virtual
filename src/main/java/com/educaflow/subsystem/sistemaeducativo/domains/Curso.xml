<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="sistemaeducativo" package="com.educaflow.subsystem.sistemaeducativo.db"/>
    <entity name="Curso">
        <string name="code"  required="true"  />
        <string name="name" namecolumn="true"  required="true"  />
        <many-to-one name="ciclo" ref="com.educaflow.subsystem.sistemaeducativo.db.Ciclo" required="true"  />
        <many-to-one name="leyEducativa" ref="com.educaflow.subsystem.sistemaeducativo.db.LeyEducativa" required="true"  />
        <one-to-many name="modulos" ref="com.educaflow.subsystem.sistemaeducativo.db.CursoModulo" title="Módulos" mappedBy="curso"/>
    </entity>

</domain-models>