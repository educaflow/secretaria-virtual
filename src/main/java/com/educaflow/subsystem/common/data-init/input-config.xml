<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <!-- Datos maestros del subsistema common.
         tiposUsuario ANTES que cargos: cargos referencia tipoUsuario por código. -->

    <input file="tiposUsuario.xml" root="datos">
        <bind node="tiposUsuario/tipoUsuario" type="com.educaflow.subsystem.common.db.TipoUsuario" search="self.codigo = :codigo" create="true" update="true">
            <bind node="@codigo" to="codigo"/>
            <bind node="@nombre" to="nombre"/>
        </bind>
    </input>

    <input file="cargos.xml" root="datos">
        <bind node="cargos/cargo" type="com.educaflow.subsystem.common.db.Cargo" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@tipoUsuario" to="tipoUsuario" search="self.codigo = :tipoUsuario" update="false" create="false"/>
        </bind>
    </input>

    <!-- Geografía: ComunidadAutonoma -> Provincia -> Municipio (cadena de FKs por código).
         Conselleria es independiente. Todos deben existir ANTES que Centro. -->
    <input file="ComunidadAutonoma.xml" root="datos">
        <bind node="comunidadesAutonomas/comunidadAutonoma" type="com.educaflow.subsystem.common.db.ComunidadAutonoma" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
        </bind>
    </input>

    <input file="Provincia.xml" root="datos">
        <bind node="provincias/provincia" type="com.educaflow.subsystem.common.db.Provincia" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@comunidadAutonoma" to="comunidadAutonoma" search="self.code = :comunidadAutonoma" create="false" update="false"/>
        </bind>
    </input>

    <input file="Municipio.xml" root="datos">
        <bind node="municipios/municipio" type="com.educaflow.subsystem.common.db.Municipio" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@provincia" to="provincia" search="self.code = :provincia" create="false" update="false"/>
        </bind>
    </input>

    <input file="Conselleria.xml" root="datos">
        <bind node="consellerias/conselleria" type="com.educaflow.subsystem.common.db.Conselleria" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
        </bind>
    </input>

    <!-- Centros: deben existir ANTES que los usuarios (los usuarios los referencian).
         Refieren a Municipio y Conselleria por código. -->
    <input file="Centro.xml" root="datos">
        <bind node="centros/centro" type="com.educaflow.subsystem.common.db.Centro" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@direccion" to="direccion"/>
            <bind node="@codigoPostal" to="codigoPostal"/>
            <bind node="@curso" to="curso"/>
            <bind node="@municipio" to="municipio" search="self.code = :municipio" create="false" update="false"/>
            <bind node="@conselleria" to="conselleria" search="self.code = :conselleria" create="false" update="false"/>
        </bind>
    </input>


    <!-- Permisos del subsistema common -->
    <input file="auth-common.xml" root="auth">
        <bind node="permission" type="com.axelor.auth.db.Permission" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@object" to="object"/>
            <bind node="@condition" to="condition"/>
            <bind node="@conditionParams" to="conditionParams"/>
            <bind node="can/@create" to="canCreate"/>
            <bind node="can/@read" to="canRead"/>
            <bind node="can/@write" to="canWrite"/>
            <bind node="can/@remove" to="canRemove"/>
            <bind node="can/@export" to="canExport"/>
        </bind>
    </input>

</xml-inputs>
