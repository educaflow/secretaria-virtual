<?xml version="1.0"?>
<xml-inputs priority="10" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <!-- Datos maestros del subsistema common.
         tiposUsuario ANTES que cargos: cargos referencia tipoUsuario por código. -->

    <input file="tiposUsuario.xml" root="datos">
        <bind node="tiposUsuario/tipoUsuario" type="com.educaflow.subsystem.common.db.TipoUsuario" search="self.codigo = :codigo" create="true" update="true">
            <bind node="@codigo" to="codigo"/>
            <bind node="@nombre" to="nombre"/>
        </bind>
    </input>

    <input file="cargos.xml" root="datos">
        <bind node="cargos/cargo" type="com.educaflow.subsystem.common.db.Cargo" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@tipoUsuario" to="tipoUsuario" search="self.codigo = :tipoUsuario" update="false" create="false"/>
        </bind>
    </input>

    <!-- Centros: deben existir ANTES que los usuarios (los usuarios los referencian). -->
    <input file="centros.xml" root="datos">
        <bind node="centros/centro" type="com.educaflow.subsystem.common.db.Centro" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@curso" to="curso"/>
        </bind>
    </input>

    <!-- Usuarios con login funcional. TRES inputs sobre el mismo fichero, en orden:
         (a) User, (b) CentroUsuario, (c) CentroUsuarioTipoUsuario.
         El grupo `users` se referencia con create="true": en common (priority=10) se
         crea como shell si aún no existe; el data-init global (priority=-1, carga DESPUÉS)
         lo encuentra por code y lo completa con sus permisos (update="true"). Así el User
         siempre tiene group asignado (requisito para login) sin duplicar el grupo. -->
    <input file="usuarios.xml" root="usuarios">
        <bind node="usuario" type="com.axelor.auth.db.User" search="self.code = :code" create="true" update="true" call="com.axelor.auth.AuthService:encrypt">
            <bind node="@code" to="code"/>
            <bind node="@name" to="name"/>
            <bind node="@nombre" to="nombre"/>
            <bind node="@apellidos" to="apellidos"/>
            <bind node="@email" to="email"/>
            <bind node="@dni" to="dni"/>
            <bind to="language" eval="'es'"/>
            <bind node="@password" to="password"/>
            <bind node="@group" to="group" search="self.code = :group" create="true" update="false"/>
            <bind node="@centro" to="centroActivo" search="self.code = :centro" create="false" update="false"/>
        </bind>
    </input>

    <input file="usuarios.xml" root="usuarios">
        <bind node="usuario" type="com.educaflow.subsystem.common.db.CentroUsuario" search="self.centro.code = :centro AND self.usuario.code = :usuario" create="true" update="true">
            <bind node="@centro" alias="centro"/>
            <bind node="@code" alias="usuario"/>
            <bind node="@centro" to="centro" search="self.code = :centro" create="false" update="false"/>
            <bind node="@code" to="usuario" search="self.code = :usuario" create="false" update="false"/>
        </bind>
    </input>

    <input file="usuarios.xml" root="usuarios">
        <bind node="usuario" type="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario" search="self.centroUsuario.centro.code = :centro AND self.centroUsuario.usuario.code = :usuario AND self.tipoUsuario.codigo = :tipoUsuario" create="true" update="true">
            <bind node="@centro" alias="centro"/>
            <bind node="@code" alias="usuario"/>
            <bind node="@tipoUsuario" alias="tipoUsuario"/>
            <bind node="@code" to="centroUsuario" search="self.centro.code = :centro AND self.usuario.code = :usuario" create="false" update="false"/>
            <bind node="@tipoUsuario" to="tipoUsuario" search="self.codigo = :tipoUsuario" create="false" update="false"/>
        </bind>
    </input>

    <!-- Permisos del subsistema common -->
    <input file="auth-common.xml" root="auth">
        <bind node="permission" type="com.axelor.auth.db.Permission" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@object" to="object"/>
            <bind node="@condition" to="condition"/>
            <bind node="@conditionParams" to="conditionParams"/>
            <bind node="can/@create" to="canCreate"/>
            <bind node="can/@read" to="canRead"/>
            <bind node="can/@write" to="canWrite"/>
            <bind node="can/@remove" to="canRemove"/>
            <bind node="can/@export" to="canExport"/>
        </bind>
    </input>

</xml-inputs>
