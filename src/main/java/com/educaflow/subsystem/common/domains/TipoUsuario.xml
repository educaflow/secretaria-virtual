<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="common" package="com.educaflow.subsystem.common.db"/>

    <entity name="TipoUsuario">
        <enum name="codigo" ref="com.educaflow.subsystem.common.db.TipoUsuarioCodigo" title="Código"/>
        <string name="nombre" namecolumn="true" title="Nombre"/>
        <string name="tituloTramites" formula="true" title="Trámites">'Trámites para el ' || lower(nombre)</string>
        <!--
          orphanRemoval="false" es OBLIGATORIO y NO es redundante en centroUsuarioTipoUsuario y cargos: son
          AGREGACIÓN, no composición. En una one-to-many BIDIRECCIONAL (con mappedBy) el generador de axelor-tools
          considera orphanRemoval = true cuando el atributo no se declara (Property.getOrphanRemoval()), y entonces
          emite @OneToMany(..., cascade = CascadeType.ALL, orphanRemoval = true): borrar un tipo de usuario o
          quitarlo de la colección borraría sus filas. El dueño de CentroUsuarioTipoUsuario es CentroUsuario, no
          TipoUsuario. Declarándolo a false, resolveCascadeTypes vuelve a PERSIST,MERGE y no se emite orphanRemoval.
        -->
        <one-to-many name="centroUsuarioTipoUsuario"
                     ref="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
                     mappedBy="tipoUsuario" orphanRemoval="false" title=""/>
        <one-to-many name="cargos"
                     ref="com.educaflow.subsystem.common.db.Cargo"
                     mappedBy="tipoUsuario" orphanRemoval="false" title="Cargos"/>

    </entity>

</domain-models>