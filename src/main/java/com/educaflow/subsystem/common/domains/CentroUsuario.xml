<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="common" package="com.educaflow.subsystem.common.db"/>

    <entity name="CentroUsuario" repository="abstract">
        <many-to-one name="centro"   ref="com.educaflow.subsystem.common.db.Centro"   title="Centro"/>
        <many-to-one name="usuario"  ref="com.axelor.auth.db.User"                     title="Usuario"/>
        <one-to-many name="centroUsuarioTipoUsuario"
                     ref="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
                     mappedBy="centroUsuario" title=""/>
        <one-to-many name="centroUsuarioCargo"
                     ref="com.educaflow.subsystem.common.db.CentroUsuarioCargo"
                     mappedBy="centroUsuario" title=""/>
        <unique-constraint columns="centro,usuario" />
    </entity>

</domain-models>