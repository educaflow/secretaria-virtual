<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysCommon.Centro@Main-action" title="Centros" model="com.educaflow.subsystem.common.db.Centro">
        <view type="grid" name="subsysCommon.Centro@Main-grid"/>
        <view type="form" name="subsysCommon.Centro@Main-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="show-toolbar-form" value="false"/>
    </action-view>

    <grid name="subsysCommon.Centro@Main-grid" title="Centros" model="com.educaflow.subsystem.common.db.Centro"
          canNew="true" newButtonTitle="Nuevo centro"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="true"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true"          >
        <field name="code" width="200px"/>
        <field name="name"/>
        <field name="curso"/>
    </grid>

    <form name="subsysCommon.Centro@Main-form" title="Datos" model="com.educaflow.subsystem.common.db.Centro"
          width="large"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="man-Centro-datos-panel" title="Datos">
                <field name="code"         colSpan="3" required="true"/>
                <field name="name"         colSpan="6" required="true"/>
                <field name="curso"        colSpan="3" readonly="true"/>
                <field name="direccion"    colSpan="9"/>
                <field name="codigoPostal" colSpan="3"/>
                <field name="comunidadAutonoma" colSpan="4"
                       onChange="subsysCommon.Centro@Main-onChange-comunidadAutonoma-action"/>
                <field name="provincia" colSpan="4"
                       domain="self.comunidadAutonoma = :comunidadAutonoma"
                       onChange="subsysCommon.Centro@Main-onChange-provincia-action"/>
                <field name="municipio"   colSpan="4" domain="self.provincia = :provincia"/>
                <field name="conselleria" colSpan="6"/>
            </panel>
            <panel-dashlet name="usuarios" title="Usuarios"
                           canNew="true" newButtonTitle="Nuevo usuario"
                           action="subsysCommon.Centro.CentroUsuario@Main-action"
                           colSpan="12" height="350" canSearch="true"/>
        </panel-tabs>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >

            <button name="btnDelete" title="Borrar" onClick="delete" css="btn-danger" colSpan="2"  outline="true" showIf="(id != null) || (cid != null)"/>
            <button name="btnCancel" title="Cancelar" onClick="back"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="save"  colSpan="2"  />
        </panel>
    </form>

    <grid name="subsysCommon.Centro@Search-grid" title="Centro" model="com.educaflow.subsystem.common.db.Centro"
          groups="admins,users"
          orderBy="name"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="name" />
    </grid>

    <form name="subsysCommon.Centro@View-form" title="Centro" model="com.educaflow.subsystem.common.db.Centro"
          width="large"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Centro" title="">
            <field name="code"               colSpan="6"  readonly="true" />
            <field name="name" colSpan="6"  readonly="true"  />
        </panel>
    </form>

    <!-- ******************************************************************************************************** -->
    <!-- ********************************* Vistas de Centro -> CentroUsuario ********************************* -->
    <!-- ******************************************************************************************************** -->
    <grid name="subsysCommon.Centro.CentroUsuario@Main-grid" title="" model="com.educaflow.subsystem.common.db.CentroUsuario"
          allowSearchFields="true"
          canAdvanceSearch="false" canRefresh="false"
          canNew="true" newButtonTitle="Nuevo usuario" editable="false"
          edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
          orderBy="usuario.apellidos"
    >
        <field name="usuario.dni" />
        <field name="usuario.nombre" />
        <field name="usuario.apellidos" />
        <!--<field name="usuario" width="400px"/>-->
    </grid>

    <form name="subsysCommon.Centro.CentroUsuario@Main-form" title="Usuario" model="com.educaflow.subsystem.common.db.CentroUsuario"
          groups="admins,users"
          onNew="subsysCommon.Centro.CentroUsuario@Main-onNew-action"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Usuario" title="">
            <field name="centro"  colSpan="6" showIf="false"/>
            <field name="usuario" colSpan="12"
                   readonlyIf="id != null"
                   grid-view="subsysCommon.Usuario@Search-grid"
            />
        </panel>
        <panel-related name="centroUsuarioTipoUsuario" title="Tipos de usuario" field="centroUsuarioTipoUsuario" colSpan="12"
                       grid-view="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-grid"
                       form-view="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-form"
                       showFooter="false"
                       newButtonTitle="Nuevo tipo de usuario"
                       canEdit="false"
                       canRemove="false"
                       forceEdit="true"
        />
        <!--<panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="delete-modal" css="btn-danger" colSpan="2"  outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="close"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="save-modal"  colSpan="2"  />
        </panel>-->
    </form>

    <!-- ******************************************************************************************************** -->
    <!-- ******************* Vistas de Centro -> CentroUsuario -> CentroUsuarioTipoUsuario ************************** -->
    <!-- ******************************************************************************************************** -->
    <grid name="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-grid" title="Tipos de usuario" model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
          groups="admins,users"
          canNew="true"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="false"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="true" canSave="false"
          canEditOnClick="true"
    >
        <field name="tipoUsuario"/>
    </grid>

    <form name="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-form" title="Tipo de usuario" model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
          groups="admins,users"
          onNew="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="centroUsuarioTipoUsuario-datos-panel" title="">
            <field name="tipoUsuario" colSpan="12"/>
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false" >
            <button name="btnDelete" title="Borrar" onClick="delete-modal" css="btn-danger" colSpan="2"  outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="close"  colSpan="2" colOffset="6" outline="true"   />
            <button name="btnSave" title="Guardar" onClick="save-modal"  colSpan="2"  />
        </panel>
    </form>
    <action-view name="subsysCommon.Centro.CentroUsuario@Main-action"
                 title="Usuarios"
                 model="com.educaflow.subsystem.common.db.CentroUsuario">
        <view type="grid" name="subsysCommon.Centro.CentroUsuario@Main-grid"/>
        <view type="form" name="subsysCommon.Centro.CentroUsuario@Main-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="limit" value="15"/>
        <view-param name="popup" value="true"/>
        <domain>self.centro.id = :centroId</domain>
        <context name="centroId" expr="eval: id"/>
    </action-view>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de las tareas principales ****************************  -->
    <!-- *********************************************************************************************  -->
    <action-group name="subsysCommon.Centro@Main-btnSave-action">
        <!--<action name="subsysCommon.Centro@Main-Local-validateSave-action"/>-->
        <action name="save"/>
        <action name="force-back"/>
    </action-group>
    <action-group name="subsysCommon.Centro@Main-btnDelete-action">
        <action name="delete"/>
    </action-group>

    <action-group name="subsysCommon.Centro.CentroUsuario@Main-onNew-action">
        <action name="subsysCommon.Centro.CentroUsuario@Main-set-centro-parent-action"/>
    </action-group>

    <action-group name="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-onNew-action">
        <action name="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-set-centroUsuario-parent-action"/>
    </action-group>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de Validaciones en local  ****************************  -->
    <!-- *********************************************************************************************  -->
    <!--<action-validate name="subsysCommon.Centro@Main-Local-validateSave-action">
        <error message="El nombre no puede ser dd" if="name=='dd'"/>
        <error message="El código no puede ser dd" if="code=='dd'"/>
    </action-validate>-->

    <!-- *********************************************************************************************  -->
    <!-- ************************ Acciones básicas que cambian campos simples ************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="subsysCommon.Centro@Main-onChange-comunidadAutonoma-action" model="com.educaflow.subsystem.common.db.Centro">
        <field name="provincia" expr="eval: null"/>
        <field name="municipio" expr="eval: null"/>
    </action-record>

    <action-record name="subsysCommon.Centro@Main-onChange-provincia-action" model="com.educaflow.subsystem.common.db.Centro">
        <field name="municipio" expr="eval: null"/>
    </action-record>

    <action-record name="subsysCommon.Centro.CentroUsuario@Main-set-centro-parent-action" model="com.educaflow.subsystem.common.db.CentroUsuario">
        <field name="centro" expr="eval: __parent__"/>
    </action-record>

    <!--<action-record name="subsysCommon.Centro.CentroUsuario@Main-onChange-usuario-action" model="com.educaflow.subsystem.common.db.CentroUsuario">
        <field name="usuario" expr="eval: __parent__"/>
    </action-record>-->

    <action-record name="subsysCommon.Centro.CentroUsuario.CentroUsuarioTipoUsuario@Main-set-centroUsuario-parent-action" model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario">
        <field name="centroUsuario" expr="eval: __parent__"/>
    </action-record>

    <!-- *********************************************************************************************  -->
    <!-- ************************** Acciones de llamadas Remotas al servidor *************************  -->
    <!-- *********************************************************************************************  -->

</object-views>