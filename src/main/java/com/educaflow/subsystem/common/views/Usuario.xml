<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.0.xsd">


    <form name="user-preferences-form" id="secretariavirtual-user-preferences-form" title="Preferencias" model="com.axelor.auth.db.User" extension="true">

        <extend target="//field[@name='image']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='email']">
            <attribute name="readonly" value="true"/>
        </extend>
        <extend target="//field[@name='theme']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='singleTab']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='noHelp']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='noHelp']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//panel[@if='__repo__(UserToken).isPermitted()']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//panel[@if='__repo__(MFA).isPermitted()']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//field[@name='image']">
            <insert position="after">
                <field name="dni"    colSpan="4" />
                <field name="nombre"  colSpan="4" />
                <field name="apellidos"   colSpan="4"  />
            </insert>
        </extend>

        <extend target="//field[@name='email']">
            <insert position="after">
                <field name="centroActivo"
                       title="Cambiar a Centro:"
                       widget="suggest"
                       domain="self.id IN (SELECT cu.centro.id FROM CentroUsuario cu WHERE cu.usuario.id = :__user__)"/>
            </insert>
        </extend>

    </form>



    <action-view name="mant-Usuario-action" title="Usuarios" model="com.axelor.auth.db.User">
        <view type="grid" name="mant-Usuario-grid"/>
        <view type="form" name="mant-Usuario-form"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>


    <grid name="mant-Usuario-grid" title="Usuarios" model="com.axelor.auth.db.User"
          groups="admins"
          editable="false" edit-icon="false" x-selector="none" canNew="true" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <toolbar>
            <button name="importar" onClick="mant-Usuario-Importar-action" title="Importar usuarios" icon="upload"/>
        </toolbar>
        <field name="code" width="200px" />
        <field name="dni" />
        <field name="name" />
        <field name="email"/>
        <field name="language"/>
        <field name="active"/>
    </grid>

    <form name="mant-Usuario-form" title="Usuario" model="com.axelor.auth.db.User"
          groups="admins" canAttach="false" canBack="false" canBackOnSave="true" canDelete="true" canNew="false">
        <panel name="Usuario" title="">
            <field name="code" colSpan="3" required="true"/>
            <field name="dni" colSpan="6" required="true"/>
            <field name="language" colOffset="6" colSpan="6" />
            <field name="name" colOffset="9" colSpan="6" required="true"/>
            <field name="email" colSpan="6" />
            <field name="active" colOffset="6" colSpan="6" />

            <!--<panel name="importar" title="Importación usuarios" colSpan="12">
                <field name="importarUsuarios" widget="binary-link" title="Fichero usuarios" colSpan="6"/>
                <button name="btnImportar" title="Importar"
                        onClick="mant-Usuario-form-importarUsuarios-action"
                        readonlyIf="!importarUsuarios" colSpan="6" />
            </panel>-->
        </panel>
    </form>

    <action-method name="mant-Usuario-form-importarUsuarios-action">
        <call class="com.educaflow.subsystem.common.importar.UserImporter" method="importarUsuarios"/>
    </action-method>

    <action-view name="mant-Usuario-Importar-action" title="Importar usuarios" model="com.axelor.auth.db.User">
        <view type="form" name="mant-Usuario-Importar-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="_id" value="null"/>
    </action-view>

    <form name="mant-Usuario-Importar-form" title="Importar usuarios" model="com.axelor.auth.db.User"
          groups="admins" canAttach="false" canBack="true" canBackOnSave="false" canDelete="false" canNew="false" canSave="false">
        <panel name="importar" title="Importar usuarios">
            <field name="importarUsuarios" widget="binary-link" title="Fichero usuarios" colSpan="6"/>
            <button name="btnImportar" title="Importar"
                    onClick="mant-Usuario-form-importarUsuarios-action"
                    readonlyIf="!importarUsuarios" colSpan="6" />
        </panel>
    </form>

</object-views>