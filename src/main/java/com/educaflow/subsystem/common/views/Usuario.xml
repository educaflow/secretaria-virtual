<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysCommon.Usuario@Main-action" title="Usuarios" model="com.axelor.auth.db.User">
        <view type="grid" name="subsysCommon.Usuario@Main-grid"/>
        <view type="form" name="subsysCommon.Usuario@Main-form"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>


    <grid name="subsysCommon.Usuario@Main-grid" title="Usuarios" model="com.axelor.auth.db.User"
          groups="admins"
          editable="false" edit-icon="false" x-selector="none" canNew="true" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <toolbar>
            <button name="importar" onClick="subsysCommon.Usuario@Importar-action" title="Importar usuarios" icon="upload"/>
        </toolbar>
        <field name="code" width="200px" />
        <field name="dni" />
        <field name="name" />
        <field name="email"/>
        <field name="language"/>
        <field name="active"/>
    </grid>

    <form name="subsysCommon.Usuario@Main-form" title="Usuario" model="com.axelor.auth.db.User"
          groups="admins" canAttach="false" canBack="false" canBackOnSave="true" canDelete="true" canNew="false">
        <panel name="Usuario" title="">
            <field name="code" colSpan="3" required="true"/>
            <field name="dni" colSpan="6" required="true"/>
            <field name="language" colOffset="6" colSpan="6" />
            <field name="name" colOffset="9" colSpan="6" required="true"/>
            <field name="email" colSpan="6" />
            <field name="active" colOffset="6" colSpan="6" />

            <!--<panel name="importar" title="Importación usuarios" colSpan="12">
                <field name="importarUsuarios" widget="binary-link" title="Fichero usuarios" colSpan="6"/>
                <button name="btnImportar" title="Importar"
                        onClick="subsysCommon.Usuario@Importar-Remote-importarUsuarios-action"
                        readonlyIf="!importarUsuarios" colSpan="6" />
            </panel>-->
        </panel>
    </form>

    <action-method name="subsysCommon.Usuario@Importar-Remote-importarUsuarios-action">
        <call class="com.educaflow.subsystem.common.importar.UserImporter" method="importarUsuarios"/>
    </action-method>

    <action-view name="subsysCommon.Usuario@Importar-action" title="Importar usuarios" model="com.axelor.auth.db.User">
        <view type="form" name="subsysCommon.Usuario@Importar-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="_id" value="null"/>
    </action-view>

    <form name="subsysCommon.Usuario@Importar-form" title="Importar usuarios" model="com.axelor.auth.db.User"
          groups="admins" canAttach="false" canBack="true" canBackOnSave="false" canDelete="false" canNew="false" canSave="false">
        <panel name="importar" title="Importar usuarios">
            <field name="importarUsuarios" widget="binary-link" title="Fichero usuarios" colSpan="6"/>
            <button name="btnImportar" title="Importar"
                    onClick="subsysCommon.Usuario@Importar-Remote-importarUsuarios-action"
                    readonlyIf="!importarUsuarios" colSpan="6" />
        </panel>
    </form>

</object-views>
