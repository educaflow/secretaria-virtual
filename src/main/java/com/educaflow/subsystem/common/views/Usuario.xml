<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysCommon.Usuario@Main-action" title="Usuarios" model="com.axelor.auth.db.User">
        <view type="grid" name="subsysCommon.Usuario@Main-grid"/>
        <view type="form" name="subsysCommon.Usuario@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>


    <grid name="subsysCommon.Usuario@Main-grid" title="" model="com.axelor.auth.db.User"
          groups="admins"
          allowSearchFields="true" orderBy="code"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
          canAdvanceSearch="false" canRefresh="false">
        <field name="code" width="200px"/>
        <field name="dni"/>
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="email"/>
        <field name="language"/>
        <field name="active"/>
    </grid>


    <form name="subsysCommon.Usuario@Main-form" title="Usuario" model="com.axelor.auth.db.User"
          width="large"
          canAttach="false" canBack="false" canBackOnSave="true" canDelete="false" canNew="false" canMore="false">
        <panel name="usuario" title="">
            <field name="code"         colSpan="6" required="true"/>
            <field name="dni"          colSpan="6" required="true"/>
            <field name="language"     colSpan="6"/>
            <field name="centroActivo" colSpan="6"
                   grid-view="subsysCommon.Centro@Search-grid"
                   form-view="subsysCommon.Centro@View-form"/>
            <field name="nombre"       colSpan="6" required="true"/>
            <field name="apellidos"    colSpan="6" required="true"/>
            <field name="name"         colSpan="6" readonly="true"/>
            <field name="email"        colSpan="6"/>
        </panel>
        <panel name="botones" showFrame="false">
            <button name="btnBorrar"   title="Borrar"   onClick="subsysCommon.Usuario@Main-btnBorrar-action"   css="btn-danger" outline="true" showIf="(id != null) || (cid != null)" colSpan="2"/>
            <spacer colSpan="6"/>
            <button name="btnCancelar" title="Cancelar" onClick="subsysCommon.Usuario@Main-btnCancelar-action" outline="true"   colSpan="2"/>
            <button name="btnGuardar"  title="Guardar"  onClick="subsysCommon.Usuario@Main-btnGuardar-action"                   colSpan="2"/>
        </panel>
    </form>

    <grid name="subsysCommon.Usuario@Search-grid" title="Usuario" model="com.axelor.auth.db.User"
          groups="admins"
          orderBy="apellidos"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="email"/>
    </grid>

    <form name="subsysCommon.Usuario@View-form" title="Usuario" model="com.axelor.auth.db.User"
          width="large"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="usuario" title="">
            <field name="nombre"    colSpan="6" readonly="true"/>
            <field name="apellidos" colSpan="6" readonly="true"/>
            <field name="email"     colSpan="6" readonly="true"/>
        </panel>
    </form>

    <!-- ***** Acciones de las tareas principales ***** -->

    <action-group name="subsysCommon.Usuario@Main-btnBorrar-action">
        <action name="delete"/>
    </action-group>

    <action-group name="subsysCommon.Usuario@Main-btnCancelar-action">
        <action name="back"/>
    </action-group>

    <action-group name="subsysCommon.Usuario@Main-btnGuardar-action">
        <action name="save"/>
    </action-group>

    <!-- ***** Acciones de Validaciones en local ***** -->

    <!-- ***** Acciones básicas que cambian campos simples ***** -->

    <!-- ***** Acciones de llamadas Remotas al servidor ***** -->

</object-views>