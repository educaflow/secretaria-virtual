<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <grid name="subsysCommon.Ref@Usuario-grid" title="" model="com.axelor.auth.db.User"
          groups="admins"
          orderBy="apellidos"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="email"/>
    </grid>

    <form name="subsysCommon.Ref@Usuario-form" title="Usuario" model="com.axelor.auth.db.User"
          width="large"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="usuario" title="">
            <field name="nombre"    colSpan="6" readonly="true"/>
            <field name="apellidos" colSpan="6" readonly="true"/>
            <field name="email"     colSpan="6" readonly="true"/>
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Salir" onClick="subsysCommon.Ref@Usuario-btnCancel-action"
                    colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <?sv-primary-actions?>

    <action-group name="subsysCommon.Ref@Usuario-btnCancel-action">
        <action name="close"/>
    </action-group>

    <?sv-validations?>
    <?sv-rules?>
    <?sv-remotes?>

</object-views>
