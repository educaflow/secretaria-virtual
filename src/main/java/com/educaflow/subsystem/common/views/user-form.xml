<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <form name="user-form" id="secretariavirtual-user-form" model="com.axelor.auth.db.User" extension="true" title="Usuario">

        <extend target="//field[@name='theme']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='homeAction']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='singleTab']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//field[@name='noHelp']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//field[@name='forcePasswordChange']">
            <attribute name="readonly" value="true"/>
            <attribute name="default" value="true"/>
        </extend>

        <extend target="//panel-dashlet[@name='activeUserTokensPanel']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//panel-related[@field='roles']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//panel-related[@field='permissions']">
            <attribute name="showIf" value="1=0"/>
        </extend>
        <extend target="//panel-related[@field='metaPermissions']">
            <attribute name="showIf" value="1=0"/>
        </extend>

        <extend target="//field[@name='group']">
            <insert position="after">
                <field name="dni" title="DNI / NIE" />
                <field name="centroActivo" title="Centro Principal" required="true" />
            </insert>
        </extend>

    </form>
</object-views>