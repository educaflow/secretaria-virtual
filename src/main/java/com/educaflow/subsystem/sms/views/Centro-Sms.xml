<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>

    <!-- SMS de los centros en los que el usuario es SUPERVISOR o ADMINISTRATIVO, en solo lectura y con
         reenvío de los fallidos.
         El <domain> va ANTES del <context> porque lo exige el XSD. -->
    <action-view name="subsysSms.Centro@Sms-action" title="SMS de mis centros" model="com.educaflow.subsystem.sms.db.Sms">
        <view type="grid" name="subsysSms.Centro@Sms-grid"/>
        <view type="form" name="subsysSms.Centro@Sms-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.centro.id IN (SELECT cu.centro.id FROM CentroUsuario cu JOIN cu.centroUsuarioTipoUsuario cut WHERE cu.usuario.id = :usuarioId AND cut.tipoUsuario.codigo IN ('SUPERVISOR','ADMINISTRATIVO'))</domain>
        <context name="usuarioId" expr="eval: __user__?.id"/>
    </action-view>

    <grid name="subsysSms.Centro@Sms-grid" title="" model="com.educaflow.subsystem.sms.db.Sms"
          canNew="false" allowSearchFields="true" orderBy="-fechaCreacion"
          canAdvanceSearch="false" canRefresh="false" editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="centro" width="180px"/>
        <field name="estado" width="120px"/>
        <field name="dniDestinatario" width="140px"/>
        <field name="nombre" width="150px"/>
        <field name="apellidos" width="180px"/>
        <field name="telefono" width="140px"/>
        <field name="mensaje"/>
        <field name="nombreExpediente" width="180px"/>
        <field name="fechaCreacion" width="160px"/>
        <field name="fechaEnvio" width="160px"/>
    </grid>

    <form name="subsysSms.Centro@Sms-form" title="SMS__!!" model="com.educaflow.subsystem.sms.db.Sms"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">

        <panel name="Sms" title="Datos del SMS" readonly="true">
            <field name="centro" colSpan="6" grid-view="subsysCommon.Ref@Centro-grid" form-view="subsysCommon.Ref@Centro-form"/>
            <field name="dniDestinatario" colSpan="3" colOffset="6"/>
            <field name="nombre" colSpan="4"/>
            <field name="apellidos" colSpan="5"/>
            <field name="telefono" colSpan="4" widget="phone" x-only-countries="ES"/>
            <field name="historialEstado" colSpan="8"/>
            <field name="mensaje" colSpan="12" widget="Text"/>
        </panel>

        <panel name="Envio" title="Datos del envío" colSpan="12" readonly="true">
            <field name="estado" widget="RadioSelect" x-direction="horizontal" colSpan="3"/>
            <field name="numeroReintentos" colSpan="3"/>
            <field name="fechaCreacion" colSpan="3" colOffset="6"/>
            <field name="fechaPrimerIntentoEnvio" colSpan="3"/>
            <field name="fechaUltimoIntentoEnvio" colSpan="3"/>
            <field name="fechaEnvio" colSpan="3" showIf="estado == 'ENVIADO'"/>
            <field name="descripcionUltimoFallo" colSpan="12" widget="Text" showIf="estado == 'FALLIDO'"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnReenviar" title="Reenviar" onClick="subsysSms.Centro@Sms-btnReenviar-action"
                    colSpan="2" showIf="estado == 'FALLIDO'"/>
            <button name="btnCancel" title="Salir" onClick="subsysSms.Centro@Sms-btnCancel-action"
                    colSpan="2" colOffset="8" outline="true"/>
        </panel>

    </form>

    <?sv-primary-actions?>

    <!-- Reenviar el SMS fallido seleccionado, reutilizando las acciones remotas de Main-Sms.xml. -->
    <action-group name="subsysSms.Centro@Sms-btnReenviar-action">
        <action name="subsysSms.Main@Sms-Remote-validateReenviar-action"/>
        <action name="subsysSms.Main@Sms-Remote-reenviar-action"/>
    </action-group>

    <!-- Salir del formulario. -->
    <action-group name="subsysSms.Centro@Sms-btnCancel-action">
        <action name="back"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
