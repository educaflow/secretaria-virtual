<?xml version="1.0"?>
<auth>

  <permission name="Sms.propio-destinatario"
              object="com.educaflow.subsystem.sms.db.Sms"
              condition="self.dniDestinatario = ? and self.estado = 'ENVIADO'"
              conditionParams="__user__.dni"
  >
    <can create="false" read="true" write="false" remove="false" export="false"/>
  </permission>

  <permission name="Sms.propio-centro-gestion"
              object="com.educaflow.subsystem.sms.db.Sms"
              condition="self.centro IN (SELECT cu.centro FROM com.educaflow.subsystem.common.db.CentroUsuario cu JOIN cu.centroUsuarioTipoUsuario cut JOIN cut.tipoUsuario tu WHERE cu.usuario = ? AND tu.codigo IN ('SUPERVISOR', 'ADMINISTRATIVO'))"
              conditionParams="__user__"
  >
    <can create="false" read="true" write="false" remove="false" export="false"/>
  </permission>

  <group code="users">
    <permission name="Sms.propio-destinatario"/>
    <permission name="Sms.propio-centro-gestion"/>
  </group>

</auth>
