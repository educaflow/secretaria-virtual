<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_8.0.xsd">


    <form name="sysImportar.Importar-form" title="Importar datos" model="com.educaflow.subsystem.importer.db.ViewDataImport"
          groups="admins" canAttach="false" canBack="true" canBackOnSave="false" canDelete="false" canNew="false" canSave="false"
    >
        <panel name="importar" title="Importar" height="100%">
            <field name="dataFile" x-dirty="false" widget="binary-link" title="Fichero de datos" colSpan="6"/>
            <button name="btnImportar" title="Importar"
                    onClick="sysImportar.Importar-form-button-importar-action"
                    readonlyIf="!dataFile" colSpan="6" />
            <field name="importLog" x-dirty="false" widget="text"  title="Logs__!! de importación" colSpan="12" readonly="true" height="20" width="100%"/>
        </panel>
    </form>

    <action-method name="sysImportar.Importar-form-button-importar-action">
        <call class="com.educaflow.subsystem.importer.controllers.ImporterController" method="procesarFichero"/>
    </action-method>

</object-views>