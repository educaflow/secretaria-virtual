<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="security" package="com.educaflow.subsystem.security.db"/>

    <entity name="AceProfileTipoTramite" repository="abstract">
        <enum name="perfil"                ref="com.educaflow.subsystem.expedientes.db.Profile"        required="true" title="Perfil"/>
        <many-to-one name="tipoUsuario"    ref="com.educaflow.subsystem.common.db.TipoUsuario"         title="Tipo usuario"/>
        <many-to-one name="cargo"          ref="com.educaflow.subsystem.common.db.Cargo"               title="Cargo"/>
        <many-to-one name="tipoTramite"    ref="com.educaflow.subsystem.expedientes.db.TipoTramite"    required="true" title="Tipo de trámite"/>
    </entity>

</domain-models>
