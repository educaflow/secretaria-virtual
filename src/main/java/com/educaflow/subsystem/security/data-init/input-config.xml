<?xml version="1.0"?>
<!-- priority 8: los Ace referencian los TipoUsuario y los Cargo que carga el data-init de common (priority 10)
     y los TipoTramite que carga el de expedientes (priority 9), así que tiene que cargarse después. -->
<xml-inputs priority="8" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">

    <!-- Permisos del subsistema security -->
    <input file="auth-security.xml" root="auth">
        <bind node="permission" type="com.axelor.auth.db.Permission" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@object" to="object"/>
            <bind node="@condition" to="condition"/>
            <bind node="@conditionParams" to="conditionParams"/>
            <bind node="can/@create" to="canCreate"/>
            <bind node="can/@read" to="canRead"/>
            <bind node="can/@write" to="canWrite"/>
            <bind node="can/@remove" to="canRemove"/>
            <bind node="can/@export" to="canExport"/>
        </bind>

        <bind node="group" type="com.axelor.auth.db.Group" search="self.code = :code" create="false" update="true">
            <bind node="@code" to="code"/>
            <bind node="permission" to="permissions" search="self.name = :name">
                <bind node="@name" to="name"/>
            </bind>
        </bind>
    </input>

    <!-- AceProfileGlobal: perfiles en todos los trámites de todos los centros -->
    <input file="AceProfileGlobal.xml" root="datos">
        <bind node="aces/ace[@tipoUsuario]" type="com.educaflow.subsystem.security.db.AceProfileGlobal"
              search="self.perfil = :perfil AND self.tipoUsuario.codigo = :tipoUsuario"
              create="true" update="true">
            <bind node="@perfil"      to="perfil"/>
            <bind node="@tipoUsuario" to="tipoUsuario" search="self.codigo = :tipoUsuario" create="false" update="false"/>
        </bind>
    </input>

    <input file="AceProfileGlobal.xml" root="datos">
        <bind node="aces/ace[@cargo]" type="com.educaflow.subsystem.security.db.AceProfileGlobal"
              search="self.perfil = :perfil AND self.cargo.code = :cargo"
              create="true" update="true">
            <bind node="@perfil"      to="perfil"/>
            <bind node="@cargo"       to="cargo"       search="self.code = :cargo"          create="false" update="false"/>
        </bind>
    </input>

    <!-- AceProfileTipoTramite: perfiles en los trámites de un tipo de trámite de todos los centros -->
    <input file="AceProfileTipoTramite.xml" root="datos">
        <bind node="aces/ace[@tipoUsuario]" type="com.educaflow.subsystem.security.db.AceProfileTipoTramite"
              search="self.perfil = :perfil AND self.tipoUsuario.codigo = :tipoUsuario AND self.tipoTramite.code = :tipoTramite"
              create="true" update="true">
            <bind node="@perfil"      to="perfil"/>
            <bind node="@tipoUsuario" to="tipoUsuario" search="self.codigo = :tipoUsuario" create="false" update="false"/>
            <bind node="@tipoTramite" to="tipoTramite" search="self.code = :tipoTramite"    create="false" update="false"/>
        </bind>
    </input>

    <input file="AceProfileTipoTramite.xml" root="datos">
        <bind node="aces/ace[@cargo]" type="com.educaflow.subsystem.security.db.AceProfileTipoTramite"
              search="self.perfil = :perfil AND self.cargo.code = :cargo AND self.tipoTramite.code = :tipoTramite"
              create="true" update="true">
            <bind node="@perfil"      to="perfil"/>
            <bind node="@cargo"       to="cargo"       search="self.code = :cargo"          create="false" update="false"/>
            <bind node="@tipoTramite" to="tipoTramite" search="self.code = :tipoTramite"    create="false" update="false"/>
        </bind>
    </input>

</xml-inputs>
