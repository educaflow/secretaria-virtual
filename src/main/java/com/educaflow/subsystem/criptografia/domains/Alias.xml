<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="criptografia" package="com.educaflow.subsystem.criptografia.db"/>

    <entity name="Alias">
        <string name="name" required="true" title="Nombre" max="255"/>
        <many-to-one name="dispositivoCriptografico" ref="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico" required="true" title="Dispositivo criptográfico"/>
        <string name="info" title="Información del alias" large="true">
            <![CDATA[
                return com.educaflow.subsystem.criptografia.util.AliasInfoBuilder.buildAliasInfo(getDispositivoCriptografico().getPkcs11LibraryPath(), getDispositivoCriptografico().getSlot(), getDispositivoCriptografico().getPin(), getName());
            ]]>
        </string>
    </entity>

</domain-models>