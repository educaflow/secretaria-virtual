<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="criptografia" package="com.educaflow.subsystem.criptografia.db"/>

    <entity name="DispositivoCriptografico" repository="abstract">
        <string name="name" required="true" title="Nombre" namecolumn="true"/>
        <string name="pkcs11LibraryPath" required="true" title="Ruta librería PKCS#11" default="/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so"/>
        <integer name="slot" required="true" title="Slot__!!" default="0" min="0"  help="Es el número donde está pinchado el dispositivo. Empiezan por cero y son valores consecutivos." />
        <!-- encrypted="true":
             - el cifrado en reposo solo se activa al definir encryption.password en la config privada; hasta entonces
               el valor se guarda en claro;
             - las filas existentes se cifran con la migración `database encrypt` de AOP;
             - el valor se descifra al cargar, así que POST /ws/rest/<FQN>/search con fields lo sigue devolviendo, y eso
               forma parte del PENDIENTE del endpoint REST de CLAUDE.md, sin resolver;
             - no se ha puesto password="true" porque no tapa search y rompe el form (el pin es required y llegaría
               vacío al reabrirlo). -->
        <string name="pin" required="true" title="PIN" encrypted="true"/>
        <one-to-many name="alias" ref="com.educaflow.subsystem.criptografia.db.Alias" mappedBy="dispositivoCriptografico" title="Alias"/>
        <string name="info" title="Información del dispositivo" large="true">
            <![CDATA[
                return com.educaflow.subsystem.criptografia.util.DispositivoCriptograficoInfoBuilder.build(getPkcs11LibraryPath(), getSlot(), getPin());
            ]]>
        </string>
    </entity>

</domain-models>
