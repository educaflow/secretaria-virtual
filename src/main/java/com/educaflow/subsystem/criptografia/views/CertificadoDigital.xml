<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- ***************************************************************************************** -->
    <!-- ****************************** CertificadoDigital : Vistas ****************************** -->
    <!-- ***************************************************************************************** -->

    <action-view name="subsysCriptografia.CertificadoDigital@Main-action" title="Certificados digitales" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital">
        <view type="grid" name="subsysCriptografia.CertificadoDigital@Main-grid"/>
        <view type="form" name="subsysCriptografia.CertificadoDigital@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysCriptografia.CertificadoDigital@Main-grid" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital"
          title="" orderBy="dni" newButtonTitle="Añadir certificado digital" allowSearchFields="true"
          canAdvanceSearch="false" canRefresh="false" canNew="true"
          editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
    >
        <field name="dni" width="200px"/>
        <field name="tipoCertificado"/>
    </grid>

    <form name="subsysCriptografia.CertificadoDigital@Main-form" title="Certificado digital" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel name="CertificadoDigital" title="Certificado digital">
            <field name="dni" colSpan="2"/>
            <field name="tipoCertificado" colSpan="6"/>

            <panel name="panelFicheroBD" colSpan="12" showIf="tipoCertificado == 'FICHERO_BD'" showFrame="false">
                <field name="password" colSpan="2"/>
                <field name="fichero" colSpan="10" widget="binary-link"/>
            </panel>
            <panel name="panelPkcs11" colSpan="12" showIf="tipoCertificado == 'DISPOSITIVO_PKCS11'" showFrame="false">
                <field name="dispositivoCriptografico" colSpan="4"
                       grid-view="subsysCriptografia.DispositivoCriptografico@Search-grid"
                       form-view="subsysCriptografia.DispositivoCriptografico@View-form"
                       onChange="subsysCriptografia.CertificadoDigital@Main-onChange-dispositivoCriptografico-action"/>
                <field name="alias" colSpan="8"
                       domain="self.dispositivoCriptografico = :dispositivoCriptografico"
                       grid-view="subsysCriptografia.Alias@Search-grid"
                       form-view="subsysCriptografia.Alias@View-form"/>
            </panel>
            <panel name="panelClasspath" colSpan="12" showIf="tipoCertificado == 'CLASSPATH'" showFrame="false">
                <field name="password" colSpan="2"/>
                <field name="rutaClasspath" colSpan="10"/>
            </panel>
            <panel name="panelSistemaArchivos" colSpan="12" showIf="tipoCertificado == 'SISTEMA_ARCHIVOS'" showFrame="false">
                <field name="password" colSpan="2"/>
                <field name="rutaSistemaArchivos" colSpan="10"/>
            </panel>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar" onClick="subsysCriptografia.CertificadoDigital@Main-btnDelete-action" css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysCriptografia.CertificadoDigital@Main-btnCancel-action" colSpan="2" colOffset="6" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="subsysCriptografia.CertificadoDigital@Main-btnSave-action" colSpan="2"/>
        </panel>
    </form>

    <!-- *************** CertificadoDigital : Acciones de las tareas principales *************** -->
    <action-group name="subsysCriptografia.CertificadoDigital@Main-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="subsysCriptografia.CertificadoDigital@Main-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="subsysCriptografia.CertificadoDigital@Main-btnSave-action">
        <action name="subsysCriptografia.CertificadoDigital@Main-Remote-validateSave-action"/>
        <action name="save"/>
        <action name="back"/>
    </action-group>

    <!-- *************** CertificadoDigital : Acciones de Validaciones en local *************** -->

    <!-- *************** CertificadoDigital : Acciones básicas que cambian campos simples *************** -->
    <action-record name="subsysCriptografia.CertificadoDigital@Main-onChange-dispositivoCriptografico-action" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital">
        <field name="alias" expr="eval: null"/>
    </action-record>

    <!-- *************** CertificadoDigital : Acciones de llamadas Remotas al servidor *************** -->
    <action-method name="subsysCriptografia.CertificadoDigital@Main-Remote-validateSave-action" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital">
        <call class="com.educaflow.subsystem.criptografia.controller.CertificadoDigitalController" method="validateSave"/>
    </action-method>

</object-views>
