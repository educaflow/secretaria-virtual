<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************************************** -->
    <!-- ****************************** DispositivoCriptografico : Vistas ****************************** -->
    <!-- *********************************************************************************************** -->

    <action-view name="subsysCriptografia.DispositivoCriptografico@Main-action" title="Dispositivos criptográficos" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico">
        <view type="grid" name="subsysCriptografia.DispositivoCriptografico@Main-grid"/>
        <view type="form" name="subsysCriptografia.DispositivoCriptografico@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysCriptografia.DispositivoCriptografico@Main-grid" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico"
          title="" orderBy="name" newButtonTitle="Añadir dispositivo criptográfico" allowSearchFields="true"
          canAdvanceSearch="false" canRefresh="false" canNew="true"
          editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
    >
        <help>Permite añadir a la aplicación un dispositivo criptográfico que se conecta por un USB</help>
        <toolbar>
            <button name="btnRecargarDispositivos" icon="arrow-clockwise" title="Recargar dispositivos"
                    onClick="subsysCriptografia.DispositivoCriptografico@Main-btnRecargarDispositivos-action"
                    help="Vuelve a conectar desde cero con todos los dispositivos criptográficos por si han dejado de responder"/>
        </toolbar>
        <field name="name"/>
        <field name="pkcs11LibraryPath"/>
        <field name="slot" width="100px"/>
    </grid>

    <form name="subsysCriptografia.DispositivoCriptografico@Main-form" title="Dispositivo criptográfico" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="false">
        <panel name="DispositivoCriptografico" title="Dispositivo criptográfico">
            <field name="name" colSpan="6"/>
            <field name="pkcs11LibraryPath" colSpan="12"/>
            <field name="slot" colSpan="2"/>
            <field name="pin" colSpan="3" widget="password"/>
        </panel>
        <panel name="Información" title="Información del dispositivo" colSpan="12" showFrame="true" showIf="(id != null) || (cid != null)">
            <field name="info" colSpan="12" widget="Text" height="12" title="" />
        </panel>

        <panel-related name="alias" title="Alias" field="alias" colSpan="12" readonly="true" showIf="(id != null) || (cid != null)"
            grid-view="subsysCriptografia.Alias@Search-grid"
            form-view="subsysCriptografia.Alias@View-form"
        />

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar" onClick="subsysCriptografia.DispositivoCriptografico@Main-btnDelete-action"
                    css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysCriptografia.DispositivoCriptografico@Main-btnCancel-action"
                    colSpan="2" colOffset="6" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="subsysCriptografia.DispositivoCriptografico@Main-btnSave-action"
                    colSpan="2"/>
        </panel>
    </form>

    <!-- *************** DispositivoCriptografico : Acciones de las tareas principales *************** -->
    <action-group name="subsysCriptografia.DispositivoCriptografico@Main-btnRecargarDispositivos-action">
        <action name="subsysCriptografia.DispositivoCriptografico@Main-Remote-recargarDispositivosEnEntornoCriptografico-action"/>
    </action-group>
    <action-group name="subsysCriptografia.DispositivoCriptografico@Main-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="subsysCriptografia.DispositivoCriptografico@Main-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="subsysCriptografia.DispositivoCriptografico@Main-btnSave-action">
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="back"/>
    </action-group>

    <!-- *************** DispositivoCriptografico : Acciones de Validaciones en local *************** -->

    <!-- *************** DispositivoCriptografico : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** DispositivoCriptografico : Acciones de llamadas Remotas al servidor *************** -->
    <action-method name="subsysCriptografia.DispositivoCriptografico@Main-Remote-recargarDispositivosEnEntornoCriptografico-action" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico">
        <call class="com.educaflow.subsystem.criptografia.controller.DispositivoCriptograficoController" method="recargarDispositivosEnEntornoCriptografico"/>
    </action-method>

</object-views>
