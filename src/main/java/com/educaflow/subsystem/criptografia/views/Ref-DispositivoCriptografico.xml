<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <grid name="subsysCriptografia.Ref@DispositivoCriptografico-grid" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico"
          title="" orderBy="name"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true"
    >
        <field name="name"/>
        <field name="pkcs11LibraryPath"/>
        <field name="slot" width="100px"/>
    </grid>

    <form name="subsysCriptografia.Ref@DispositivoCriptografico-form" title="Dispositivo criptográfico" model="com.educaflow.subsystem.criptografia.db.DispositivoCriptografico"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="DispositivoCriptografico" title="">
            <field name="name" colSpan="6" readonly="true"/>
            <field name="pkcs11LibraryPath" colSpan="6" readonly="true"/>
            <field name="slot" colSpan="2" readonly="true"/>
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Salir" onClick="subsysCriptografia.Ref@DispositivoCriptografico-btnCancel-action"
                    colSpan="2" colOffset="8" outline="true"/>
        </panel>
    </form>

    <?sv-primary-actions?>

    <action-group name="subsysCriptografia.Ref@DispositivoCriptografico-btnCancel-action">
        <action name="close"/>
    </action-group>

    <?sv-validations?>
    <?sv-rules?>
    <?sv-remotes?>

</object-views>