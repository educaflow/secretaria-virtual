<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>

    <action-view name="subsysCriptografia.Main@CertificadoDigital-action" title="Certificados digitales" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital">
        <view type="grid" name="subsysCriptografia.Main@CertificadoDigital-grid"/>
        <view type="form" name="subsysCriptografia.Main@CertificadoDigital-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <grid name="subsysCriptografia.Main@CertificadoDigital-grid" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital"
          title="" orderBy="dni" newButtonTitle="Añadir certificado digital" allowSearchFields="true"
          canAdvanceSearch="false" canRefresh="false" canNew="true"
          editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
    >
        <field name="dni" width="200px"/>
        <field name="tipoCertificado"/>
    </grid>

    <form name="subsysCriptografia.Main@CertificadoDigital-form" title="Certificado digital" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel name="CertificadoDigital" title="Certificado digital">
            <field name="dni" colSpan="2"/>
            <field name="tipoCertificado" colSpan="6"/>

            <panel name="panelFicheroBD" colSpan="12" showIf="tipoCertificado == 'FICHERO_BD'" showFrame="false">
                <field name="password" colSpan="4"/>
                <field name="fichero" colSpan="4" widget="binary-link"/>
            </panel>
            <panel name="panelPkcs11" colSpan="12" showIf="tipoCertificado == 'DISPOSITIVO_PKCS11'" showFrame="false">
                <field name="dispositivoCriptografico" colSpan="4"
                       grid-view="subsysCriptografia.Ref@DispositivoCriptografico-grid"
                       form-view="subsysCriptografia.Ref@DispositivoCriptografico-form"
                       onChange="subsysCriptografia.Main@CertificadoDigital-onChange-dispositivoCriptografico-action"/>
                <field name="alias" colSpan="8"
                       domain="self.dispositivoCriptografico = :dispositivoCriptografico"
                       grid-view="subsysCriptografia.Ref@Alias-grid"
                       form-view="subsysCriptografia.Ref@Alias-form"/>
            </panel>
            <panel name="panelClasspath" colSpan="12" showIf="tipoCertificado == 'CLASSPATH'" showFrame="false">
                <field name="password" colSpan="4"/>
                <field name="rutaClasspath" colSpan="8"/>
            </panel>
            <panel name="panelSistemaArchivos" colSpan="12" showIf="tipoCertificado == 'SISTEMA_ARCHIVOS'" showFrame="false">
                <field name="password" colSpan="4"/>
                <field name="rutaSistemaArchivos" colSpan="8"/>
            </panel>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar" onClick="subsysCriptografia.Main@CertificadoDigital-btnDelete-action" css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar" onClick="subsysCriptografia.Main@CertificadoDigital-btnCancel-action" colSpan="2" colOffset="6" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="subsysCriptografia.Main@CertificadoDigital-btnSave-action" colSpan="2"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="subsysCriptografia.Main@CertificadoDigital-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="subsysCriptografia.Main@CertificadoDigital-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="subsysCriptografia.Main@CertificadoDigital-btnSave-action">
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="back"/>
    </action-group>
    <action-group name="subsysCriptografia.Main@CertificadoDigital-onChange-dispositivoCriptografico-action">
        <action name="subsysCriptografia.Main@CertificadoDigital-set-alias-null-action"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>
    <action-record name="subsysCriptografia.Main@CertificadoDigital-set-alias-null-action" model="com.educaflow.subsystem.criptografia.db.CertificadoDigital">
        <field name="alias" expr="eval: null"/>
    </action-record>

    <?sv-remotes?>

</object-views>
