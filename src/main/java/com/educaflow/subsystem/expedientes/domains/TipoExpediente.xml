<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="expedientes" package="com.educaflow.subsystem.expedientes.db"/>
    <entity name="TipoExpediente">
        <string name="code"  />
        <string name="name" namecolumn="true" translatable="true" />
        <!--<enum name="ambitoCreador" ref="AmbitoTipoExpediente" title="Ámbito creador" />
        <enum name="ambitoResponsable" ref="AmbitoTipoExpediente" title="Ámbito responsable"  />
        <enum name="ambitoAuditor" ref="AmbitoTipoExpediente" title="Ámbito auditor"  />-->
        <!--
            El paquete de la carpeta de versión del tipo de expediente. De él cuelga un paquete por
            fase, así que ExpedienteLocator compone el FQCN del PhaseEventManager y del
            StateEventValidator con el codePhase del expediente; y de él cuelga también la clase
            States que el build genera. Lo reescribe el data-init en cada arranque, de modo que
            mover la carpeta del tipo se corrige solo.
        -->
        <string name="basePackageName"  title="Paquete base de las clases del tipo de expediente" />
        <many-to-one name="tramite" ref="Tramite" />


        <extra-code-model><![CDATA[

            public com.educaflow.subsystem.expedientes.tramitacion.eventmanager.TipoExpedienteStates getTipoExpedienteStates() {
                return com.axelor.inject.Beans.get(com.educaflow.subsystem.expedientes.tramitacion.internal.ExpedienteLocator.class).getTipoExpedienteStates(this);
            }

        ]]></extra-code-model>
    </entity>

    <!--<enum name="AmbitoTipoExpediente">
        <item name="CENTRO" title="Centro"/>
        <item name="DEPARTAMENTO" title="Departamento"/>
        <item name="CICLO" title="Ciclo"/>
        <item name="CURSO" title="Curso"/>
        <item name="GRUPO" title="Grupo" />
        <item name="MODULO" title="Módulo" />
        <item name="INDIVIDUAL" title="Individual" />
    </enum>-->

</domain-models>