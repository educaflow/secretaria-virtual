<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.2.xsd">


    <action-method name="subsysExpedientes-event-action">
        <call class="com.educaflow.subsystem.expedientes.controllers.ExpedienteController" method="triggerEvent"/>
    </action-method>
    <action-method name="subsysExpedientes-event-new-action">
        <call class="com.educaflow.subsystem.expedientes.controllers.ExpedienteController" method="triggerInitialEvent"/>
    </action-method>
    <action-method name="subsysExpedientes-event-view-action">
        <call class="com.educaflow.subsystem.expedientes.controllers.ExpedienteController" method="viewExpediente"/>
    </action-method>
    <action-method name="subsysExpedientes-validate-on-save-child-action">
        <call class="com.educaflow.subsystem.expedientes.controllers.ExpedienteController" method="validateChild"/>
    </action-method>
</object-views>