<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-group name="subsysExpedientes-btnAddNote-action">
        <action name="subsysExpedientes-Remote-validateAddNote-action"/>
        <action name="subsysExpedientes-Remote-addNote-action"/>
    </action-group>

    <action-method name="subsysExpedientes-Remote-validateAddNote-action">
        <call class="com.educaflow.subsystem.expedientes.controller.ExpedienteController" method="validateAddNote"/>
    </action-method>
    <action-method name="subsysExpedientes-Remote-addNote-action">
        <call class="com.educaflow.subsystem.expedientes.controller.ExpedienteController" method="addNote"/>
    </action-method>
</object-views>
