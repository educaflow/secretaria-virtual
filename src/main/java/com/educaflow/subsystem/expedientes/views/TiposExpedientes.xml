<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.2.xsd">





    <action-view name="subsysExpedientes.TipoExpediente@Main-action" title="tipos de expedientes" model="com.educaflow.subsystem.expedientes.db.TipoExpediente">
        <view type="grid" name="subsysExpedientes.TipoExpediente@Main-grid"/>
        <view type="form" name="subsysExpedientes.TipoExpediente@Main-form"/>
    </action-view>
    <grid name="subsysExpedientes.TipoExpediente@Main-grid" title="Listado tipos expediente" model="com.educaflow.subsystem.expedientes.db.TipoExpediente">
        <field name="code"  />
        <field name="name"  />
        <field name="fqcnEventManager" />
    </grid>
    <form name="subsysExpedientes.TipoExpediente@Main-form" title="Mantenimiento de Tipos Expedientes" model="com.educaflow.subsystem.expedientes.db.TipoExpediente" width="large">
        <panel title="Datos" >
            <field name="code"  />
            <field name="name"  />
            <field name="versionExpediente" />
            <field name="openDate" />
            <field name="closeDate" />
            <field name="fqcnEventManager" />
            <field name="tramite"
                   type="many-to-one"
                   target="com.educaflow.subsystem.expedientes.db.Tramite"
            />
        </panel>
    </form>

</object-views>