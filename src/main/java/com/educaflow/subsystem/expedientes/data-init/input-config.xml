<?xml version="1.0"?>
<!-- priority 9: TipoTramites.xml referencia los TipoUsuario y los Cargo que carga el data-init de common
     (priority 10), así que tiene que cargarse después; y antes que los Tramite (priority 1), que lo referencian. -->
<xml-inputs priority="9" xmlns="http://axelor.com/xml/ns/data-import"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://axelor.com/xml/ns/data-import
  https://axelor.com/xml/ns/data-import/data-import_8.0.xsd">




    <input file="TipoTramites.xml" root="datos">

        <bind node="tipostramites/tipotramite" type="com.educaflow.subsystem.expedientes.db.TipoTramite" search="self.code = :code" create="true" update="true">
            <bind node="@code" to="code" />
            <bind node="@name" to="name" />
            <bind node="@admiteRepresentacion" to="admiteRepresentacion" />
            <bind node="@admitePresentacionEnPapel" to="admitePresentacionEnPapel" />
            <!-- El binding de una colección AÑADE (Property.addAll), no reemplaza: quitar aquí un
                 interesado o un registrador no lo quita de la base de datos. -->
            <bind node="tipoUsuarioInteresado" to="tiposUsuarioInteresados" search="self.codigo = :codigo" create="false" update="false">
                <bind node="@codigo" to="codigo" />
            </bind>
            <bind node="cargoInteresado" to="cargosInteresados" search="self.code = :code" create="false" update="false">
                <bind node="@code" to="code" />
            </bind>
            <bind node="tipoUsuarioRegistrador" to="tiposUsuarioRegistradores" search="self.codigo = :codigo" create="false" update="false">
                <bind node="@codigo" to="codigo" />
            </bind>
            <bind node="cargoRegistrador" to="cargosRegistradores" search="self.code = :code" create="false" update="false">
                <bind node="@code" to="code" />
            </bind>
        </bind>


    </input>

    <!-- Permisos del subsistema expedientes -->
    <input file="auth-expedientes.xml" root="auth">
        <bind node="permission" type="com.axelor.auth.db.Permission" search="self.name = :name" create="true" update="true">
            <bind node="@name" to="name"/>
            <bind node="@object" to="object"/>
            <bind node="@condition" to="condition"/>
            <bind node="@conditionParams" to="conditionParams"/>
            <bind node="can/@create" to="canCreate"/>
            <bind node="can/@read" to="canRead"/>
            <bind node="can/@write" to="canWrite"/>
            <bind node="can/@remove" to="canRemove"/>
            <bind node="can/@export" to="canExport"/>
        </bind>
    </input>


</xml-inputs>