<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-method name="subsysTramitador-trigger-initial-event-action">
        <call class="com.educaflow.subsystem.tramitador.controller.TramitadorController" method="triggerInitialEvent"/>
    </action-method>
    <action-method name="subsysTramitador-event-action">
        <call class="com.educaflow.subsystem.tramitador.controller.TramitadorController" method="triggerEvent"/>
    </action-method>
    <action-method name="subsysTramitador-event-view-action">
        <call class="com.educaflow.subsystem.tramitador.controller.TramitadorController" method="viewExpediente"/>
    </action-method>
    <action-method name="subsysTramitador-validate-on-save-child-action">
        <call class="com.educaflow.subsystem.tramitador.controller.TramitadorController" method="validateChild"/>
    </action-method>
</object-views>