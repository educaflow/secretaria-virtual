<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- ******************************************************************************** -->
    <!-- ****************************** SmokeTest : Vistas ****************************** -->
    <!-- ******************************************************************************** -->

    <!-- action-view de entrada desde el menuitem «Smoke test» -->
    <action-view name="subsysSmokeTest.SmokeTest@Main-action" title="Smoke tests"
                 model="com.educaflow.subsystem.smoketest.db.SmokeTest">
        <view type="grid" name="subsysSmokeTest.SmokeTest@Main-grid"/>
        <view type="form" name="subsysSmokeTest.SmokeTest@Main-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
    </action-view>

    <!--
        Grid principal.
        - Columnas: texto, fechaCreacion, fechaUltimaModificacion (en ese orden, spec screen-smoke-test.md).
        - Ordenación por defecto: -fechaCreacion (los más recientes primero, spec).
        - allowSearchFields="true": búsqueda por texto (campo visible en la columna).
    -->
    <grid name="subsysSmokeTest.SmokeTest@Main-grid"
          model="com.educaflow.subsystem.smoketest.db.SmokeTest"
          title="" orderBy="-fechaCreacion"
          newButtonTitle="Añadir un nuevo smoke test"
          allowSearchFields="true" canAdvanceSearch="false" canRefresh="false"
          canNew="true" editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true"
    >
        <field name="texto"/>
        <field name="fechaCreacion"           width="200px"/>
        <field name="fechaUltimaModificacion" width="200px"/>
    </grid>

    <!--
        Formulario principal.
        - texto: editable (campo cliente).
        - fechaCreacion: readonly="true" — U-smoke-test-001 (Origen spec: RUI-001); disparador continuo.
        - fechaUltimaModificacion: readonly="true" — U-smoke-test-001 (Origen spec: RUI-001); disparador continuo.
        - Panel buttons-panel: btnDelete (danger, left), btnCancel (outline, right-1), btnSave (right).
        - Validación de servidor (V-SmokeTest-001) anclada al action-group del btnSave
          (antes de <action name="save"/>), no en onSave del form.
    -->
    <form name="subsysSmokeTest.SmokeTest@Main-form" title="Smoke test"
          model="com.educaflow.subsystem.smoketest.db.SmokeTest"
          width="large"
          canAttach="false" canBack="false" canDelete="false" canNew="false"
          canSave="false" canMore="false" canBackOnSave="true">

        <panel name="SmokeTest" title="Smoke test">
            <field name="texto" colSpan="12"/>
            <field name="fechaCreacion"           colSpan="6" readonly="true"/>
            <field name="fechaUltimaModificacion" colSpan="6" readonly="true"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar"
                    onClick="subsysSmokeTest.SmokeTest@Main-btnDelete-action"
                    css="btn-danger" colSpan="2" outline="true"
                    showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCancel" title="Cancelar"
                    onClick="subsysSmokeTest.SmokeTest@Main-btnCancel-action"
                    colSpan="2" colOffset="6" outline="true"/>
            <button name="btnSave" title="Guardar"
                    onClick="subsysSmokeTest.SmokeTest@Main-btnSave-action"
                    colSpan="2"/>
        </panel>
    </form>

    <!-- *************** SmokeTest : Acciones de las tareas principales *************** -->

    <!-- Borrar: acción predefinida delete del framework -->
    <action-group name="subsysSmokeTest.SmokeTest@Main-btnDelete-action">
        <action name="delete"/>
    </action-group>

    <!-- Cancelar: vuelve al listado -->
    <action-group name="subsysSmokeTest.SmokeTest@Main-btnCancel-action">
        <action name="back"/>
    </action-group>

    <!--
        Guardar: valida primero en cliente (V-SmokeTest-001 cliente vía action-validate)
        y luego persiste con save. La defensa en servidor está en validateInsert/validateUpdate.
    -->
    <action-group name="subsysSmokeTest.SmokeTest@Main-btnSave-action">
        <action name="subsysSmokeTest.SmokeTest@Main-btnSave-validate-action"/>
        <action name="save"/>
    </action-group>

    <!-- *************** SmokeTest : Acciones de Validaciones en local *************** -->

    <!--
        V-SmokeTest-001 (cliente) — Origen spec: RES-001.
        Comprueba que el campo texto no sea nulo ni vacío.
        Mensaje: «El texto es obligatorio» (exactamente el del spec ESC-005).
    -->
    <action-validate name="subsysSmokeTest.SmokeTest@Main-btnSave-validate-action">
        <error if="!texto" message="El texto es obligatorio"/>
    </action-validate>

    <!-- *************** SmokeTest : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** SmokeTest : Acciones de llamadas Remotas al servidor *************** -->

</object-views>
