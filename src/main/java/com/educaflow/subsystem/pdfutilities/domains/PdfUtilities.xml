<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">



    <module name="secretariavirtual" package="com.educaflow.subsystem.pdfutilities.db"/>

    <entity name="PdfUtilities" persistable="false"  >
        <many-to-one name="pdf" title="PDF a gestionar" ref="com.axelor.meta.db.MetaFile"  transient="true" />
        <many-to-one name="pdfFirmado" title="PDF a gestionar" ref="com.axelor.meta.db.MetaFile"  transient="true" />
        <string name="info"  large="true" title="información PDF" multiline="true" transient="true" default="Sin datos"  />
        <int name="x" title="Posición X"  transient="true"  />
        <int name="y" title="Posición Y"  transient="true" />
        <int name="width" title="Ancho"  transient="true"  />
        <int name="height" title="Alto"  transient="true"  />
    </entity>



</domain-models>