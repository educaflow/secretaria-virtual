<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">






    <action-view name="subsysPdfUtilities.Firma-action"  title="Información para PDF" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities"  >
        <view type="form" name="subsysPdfUtilities.Firma-form"/>
    </action-view>

    <form name="subsysPdfUtilities.Firma-form" title="Utilidades para PDF" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities" width="large" onNew="subsysPdfUtilities.Firma-form-onNew-action">

        <panel name="main" title="PDF">
            <field name="pdf"  colSpan="10" widget="binary-link" />
            <field name="numeroPagina" colSpan="2" />

            <button name="verPosicionesFirma" title="Ver posiciones de firma" icon="fa-plus" onClick="subsysPdfUtilities.Firma-form-button-verPosicionesFirma-action"/>
        </panel>
        <panel name="info-panel" title="Información del PDF">
            <field name="pdf-view" showTitle="false" readonly="true" colSpan="9">
                <viewer depends="pdfFirmado" ><![CDATA[
                    <>
                    <Box as="iframe" height="1000px" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${pdfFirmado.id}/content/download?inline=true&name=${pdfFirmado.fileName}`} ></Box>
                    </>
                    ]]></viewer>
            </field>
        </panel>
    </form>
    <action-record name="subsysPdfUtilities.Firma-form-onNew-action" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities">
        <field name="numeroPagina" expr="eval: 1" />
    </action-record>
    <action-method name="subsysPdfUtilities.Firma-form-button-verPosicionesFirma-action">
        <call class="com.educaflow.subsystem.pdfutilities.controller.PdfUtilitiesController" method="getPdfTodasPosicionesFirma"/>
    </action-method>







</object-views>
