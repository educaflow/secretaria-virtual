<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">




    <form name="subsysPdfUtilities.Info-form" title="Utilidades para PDF" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities" width="large">

        <panel name="main" title="PDF">
            <field name="pdf"  colSpan="12" onChange="subsysPdfUtilities.Info-form-onChange-pdf-action" widget="binary-link" />
        </panel>
        <panel name="info-panel" title="Información del PDF">
            <field name="info"  colSpan="12"  height="1000px"  widget="code-editor" readonly="true" />
        </panel>
    </form>
    <action-record name="subsysPdfUtilities.Info-form-onChange-pdf-action" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities">
        <field name="info" expr="action:subsysPdfUtilities.Info-form-getInfoPdf-action" />
    </action-record>
    <action-method name="subsysPdfUtilities.Info-form-getInfoPdf-action">
        <call class="com.educaflow.subsystem.pdfutilities.controller.PdfUtilitiesController" method="getInfo(pdf)"/>
    </action-method>






</object-views>
