<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <action-view name="subsysPdfUtilities.Info@PdfUtilities-action" title="Información para PDF" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities">
        <view type="form" name="subsysPdfUtilities.Info@PdfUtilities-form"/>
        <view-param name="show-toolbar-form" value="false"/>
    </action-view>

    <form name="subsysPdfUtilities.Info@PdfUtilities-form" title="Utilidades para PDF" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities" width="large">

        <panel name="main" title="PDF">
            <field name="pdf" colSpan="4" widget="binary-link"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnVerInfo" title="Ver información" icon="fa-info-circle" colSpan="4" colOffset="8" onClick="subsysPdfUtilities.Info@PdfUtilities-btnVerInfo-action"/>
        </panel>

        <panel name="info-panel" title="Información del PDF">
            <field name="info" colSpan="12" height="1000px" widget="code-editor" readonly="true"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="subsysPdfUtilities.Info@PdfUtilities-btnVerInfo-action">
        <action name="subsysPdfUtilities.Info@PdfUtilities-Local-getInfo-action"/>
        <action name="subsysPdfUtilities.Info@PdfUtilities-set-info-porPdf-action"/>
    </action-group>

    <?sv-validations?>
    <action-condition name="subsysPdfUtilities.Info@PdfUtilities-Local-getInfo-action">
        <check field="pdf"/>
    </action-condition>

    <?sv-rules?>
    <action-record name="subsysPdfUtilities.Info@PdfUtilities-set-info-porPdf-action" model="com.educaflow.subsystem.pdfutilities.db.PdfUtilities">
        <field name="info" expr="action:subsysPdfUtilities.Info@PdfUtilities-Remote-getInfo-action"/>
    </action-record>

    <?sv-remotes?>
    <action-method name="subsysPdfUtilities.Info@PdfUtilities-Remote-getInfo-action">
        <call class="com.educaflow.subsystem.pdfutilities.controller.PdfUtilitiesController" method="getInfo(pdf)"/>
    </action-method>

</object-views>
