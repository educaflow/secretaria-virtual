    <can create="false" read="true" write="false" remove="false" export="false"/>
  </permission>

  <permission name="Sms.propio-centro-gestion"
              object="com.educaflow.subsystem.notificaciones.db.Sms"
              condition="self.centro.id IN (?)"
              conditionParams="com.educaflow.subsystem.notificaciones.util.GestorNotificacionesUtil.idsCentrosGestionados(__user__)"
  >
    <can create="false" read="true" write="false" remove="false" export="false"/>
