<?xml version="1.0"?>
<auth>

  <permission name="Notificacion.propio-destinatario"
              object="com.educaflow.subsystem.notificaciones.db.Notificacion"
              condition="self.dniDestinatario = ? and self.estado = 'ENVIADO'"
              conditionParams="__user__.dni"
  >
    <can create="false" read="true" write="false" remove="false" export="false"/>
  </permission>

  <permission name="Correo.propio-destinatario"
              object="com.educaflow.subsystem.notificaciones.db.Correo"
              condition="self.dniDestinatario = ? and self.estado = 'ENVIADO'"
              conditionParams="__user__.dni"
  >
    <can create="false" read="true" write="false" remove="false" export="false"/>
  </permission>

  <permission name="Sms.propio-destinatario"
              object="com.educaflow.subsystem.notificaciones.db.Sms"
