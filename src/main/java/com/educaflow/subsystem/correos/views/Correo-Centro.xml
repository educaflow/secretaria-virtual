<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- ******************************************************************************* -->
    <!-- ****************************** Correo : Vistas (Correos de mi centro) ********* -->
    <!-- ******************************************************************************* -->

    <action-view name="subsysCorreos.Correo@Centro-action" title="Correos de mi centro" model="com.educaflow.subsystem.correos.db.Correo">
        <view type="grid" name="subsysCorreos.Correo@Centro-grid"/>
        <view type="form" name="subsysCorreos.Correo@Centro-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.centro = :centroActivoUsuario</domain>
        <context name="centroActivoUsuario" expr="eval: __user__?.centroActivo"/>
    </action-view>

    <grid name="subsysCorreos.Correo@Centro-grid" title="Correos de mi centro" model="com.educaflow.subsystem.correos.db.Correo"
          canNew="false" allowSearchFields="true" orderBy="-fechaCreacion"
          canAdvanceSearch="true" canRefresh="false" editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="estado" width="120px"/>
        <field name="dniDestinatario" width="120px" title="DNI"/>
        <field name="nombre" width="150px"/>
        <field name="apellidos" width="180px"/>
        <field name="asunto"/>
        <field name="para" width="200px"/>
        <field name="nombreExpediente" width="180px" title="Expediente"/>
        <field name="fechaCreacion" width="160px"/>
        <field name="fechaEnvio" width="160px"/>
    </grid>

    <form name="subsysCorreos.Correo@Centro-form" title="Correo" model="com.educaflow.subsystem.correos.db.Correo"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">

        <panel name="Correo" title="Datos del correo">
            <field name="dniDestinatario" colSpan="3" readonly="true"/>
            <field name="nombre" colSpan="4" readonly="true"/>
            <field name="apellidos" colSpan="5" readonly="true"/>
            <field name="para" colSpan="12" readonly="true"/>
            <field name="enCopia" colSpan="6" readonly="true"/>
            <field name="enCopiaOculta" colSpan="6" readonly="true"/>
            <field name="asunto" colSpan="9" readonly="true"/>
            <field name="centro" colSpan="3" readonly="true"/>
            <field name="cuerpo" colSpan="12" widget="Text" readonly="true"/>
            <field name="historialEstado" colSpan="6" readonly="true"/>
        </panel>

        <panel-related name="adjuntos" field="adjuntos" title="Adjuntos"
            grid-view="subsysCorreos.Adjunto@Search-grid" form-view="subsysCorreos.Adjunto@View-form"
            colSpan="12" newButtonTitle="" canNew="false" showFooter="false" canEdit="false" canRemove="false" forceEdit="true"/>

        <panel name="Envio" title="Datos del envío" colSpan="12">
            <field name="estado" colSpan="3" readonly="true"/>
            <field name="numeroReintentos" colSpan="3" title="Nº reintentos__!!" readonly="true"/>
            <field name="fechaCreacion" colSpan="3" readonly="true"/>
            <field name="fechaEnvio" colSpan="3" readonly="true" showIf="estado == 'SUCCESS'"/>
            <field name="fechaPrimerIntentoEnvio" colSpan="4" readonly="true"/>
            <field name="fechaUltimoIntentoEnvio" colSpan="4" readonly="true"/>
            <field name="descripcionUltimoFallo" colSpan="12" widget="Text" readonly="true" showIf="estado == 'FAIL'"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnReenviar" title="Reenviar" onClick="subsysCorreos.Correo@Centro-btnReenviar-action"
                    colSpan="2" showIf="estado == 'FAIL'"/>
            <button name="btnCancel" title="Salir" onClick="subsysCorreos.Correo@Centro-btnCancel-action"
                    colSpan="2" colOffset="8" outline="true"/>
        </panel>

    </form>

    <!-- *************** Correo (Centro) : Acciones de las tareas principales *************** -->

    <action-group name="subsysCorreos.Correo@Centro-btnCancel-action">
        <action name="back"/>
    </action-group>

    <action-group name="subsysCorreos.Correo@Centro-btnReenviar-action">
        <action name="subsysCorreos.Correo@Main-Remote-validateReenviar-action"/>
        <action name="subsysCorreos.Correo@Main-Remote-reenviar-action"/>
    </action-group>

    <!-- *************** Correo (Centro) : Acciones de Validaciones en local *************** -->

    <!-- *************** Correo (Centro) : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** Correo (Centro) : Acciones de llamadas Remotas al servidor *************** -->
    <!-- (reutiliza subsysCorreos.Correo@Main-Remote-validateReenviar-action y
         subsysCorreos.Correo@Main-Remote-reenviar-action, definidas en Correo.xml: es el mismo
         @CallMethod de CorreoController.reenviar, que siempre añade el aviso de RUI-correos-centro-formulario-004) -->

</object-views>
