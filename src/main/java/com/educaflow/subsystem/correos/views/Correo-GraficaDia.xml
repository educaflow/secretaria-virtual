<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *********************************************************************** -->
    <!-- *********************** Correo GraficaDia : Vistas ******************** -->
    <!-- *********************************************************************** -->

    <action-view name="subsysCorreos.Correo@GraficaDia-action" title="Gráfica de correos (diaria)">
        <view type="chart" name="subsysCorreos.Correo@GraficaDia-chart"/>
    </action-view>

    <chart name="subsysCorreos.Correo@GraficaDia-chart" title="Correos por estado (por día)" stacked="true">
        <search-fields>
            <field type="date" name="fechaInicial" title="Fecha inicial"/>
            <field type="date" name="fechaFinal"   title="Fecha final"/>
        </search-fields>
        <dataset type="sql">
            <![CDATA[
                SELECT
                    DATE_TRUNC('day', self.fecha_creacion) AS _intervalo,
                    self.estado                            AS _estado,
                    COUNT(*)                               AS _total
                FROM
                    correos_correo self
                WHERE
                    (:fechaInicial IS NULL OR self.fecha_creacion >= :fechaInicial)
                    AND (:fechaFinal IS NULL OR self.fecha_creacion <= :fechaFinal)
                GROUP BY
                    _intervalo, self.estado
                ORDER BY
                    _intervalo
            ]]>
        </dataset>
        <category key="_intervalo" type="date" title="Día"/>
        <series   key="_total"     type="bar"  title="Correos" groupBy="_estado"/>
    </chart>

</object-views>
