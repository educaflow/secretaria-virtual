<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-view name="subsysCorreos.TareaCorreo@Mis-action" title="Mis correos" model="com.educaflow.subsystem.correos.db.TareaCorreo">
        <view type="grid" name="subsysCorreos.TareaCorreo@Mis-grid"/>
        <view type="form" name="subsysCorreos.TareaCorreo@Mis-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="reload-grid" value="true"/>
        <!-- PUNTO A CONFIRMAR EN IMPLEMENTACIÓN: nombre exacto del campo del usuario que contiene su DNI.
             Ajustar el atributo según la API real del subsistema security. -->
        <domain>self.dniDestinatario = :dniUsuario</domain>
        <context name="dniUsuario" expr="eval:__user__?.dni"/>
    </action-view>

    <grid name="subsysCorreos.TareaCorreo@Mis-grid" title="Mis correos" model="com.educaflow.subsystem.correos.db.TareaCorreo"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          orderBy="-fechaCreacion" canEditOnClick="true">
        <field name="fechaCreacion"/>
        <field name="asunto"/>
        <field name="estado"/>
    </grid>

    <form name="subsysCorreos.TareaCorreo@Mis-form" title="Detalle de correo" model="com.educaflow.subsystem.correos.db.TareaCorreo"
          canEdit="false" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          related='{"adjuntos":["nombreFichero","contenidoFichero"]}'>

        <panel name="datosDelCorreo" title="Datos del correo" colSpan="12" readonly="true">
            <field name="asunto" colSpan="12"/>
            <field name="emailDestinatario" colSpan="6"/>
            <field name="historialEstado" colSpan="6"/>
        </panel>

        <panel name="contenido" title="Contenido" colSpan="12" readonly="true">
            <field name="cuerpo" colSpan="12" widget="html" showTitle="false"/>
        </panel>

        <panel-related name="adjuntos" title="Adjuntos" field="adjuntos" colSpan="12" readonly="true"
                       grid-view="subsysCorreos.TareaCorreo.AdjuntoCorreo@Mis-grid"
                       form-view="subsysCorreos.TareaCorreo.AdjuntoCorreo@Mis-form"/>

        <panel name="estadoDelEnvio" title="Estado del envío" colSpan="12" readonly="true">
            <field name="estado" colSpan="6"/>
            <field name="fechaCreacion" colSpan="6"/>
        </panel>

        <panel name="buttons-panel" colSpan="12" showFrame="false">
            <button name="btnVolver" title="Volver" onClick="back" css="btn-secondary" colSpan="3" colOffset="9" outline="true"/>
        </panel>

    </form>

    <grid name="subsysCorreos.TareaCorreo.AdjuntoCorreo@Mis-grid" title="Adjuntos" model="com.educaflow.subsystem.correos.db.AdjuntoCorreo"
          edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true"
          orderBy="nombreFichero">
        <field name="nombreFichero"/>
        <field name="contenidoFichero"/>
    </grid>

    <form name="subsysCorreos.TareaCorreo.AdjuntoCorreo@Mis-form" title="Adjunto" model="com.educaflow.subsystem.correos.db.AdjuntoCorreo"
          canAttach="false" canEdit="false" canBack="true" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="datosAdjunto" colSpan="12" readonly="true">
            <field name="nombreFichero" colSpan="12"/>
            <field name="contenidoFichero" colSpan="12"/>
        </panel>
    </form>

</object-views>
