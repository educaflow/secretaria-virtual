<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="correos" package="com.educaflow.subsystem.correos.db"/>

    <entity name="TareaCorreo">
        <string name="asunto" required="true" title="Asunto"/>
        <string name="cuerpo" required="true" large="true" multiline="true" title="Cuerpo"/>
        <string name="dniDestinatario" required="true" title="DNI del destinatario"/>
        <string name="emailDestinatario" required="true" title="Dirección de correo"/>
        <many-to-one name="centro" ref="com.educaflow.subsystem.common.db.Centro" title="Centro"/>
        <many-to-one name="historialEstado" ref="com.educaflow.subsystem.expedientes.db.HistorialEstado" title="Historial de estado del expediente"/>
        <datetime name="fechaCreacion" required="true" title="Fecha de creación"/>
        <datetime name="fechaUltimoIntento" title="Fecha del último intento"/>
        <integer name="numeroIntentos" required="true" title="Número de intentos"/>
        <string name="motivoFallo" large="true" multiline="true" title="Motivo del fallo"/>
        <enum name="estado" ref="EstadoTareaCorreo" required="true" title="Estado"/>
        <one-to-many name="adjuntos" ref="AdjuntoCorreo" mappedBy="tareaCorreo" title="Adjuntos"/>

        <finder-method name="findPendientes" filter="self.estado = 'PENDIENTE'" all="true"/>
    </entity>

    <enum name="EstadoTareaCorreo">
        <item name="PENDIENTE" title="Pendiente"/>
        <item name="ENVIANDO" title="Enviando"/>
        <item name="ENVIADO" title="Enviado"/>
        <item name="FALLADO" title="Fallado"/>
    </enum>

</domain-models>
