<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <grid name="firma-TareaFirma-main-grid" title="Firmas" model="com.educaflow.subsystem.firma.db.TareaFirma"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="true" canDelete="false" canSave="false"
          orderBy="fechaSolicitud" canEditOnClick="true"
    >
        <field name="fechaSolicitud"/>
        <field name="firmante"/>
        <field name="motivoFirma"/>
        <field name="estadoFirma"/>
    </grid>

    <form name="firma-TareaFirma-main-form" title="Firmas de documentos" model="com.educaflow.subsystem.firma.db.TareaFirma" canEdit="true" canAttach="false" canBack="false" canBackOnSave="true" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          onLoad="firma-TareaFirma-main-form-pasoActual-paso1Inicio-action"

    >
        <panel name="firma" title="" colSpan="12"  readonly="true" >
            <field name="motivoFirma"   colSpan="8"/>
            <field name="fechaSolicitud"   colSpan="4"/>
            <field name="estadoTareaFirma"   colSpan="4"/>
            <field name="fechaResolucion"   colSpan="4" colOffset="4" showIf="fechaResolucion!=null"/>
            <field name="pasoActual" showIf="false" />
        </panel>


        <panel-related name="documentosFirma" title="Documentos a firmar" field="documentosFirma" colSpan="12"  grid-view="firma-DocumentoFirma-main-grid" form-view="firma-DocumentoFirma-main-form" editable="false" canNew="false" />



        <panel name="paso1Inicio" title="Resolver" colSpan="12" showIf="pasoActual=='paso1Inicio'" >
            <button name="Rechazar" title="Rechazar firmar"          onClick="firma-TareaFirma-main-form-go-paso2Rechazado-action" css="btn-secondary"  colSpan="3" outline="true" />
            <button name="Firmar"   title="Firmar todos los documentos" onClick="firma-TareaFirma-main-form-go-paso2Firmar-action"     colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Rechazado" title="Rechazar firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Rechazado'">
            <field name="motivoRechazo"   colSpan="12" widget="Text"/>
            <button name="Atras"     title="Atrás"                    onClick="firma-TareaFirma-main-form-go-paso1Inicio-action"  css="btn-secondary" colSpan="3" outline="true" />
            <button name="Finalizar" title="Finalizar"                onClick="save"     colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Firmar" title="Firmar el documento" colSpan="12" showTitle="false" showIf="pasoActual=='paso2Firmar'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Para firmar los documentos debe tener la aplicación de <a href="https://sede.serviciosmin.gob.es/es-es/firmaelectronica/paginas/autofirma.aspx" target="_blank">AutoFirma</a> instalada y un certificado digital válido.]]></help>
            <button name="Atras"    title="Atrás"                                          onClick="firma-TareaFirma-main-form-go-paso1Inicio-action"  css="btn-secondary" colSpan="3" outline="true" />
            <button name="FirmarYFinalizar"   title="Firmar todos los documentos con AutoFirma__!! y finalizar" onClick="save"     colSpan="5" colOffset="4"  />
        </panel>


    </form>

    <grid name="firma-DocumentoFirma-main-grid" title="Documentos" model="com.educaflow.subsystem.firma.db.DocumentoFirma"  edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="documentoOriginal.fileName"/>
    </grid>
    <form name="firma-DocumentoFirma-main-form" title="Documento"   model="com.educaflow.subsystem.firma.db.DocumentoFirma" canAttach="false" >
        <panel-tabs>
            <panel name="documentoFirmaOriginal" title="Documento original" colSpan="12"  >
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoOriginal" ><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoOriginal.id}/content/download?inline=true&name=${documentoOriginal.fileName}`} ></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
            <panel name="documentoFirmaFirmado" title="Documento firmado" colSpan="12" showIf="documentoFirmado!=null" >
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoFirmado" ><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoFirmado.id}/content/download?inline=true&name=${documentoFirmado.fileName}`} ></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>

    <action-group name="firma-TareaFirma-main-form-go-paso1Inicio-action">
        <action name="firma-TareaFirma-main-form-pasoActual-paso1Inicio-action"/>
        <action name="firma-TareaFirma-main-form-motivoRechazo-Null-action"/>
    </action-group>

    <action-group name="firma-TareaFirma-main-form-go-paso2Rechazado-action">
        <action name="firma-TareaFirma-main-form-pasoActual-paso2Rechazado-action"/>
    </action-group>

    <action-group name="firma-TareaFirma-main-form-go-paso2Firmar-action">
        <action name="firma-TareaFirma-main-form-pasoActual-paso2Firmar-action"/>
    </action-group>

    <!-- Acciones básicas que cambian campos simples -->
    <action-record name="firma-TareaFirma-main-form-pasoActual-paso1Inicio-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="pasoActual" expr="paso1Inicio" />
    </action-record>
    <action-record name="firma-TareaFirma-main-form-pasoActual-paso2Rechazado-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="pasoActual" expr="paso2Rechazado" />
    </action-record>
    <action-record name="firma-TareaFirma-main-form-pasoActual-paso2Firmar-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="pasoActual" expr="paso2Firmar" />
    </action-record>

    <action-record name="firma-TareaFirma-main-form-estadoFirma-PENDIENTE-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="estadoFirma" expr="PENDIENTE" />
    </action-record>
    <action-record name="firma-TareaFirma-main-form-estadoFirma-RECHAZADO-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="estadoFirma" expr="RECHAZADO" />
    </action-record>
    <action-record name="firma-TareaFirma-main-form-estadofirma-TareaFirmaDO-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="estadoFirma" expr="FIRMADO" />
    </action-record>
    <action-record name="firma-TareaFirma-main-form-motivoRechazo-Null-action" model="com.educaflow.subsystem.firma.db.TareaFirma">
        <field name="motivoRechazo" expr="" />
    </action-record>



</object-views>