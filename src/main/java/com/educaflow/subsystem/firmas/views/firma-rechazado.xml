<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <grid name="subsysFirma.TareaFirma-rechazado-grid" title="Firmas" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          orderBy="fechaSolicitud" canEditOnClick="true">
        <field name="fechaSolicitud"/>
        <field name="fechaResolucion"/>
        <field name="firmante"/>
        <field name="motivoFirma"/>
        <field name="estadoTareaFirma"/>
    </grid>

    <form name="subsysFirma.TareaFirma-rechazado-form" title="Firma de documento" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          canEdit="false" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          related='{"documentosFirma":["documentoOriginal"]}'>

        <panel name="datosFirma" title="Estado de la tarea a firmar" colSpan="12" readonly="true">
            <field name="motivoFirma"   colSpan="8"/>
            <field name="fechaSolicitud"   colSpan="4"/>
            <field name="estadoTareaFirma"   colSpan="4"/>
            <field name="fechaResolucion"   colSpan="4" colOffset="4" />
            <field name="motivoRechazo"    colSpan="12"  />
        </panel>

        <panel-related name="documentosFirma" title="Documentos" field="documentosFirma" colSpan="12"
                       grid-view="subsysFirma.DocumentoFirma-rechazado-grid" form-view="subsysFirma.DocumentoFirma-rechazado-form" readonly="true"/>

        <panel name="acciones" colSpan="12" showFrame="false">
            <button name="btnVolver" title="Volver" onClick="back" css="btn-secondary" colSpan="3" colOffset="9" outline="true"/>
        </panel>

    </form>

    <grid name="subsysFirma.DocumentoFirma-rechazado-grid" title="Documentos" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="documentoOriginal.fileName"/>
    </grid>

    <form name="subsysFirma.DocumentoFirma-rechazado-form" title="Documento" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          canAttach="false" canEdit="false" canBack="true" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="tabDocumentoOriginal" title="Documento original" colSpan="12">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoOriginal"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoOriginal.id}/content/download?inline=true&name=${documentoOriginal.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>

</object-views>

