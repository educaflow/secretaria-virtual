<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <grid name="subsysFirma.TareaFirma-pendiente-grid" title="Firmas" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="true" canDelete="false" canSave="false"
          orderBy="fechaSolicitud" canEditOnClick="true"
    >
        <field name="fechaSolicitud"/>
        <field name="firmante"/>
        <field name="motivoFirma"/>
        <field name="estadoTareaFirma"/>
    </grid>

    <form name="subsysFirma.TareaFirma-pendiente-form" title="Firma de documento" model="com.educaflow.subsystem.firmas.db.TareaFirma" canEdit="true" canAttach="false" canBack="false" canBackOnSave="true" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          onLoad="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso1Inicio-action" related='{"documentosFirma":["documentoOriginal","documentoFirmado"]}'
    >
        <panel name="datosFirma" title="Estado de la tarea a firmar" colSpan="12" readonly="true">
            <field name="motivoFirma"   colSpan="8"/>
            <field name="fechaSolicitud"   colSpan="4"/>
            <field name="estadoTareaFirma"   colSpan="4"/>
            <field name="fechaResolucion"   colSpan="4" colOffset="4" showIf="fechaResolucion!=null"/>
            <field name="pasoActual" showIf="false" />
        </panel>


        <panel-related name="documentosFirma" title="Documentos a firmar" field="documentosFirma" colSpan="12"  grid-view="subsysFirma.DocumentoFirma-pendiente-grid" form-view="subsysFirma.DocumentoFirma-pendiente-form" readonly="true" />



        <panel name="paso1Inicio" title="Resolver" colSpan="12" showIf="pasoActual=='paso1Inicio'" >
            <button name="paso1InicioRechazar"   onClick="subsysFirma.TareaFirma-pendiente-form-button-paso1InicioRechazar-action" title="Rechazar firmar"           css="btn-secondary"  colSpan="3" outline="true" />
            <button name="paso1InicioFirmar"     onClick="subsysFirma.TareaFirma-pendiente-form-button-paso1InicioFirmar-action"   title="Firmar todos los documentos"      colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Rechazado" title="Rechazar firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Rechazado'">
            <field name="motivoRechazo"   colSpan="12" widget="Text"/>
            <button name="paso2RechazadoAtras"   onClick="subsysFirma.TareaFirma-pendiente-form-button-paso2RechazadoAtras-action"   title="Atrás"                      css="btn-secondary" colSpan="3" outline="true" />
            <button name="paso2RechazadoGuardar" onClick="subsysFirma.TareaFirma-pendiente-form-button-paso2RechazadoGuardar-action" title="Finalizar"                     colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Firmar" title="Firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Firmar'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Para firmar los documentos debe tener la aplicación de <a href="https://sede.serviciosmin.gob.es/es-es/firmaelectronica/paginas/autofirma.aspx" target="_blank">AutoFirma</a> instalada y un certificado digital válido.]]></help>
            <button name="paso2FirmarAtras"      onClick="subsysFirma.TareaFirma-pendiente-form-button-paso2FirmarAtras-action"  title="Atrás"   css="btn-secondary" colSpan="3" outline="true" />
            <button name="paso2FirmarGuardar"    onClick="serial:subsysFirma.TareaFirma-pendiente-form-firmar-action,subsysFirma.TareaFirma-pendiente-form-button-paso2FirmarGuardar-action" title="Firmar todos los documentos con AutoFirma__!! y finalizar"      colSpan="5" colOffset="4"  />
        </panel>

        <panel  colSpan="12" itemSpan="2" showFrame="false">
            <field name="errorMessajesField" showTitle="false" readonly="true" colSpan="12">
                <viewer depends="errorMensajes" ><![CDATA[
                    <>
                    <Box>
                        {errorMensajes.length > 0 ? (
                        <div className="alert alert-danger fade show" role="alert">
                            <ul >
                                {errorMensajes.map((errorMensaje, index) => (
                                <li key={index}>
                                    {errorMensaje.label ? (<strong>{errorMensaje.label}:&nbsp;&nbsp;</strong>) : null}
                                    {errorMensaje.message}
                                </li>
                                ))}
                            </ul>
                        </div>
                        ) : (
                        <span></span>
                        )}
                    </Box>
                    </>
                    ]]></viewer>
            </field>
        </panel>

    </form>

    <grid name="subsysFirma.DocumentoFirma-pendiente-grid" title="Documentos" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="documentoOriginal.fileName"/>
    </grid>
    <form name="subsysFirma.DocumentoFirma-pendiente-form" title="Documento" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          canAttach="false" canEdit="false" canBack="true" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="tabDocumentoOriginal" title="Documento original" colSpan="12">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoOriginal"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoOriginal.id}/content/download?inline=true&name=${documentoOriginal.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
            <panel name="tabDocumentoFirmado" title="Documento firmado" colSpan="12" showIf="documentoFirmado!=null">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoFirmado"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoFirmado.id}/content/download?inline=true&name=${documentoFirmado.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>

    <!-- *******************************************************************  -->
    <!-- ********************* Acciones de los botones *********************  -->
    <!-- *******************************************************************  -->
    <action-group name="subsysFirma.TareaFirma-pendiente-form-button-paso1InicioRechazar-action">
        <action name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso2Rechazado-action"/>
    </action-group>
    <action-group name="subsysFirma.TareaFirma-pendiente-form-button-paso1InicioFirmar-action">
        <action name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso2Firmar-action"/>
    </action-group>
    <action-group name="subsysFirma.TareaFirma-pendiente-form-button-paso2RechazadoAtras-action">
        <action name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso1Inicio-action"/>
    </action-group>
    <action-method name="subsysFirma.TareaFirma-pendiente-form-button-paso2RechazadoGuardar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controllers.FirmarController" method="marcarComoRechazada" />
    </action-method>
    <action-group name="subsysFirma.TareaFirma-pendiente-form-button-paso2FirmarAtras-action">
        <action name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso1Inicio-action"/>
    </action-group>
    <action-method name="subsysFirma.TareaFirma-pendiente-form-button-paso2FirmarGuardar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controllers.FirmarController" method="marcarComoFirmada" />
    </action-method>




    <action-method name="subsysFirma.TareaFirma-pendiente-form-firmar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controllers.FirmarController" method="firmarDocumentosConAutoFirma" />
    </action-method>




    <!-- *********************************************************************************************  -->
    <!-- ************************ Acciones básicas que cambian campos simples ************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso1Inicio-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso1Inicio" />
    </action-record>
    <action-record name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso2Rechazado-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Rechazado" />
    </action-record>
    <action-record name="subsysFirma.TareaFirma-pendiente-form-pasoActual-paso2Firmar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Firmar" />
    </action-record>



</object-views>
