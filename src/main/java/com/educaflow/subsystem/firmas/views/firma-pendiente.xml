<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <grid name="subsysFirma.TareaFirma@Pendiente-grid" title="Firmas" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="true" canDelete="false" canSave="false"
          orderBy="fechaSolicitud" canEditOnClick="true"
    >
        <field name="fechaSolicitud"/>
        <field name="firmante"/>
        <field name="motivoFirma"/>
        <field name="estadoTareaFirma"/>
    </grid>

    <form name="subsysFirma.TareaFirma@Pendiente-form" title="Firma de documento" model="com.educaflow.subsystem.firmas.db.TareaFirma" canEdit="true" canAttach="false" canBack="false" canBackOnSave="true" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          onLoad="subsysFirma.TareaFirma@Pendiente-form-set-pasoActual-paso1Inicio-action" related='{"documentosFirma":["documentoOriginal","documentoFirmado"]}'
    >
        <panel name="datosFirma" title="Estado de la tarea a firmar" colSpan="12" readonly="true">
            <field name="motivoFirma"   colSpan="8"/>
            <field name="fechaSolicitud"   colSpan="4"/>
            <field name="estadoTareaFirma"   colSpan="4"/>
            <field name="fechaResolucion"   colSpan="4" colOffset="4" showIf="fechaResolucion!=null"/>
            <field name="pasoActual" showIf="false" />
        </panel>


        <panel-related name="documentosFirma" title="Documentos a firmar" field="documentosFirma" colSpan="12"  grid-view="subsysFirma.DocumentoFirma@Pendiente-grid" form-view="subsysFirma.DocumentoFirma@Pendiente-form" readonly="true" />



        <panel name="paso1Inicio" title="Resolver" colSpan="12" showIf="pasoActual=='paso1Inicio'" >
            <button name="paso1InicioRechazar"   onClick="subsysFirma.TareaFirma@Pendiente-form-set-pasoActual-paso2Rechazado-action" title="Rechazar firmar"           css="btn-secondary"  colSpan="3" outline="true" />
            <button name="paso1InicioFirmar"     onClick="subsysFirma.TareaFirma@Pendiente-form-set-pasoActual-paso2Firmar-action"   title="Firmar todos los documentos"      colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Rechazado" title="Rechazar firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Rechazado'">
            <field name="motivoRechazo"   colSpan="12" widget="Text"/>
            <button name="paso2RechazadoAtras"   onClick="subsysFirma.TareaFirma@Pendiente-form-set-pasoActual-paso1Inicio-action"   title="Atrás"                      css="btn-secondary" colSpan="3" outline="true" />
            <button name="paso2RechazadoGuardar" onClick="subsysFirma.TareaFirma@Pendiente-Local-validateMarcarComoRechazada-action,subsysFirma.TareaFirma@Pendiente-Remote-marcarComoRechazada-action" title="Finalizar"                     colSpan="3" colOffset="6"  />
        </panel>

        <panel name="paso2Firmar" title="Firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Firmar'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Para firmar los documentos debe tener la aplicación de <a href="https://sede.serviciosmin.gob.es/es-es/firmaelectronica/paginas/autofirma.aspx" target="_blank">AutoFirma</a> instalada y un certificado digital válido.]]></help>
            <button name="paso2FirmarAtras"      onClick="subsysFirma.TareaFirma@Pendiente-form-set-pasoActual-paso1Inicio-action"  title="Atrás"   css="btn-secondary" colSpan="3" outline="true" />
            <button name="paso2FirmarGuardar"    onClick="serial:subsysFirma.TareaFirma@Pendiente-Remote-firmarDocumentosConAutoFirma-action,subsysFirma.TareaFirma@Pendiente-validateMarcarComoFirmada-action,subsysFirma.TareaFirma@Pendiente-Remote-marcarComoFirmada-action" title="Firmar todos los documentos con AutoFirma__!! y finalizar"      colSpan="5" colOffset="4"  />
        </panel>
    </form>

    <grid name="subsysFirma.DocumentoFirma@Pendiente-grid" title="Documentos" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="documentoOriginal.fileName"/>
    </grid>
    <form name="subsysFirma.DocumentoFirma@Pendiente-form" title="Documento" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          canAttach="false" canEdit="false" canBack="true" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="tabDocumentoOriginal" title="Documento original" colSpan="12">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoOriginal"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoOriginal.id}/content/download?inline=true&name=${documentoOriginal.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
            <panel name="tabDocumentoFirmado" title="Documento firmado" colSpan="12" showIf="documentoFirmado!=null">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoFirmado"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoFirmado.id}/content/download?inline=true&name=${documentoFirmado.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>


    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de las tareas principales ****************************  -->
    <!-- *********************************************************************************************  -->
    <action-group name="subsysFirma.TareaFirma@Pendiente-validateMarcarComoRechazada-action">
        <action name="subsysFirma.TareaFirma@Pendiente-Local-validateMarcarComoRechazada-action"/>
    </action-group>
    <action-group name="subsysFirma.TareaFirma@Pendiente-validateMarcarComoFirmada-action">
        <action name="subsysFirma.TareaFirma@Pendiente-Remote-validarDocumentosFirmados-action"/>
    </action-group>




    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de Validaciones en local  ****************************  -->
    <!-- *********************************************************************************************  -->
    <action-condition name="subsysFirma.TareaFirma@Pendiente-Local-validateMarcarComoRechazada-action">
        <check field="motivoRechazo"/>
    </action-condition>



    <!-- *********************************************************************************************  -->
    <!-- ************************ Acciones básicas que cambian campos simples ************************  -->
    <!-- *********************************************************************************************  -->
    <action-record name="subsysFirma.TareaFirma@Pendiente-set-pasoActual-paso1Inicio-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso1Inicio" />
    </action-record>
    <action-record name="subsysFirma.TareaFirma@Pendiente-set-pasoActual-paso2Rechazado-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Rechazado" />
    </action-record>
    <action-record name="subsysFirma.TareaFirma@Pendiente-set-pasoActual-paso2Firmar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Firmar" />
    </action-record>




    <!-- *********************************************************************************************  -->
    <!-- ************************** Acciones de llamadas Remotas al servidor *************************  -->
    <!-- *********************************************************************************************  -->
    <action-method name="subsysFirma.TareaFirma@Pendiente-Remote-validarDocumentosFirmados-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.FirmarController" method="validarDocumentosFirmados" />
    </action-method>
    <action-method name="subsysFirma.TareaFirma@Pendiente-Remote-marcarComoFirmada-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.FirmarController" method="marcarComoFirmada" />
    </action-method>
    <action-method name="subsysFirma.TareaFirma@Pendiente-Remote-marcarComoRechazada-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.FirmarController" method="marcarComoRechazada" />
    </action-method>
    <action-method name="subsysFirma.TareaFirma@Pendiente-Remote-firmarDocumentosConAutoFirma-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.FirmarController" method="firmarDocumentosConAutoFirma" />
    </action-method>


</object-views>
