<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

    <module name="configuracioncentro" package="com.educaflow.subsystem.configuracioncentro.db"/>
    <entity name="CursoAcademicoUsuario" repository="abstract">

        <many-to-one name="cursoAcademico" ref="com.educaflow.subsystem.configuracioncentro.db.CursoAcademico" required="true" title="Curso Académico"/>
        <many-to-one name="usuario" ref="com.axelor.auth.db.User" required="true"/>

        <one-to-many name="cursoAcademicoUsuarioRolesAcademicos" ref="com.educaflow.subsystem.configuracioncentro.db.CursoAcademicoUsuarioRolAcademico" mappedBy="cursoAcademicoUsuario" title="NO"/>


        <unique-constraint columns="cursoAcademico,usuario" name="uc_curso_academico_usuario" title="NO"/>
    </entity>

</domain-models>