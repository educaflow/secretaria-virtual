<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

    <module name="configuracioncentro" package="com.educaflow.subsystem.configuracioncentro.db"/>
    <entity name="CursoAcademicoUsuarioRolAcademico" table="configuracioncentro_curso_usuario_rol">
        <many-to-one name="cursoAcademicoUsuario" ref="com.educaflow.subsystem.configuracioncentro.db.CursoAcademicoUsuario" required="true" title="NO"/>
        <many-to-one name="rolAcademico" ref="com.educaflow.subsystem.configuracioncentro.db.RolAcademico" required="true" title="NO"/>
        <unique-constraint columns="cursoAcademicoUsuario,rolAcademico" name="uc_curso_academico_usuario_rol" title="NO"/>
    </entity>

</domain-models>