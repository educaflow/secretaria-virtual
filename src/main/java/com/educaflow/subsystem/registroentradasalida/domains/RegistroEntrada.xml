<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="registroentradasalida" package="com.educaflow.subsystem.registroentradasalida.db"/>
    <entity name="RegistroEntrada" repository="abstract">
        <many-to-one name="centro" ref="com.educaflow.subsystem.common.db.Centro"  />
        <string name="numeroRegistro"  title="Num.__!! registro" namecolumn="true"  />
        <datetime name="fecha" />
        <many-to-one name="documentoOriginalFirmado" ref="com.axelor.meta.db.MetaFile" required="true" title="Solicitud firmada"/>
        <many-to-one name="documentoResguardoPresentacion" ref="com.axelor.meta.db.MetaFile" required="true" title="Resguardo de presentación"/>
        <one-to-many name="anexos" ref="com.axelor.meta.db.MetaFile" title="Anexos" />

        <entity-listener class="com.educaflow.subsystem.registroentradasalida.db.repo.RegistroEntradaListener"/>
    </entity>

</domain-models>