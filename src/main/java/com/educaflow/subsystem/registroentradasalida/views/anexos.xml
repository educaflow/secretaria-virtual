<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <grid name="subsysRegistroEntradaSalida.Anexos-grid" title="Anexos" model="com.axelor.meta.db.MetaFile"
          edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true"
        >
        <field name="fileName"/>
    </grid>

    <form name="subsysRegistroEntradaSalida.Anexos-form" title="Anexo"   model="com.axelor.meta.db.MetaFile"
          canAttach="false" canEdit="false" canBack="true" canDelete="false" canNew="false" canSave="false" canMore="false"
    >
        <panel title="Anexo" colSpan="12">
            <field name="fileName" colSpan="9"/>
            <field name="sizeText" colSpan="1"/>
            <field name="content" widget="binary" title="Descargar" colSpan="2"/>
        </panel>
    </form>



</object-views>
