<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="subsysRegistroEntradaSalida.RegistroEntrada@Main-action"  title="Registro de entrada" model="com.educaflow.subsystem.registroentradasalida.db.RegistroEntrada"  >
        <view type="grid" name="subsysRegistroEntradaSalida.RegistroEntrada@Main-grid"/>
        <view type="form" name="subsysRegistroEntradaSalida.RegistroEntrada@Main-form"/>
    </action-view>



    <grid name="subsysRegistroEntradaSalida.RegistroEntrada@Main-grid" title="" model="com.educaflow.subsystem.registroentradasalida.db.RegistroEntrada"
          groups="admins,users"
          allowSearchFields="true" orderBy="numeroRegistro" canViewOnClick="true"
          canAdvanceSearch="false" canRefresh="false" editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
    >
        <field name="centro"          />
        <field name="asunto"          />
        <field name="numeroRegistro"  width="200px"/>
        <field name="fecha"           width="200px"/>
    </grid>

    <form name="subsysRegistroEntradaSalida.RegistroEntrada@Main-form" title="Registro de entrada" model="com.educaflow.subsystem.registroentradasalida.db.RegistroEntrada"
          width="large" canEdit="false" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
    >
        <panel name="registroEntrada" title="Registro de entrada" colSpan="12" >
            <field name="centro"          colSpan="9"/>
            <field name="numeroRegistro"  colSpan="3"/>
            <field name="asunto"          colSpan="9"/>
            <field name="fecha"           colSpan="3"/>

            <field name="documentoOriginalFirmado"         widget="binary-link" colSpan="6"/>
            <field name="documentoResguardoPresentacion"   widget="binary-link" colSpan="6"/>
        </panel>

        <panel-related name="registroEntradaAnexos" title="Anexos" field="anexos" colSpan="12" form-view="subsysRegistroEntradaSalida.Anexos@Main-form"  grid-view="subsysRegistroEntradaSalida.Anexos@Main-grid"  />

        <panel name="actions" title="" colSpan="12" showFrame="false">
            <button name="btnVolver" title="Salir" onClick="back" css="btn-secondary" colSpan="3" colOffset="9" outline="true"/>
        </panel>
    </form>



</object-views>