<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-view name="subsysRegistroEntradaSalida.RegistroSalida-mantenimiento-action"  title="Información para PDF" model="com.educaflow.subsystem.registroentradasalida.db.RegistroSalida"  >
        <view type="grid" name="subsysRegistroEntradaSalida.RegistroSalida-grid"/>
        <view type="form" name="subsysRegistroEntradaSalida.RegistroSalida-form"/>
    </action-view>


    <grid name="subsysRegistroEntradaSalida.RegistroSalida-grid" title="Registro de entrada" model="com.educaflow.subsystem.registroentradasalida.db.RegistroSalida"
          groups="admins,users"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false"
          canSave="false" orderBy="numeroRegistro" canViewOnClick="true"
    >
        <field name="centro"/>
        <field name="numeroRegistro"/>
        <field name="fecha"/>
    </grid>


    <form name="subsysRegistroEntradaSalida.RegistroSalida-form" title="Registro" model="com.educaflow.subsystem.registroentradasalida.db.RegistroSalida"
          canEdit="false" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false" canBackOnSave="true"
    >
        <panel name="registroSalida" title="Registro de Salida" colSpan="12" >
            <field name="numeroRegistro"   colSpan="4"/>
            <field name="fecha"   colSpan="4"/>

            <field name="documento" widget="binary-link"  colSpan="12"/>
        </panel>
        <panel-related name="anexos" title="Anexos" field="anexos" colSpan="12" form-view="subsysRegistroEntradaSalida.Anexos-form"  grid-view="subsysRegistroEntradaSalida.Anexos-grid"  />
        <panel name="actions" title="" colSpan="12" showFrame="false">
            <button name="btnVolver" title="Salir" onClick="back" css="btn-secondary" colSpan="3" colOffset="9" outline="true"/>
        </panel>
    </form>


</object-views>
