<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="gruposnotas" package="com.educaflow.system.gruposnotas.db"/>

    <entity name="AlumnoGrupo" repository="abstract">

        <!-- cliente: grupo padre (Input AllowProperties de Crear; lo rellena la RUI-011/012 desde el grupo padre). Inmutable tras crear. SIN required (lo valida VAL-018 en el servicio). -->
        <many-to-one name="grupo" title="Grupo" ref="com.educaflow.system.gruposnotas.db.Grupo"/>

        <!-- cliente: usuario de tipo Alumno del centro del grupo (Input AllowProperties de Crear). Inmutable tras crear. SIN required (lo valida VAL-010 en el servicio). -->
        <many-to-one name="alumno" title="Alumno" ref="com.axelor.auth.db.User"/>

        <!-- composición: las notas del alumno en este grupo (una por módulo). orphanRemoval para borrar en cascada al quitar el alumno. -->
        <one-to-many name="notas" title="Notas" ref="com.educaflow.system.gruposnotas.db.Nota" mappedBy="alumnoGrupo" orphanRemoval="true"/>

        <!-- CC-001 (momento lectura): nota media derivada de solo lectura. NO se persiste; se calcula INLINE al leer, referenciando solo entidades/enums de ..db.. (Nota, ValorNota). Devuelve "Sin nota" si no hay módulos evaluados; en otro caso la media redondeada al entero más cercano como texto. La entidad NO depende de ..service..: el getter es autosuficiente y AlumnoGrupoService.calcularNotaMedia delega en este getter (única fuente de verdad). -->
        <string name="notaMedia" title="Nota media" transient="true">
        <![CDATA[
        if (getNotas() == null) {
            return "Sin nota";
        }
        int suma = 0;
        int evaluadas = 0;
        for (com.educaflow.system.gruposnotas.db.Nota nota : getNotas()) {
            com.educaflow.system.gruposnotas.db.ValorNota valor = nota.getValor();
            if (valor == null || valor == com.educaflow.system.gruposnotas.db.ValorNota.NO_EVALUADO) {
                continue;
            }
            if (valor == com.educaflow.system.gruposnotas.db.ValorNota.MATRICULA_HONOR) {
                suma += 10;
            } else {
                // NOTA_1..NOTA_10: el ordinal del item es su valor numérico (NO_EVALUADO ocupa el ordinal 0).
                suma += valor.ordinal();
            }
            evaluadas++;
        }
        if (evaluadas == 0) {
            return "Sin nota";
        }
        return String.valueOf(Math.round((double) suma / evaluadas));
        ]]>
        </string>

        <!-- RES-005: un mismo alumno no aparece dos veces en el mismo grupo. -->
        <unique-constraint columns="grupo,alumno"/>

        <!-- RES-004 / VAL-013: comprobar si el alumno ya pertenece a otro grupo del mismo curso académico. -->
        <finder-method name="findByAlumnoAndGrupoCursoAcademico"
                       using="com.axelor.auth.db.User:alumno,Integer:cursoAcademico"
                       filter="self.alumno = :alumno AND self.grupo.cursoAcademico = :cursoAcademico"
                       all="true"/>

    </entity>

</domain-models>
