<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="gruposnotas" package="com.educaflow.system.gruposnotas.db"/>

    <entity name="ModuloGrupo" repository="abstract">

        <!-- servidor: grupo al que pertenece (lo fija RN-001 al generar los módulos del grupo). required: integridad estructural. -->
        <many-to-one name="grupo" title="Grupo" ref="com.educaflow.system.gruposnotas.db.Grupo" required="true"/>

        <!-- servidor: módulo del catálogo educativo (lo fija RN-001 a partir de CursoModulo del curso). required. -->
        <many-to-one name="modulo" title="Módulo" ref="com.educaflow.subsystem.sistemaeducativo.db.Modulo" required="true"/>

        <!-- composición: las notas de este módulo (una por alumno del grupo). orphanRemoval para borrar en cascada. -->
        <one-to-many name="notas" title="Notas" ref="com.educaflow.system.gruposnotas.db.Nota" mappedBy="moduloGrupo" orphanRemoval="true"/>

        <!-- RES-003: un mismo módulo no aparece dos veces en el mismo grupo. -->
        <unique-constraint columns="grupo,modulo"/>

    </entity>

</domain-models>
