<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- ****************************************************************************************** -->
    <!-- ****************************** AlumnoGrupo : Vistas (Mis notas) ************************** -->
    <!-- ****************************************************************************************** -->

    <action-view name="sysGruposNotas.AlumnoGrupo@MisNotas-action" title="Mis notas" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo">
        <view type="grid" name="sysGruposNotas.AlumnoGrupo@MisNotas-grid"/>
        <view type="form" name="sysGruposNotas.AlumnoGrupo@MisNotas-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <!-- ESC-026: el alumno solo ve los grupos a los que pertenece (alumno = usuario conectado). -->
        <domain>self.alumno = :__user__</domain>
    </action-view>

    <grid name="sysGruposNotas.AlumnoGrupo@MisNotas-grid" title="" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo"
          orderBy="-grupo.cursoAcademico"
          canRefresh="false" canAdvanceSearch="false"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="grupo.cursoAcademico" title="Curso académico" width="140px"/>
        <field name="grupo.curso.ciclo" title="Ciclo"/>
        <field name="grupo.nombre" title="Grupo"/>
        <field name="notaMedia" title="Nota media"/>
    </grid>

    <form name="sysGruposNotas.AlumnoGrupo@MisNotas-form" title="Mi grupo" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="MiGrupo" title="Mi grupo">
            <field name="grupo.nombre" colSpan="6" readonly="true" title="Nombre"/>
            <field name="grupo.curso" colSpan="6" readonly="true" title="Curso"/>
            <field name="grupo.cursoAcademico" colSpan="3" readonly="true" title="Curso académico"/>
            <field name="notaMedia" colSpan="3" readonly="true" title="Nota media"/>
        </panel>

        <panel-related name="notas" field="notas" title="Mis notas"
                       grid-view="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-grid"
                       form-view="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-form"
                       colSpan="12"
                       showFooter="false" canNew="false" canEdit="false" canRemove="false" canViewOnClick="true"/>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Volver" onClick="sysGruposNotas.AlumnoGrupo@MisNotas-btnCancel-action"
                    colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <!-- *************** AlumnoGrupo : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.AlumnoGrupo@MisNotas-btnCancel-action">
        <action name="back"/>
    </action-group>

    <!-- *************** AlumnoGrupo : Acciones de Validaciones en local *************** -->

    <!-- *************** AlumnoGrupo : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** AlumnoGrupo : Acciones de llamadas Remotas al servidor *************** -->


    <!-- *********************************************************************************************** -->
    <!-- ****************************** AlumnoGrupo.Nota : Vistas (Mis notas) ************************* -->
    <!-- *********************************************************************************************** -->

    <grid name="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-grid" title="" model="com.educaflow.system.gruposnotas.db.Nota"
          orderBy="moduloGrupo.modulo.name"
          canRefresh="false" canAdvanceSearch="false"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="moduloGrupo.modulo" title="Módulo"/>
        <field name="valor" width="160px"/>
        <field name="fechaCalificacion" width="170px"/>
    </grid>

    <form name="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-form" title="Mi nota" model="com.educaflow.system.gruposnotas.db.Nota"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="MiNota" title="Mi nota">
            <field name="moduloGrupo.modulo" colSpan="6" readonly="true" title="Módulo"/>
            <field name="valor" colSpan="6" readonly="true"/>
            <field name="fechaCalificacion" colSpan="3" readonly="true"/>
            <field name="fechaUltimaModificacion" colSpan="3" readonly="true"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cerrar" onClick="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-btnCancel-action"
                    colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <!-- *************** AlumnoGrupo.Nota : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.AlumnoGrupo.Nota@MisNotas-btnCancel-action">
        <action name="close"/>
    </action-group>

    <!-- *************** AlumnoGrupo.Nota : Acciones de Validaciones en local *************** -->

    <!-- *************** AlumnoGrupo.Nota : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** AlumnoGrupo.Nota : Acciones de llamadas Remotas al servidor *************** -->

</object-views>
