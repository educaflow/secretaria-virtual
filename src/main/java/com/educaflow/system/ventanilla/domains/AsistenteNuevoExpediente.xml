<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="ventanilla" package="com.educaflow.system.ventanilla.db"/>

    <entity name="AsistenteNuevoExpediente" persistable="false">

        <!-- Elección del usuario -->
        <many-to-one name="centro" ref="com.educaflow.subsystem.common.db.Centro" title="Centro"/>
        <many-to-one name="tramite" ref="com.educaflow.subsystem.expedientes.db.Tramite" title="Trámite"/>
        <boolean name="presentadoEnPapel" nullable="true" title="¿Cómo se presenta?"/>
        <boolean name="presentadoEnRepresentacion" nullable="true" title="¿Para quién es el expediente?"/>
        <string name="nombreTramite" transient="true" title="Trámite">
            <![CDATA[
                if (tramite == null) {
                    return null;
                }
                return com.axelor.i18n.I18n.get("value:" + tramite.getName());
            ]]>
        </string>
        <string name="ayudaTramite" large="true" transient="true" title="Ayuda">
            <![CDATA[
                if (tramite == null) {
                    return null;
                }
                return tramite.getHelp();
            ]]>
        </string>

        <!-- Candidatos que el servidor ofrece en cada paso -->
        <many-to-many name="centrosDisponibles" ref="com.educaflow.subsystem.common.db.Centro" title="Centros"/>
        <many-to-many name="tramitesDisponibles" ref="com.educaflow.subsystem.expedientes.db.Tramite" title="Trámites"/>
        <boolean name="hayQueElegirCentro" title="Hay que elegir centro"/>

        <!-- Qué preguntas se hacen en el último paso -->
        <boolean name="hayQuePreguntarParaQuien" title="Hay que preguntar para quién es"/>

    </entity>

</domain-models>
