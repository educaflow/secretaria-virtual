<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <action-view name="sysVentanilla.Cerrados@Expediente-action" title="Expedientes cerrados" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="grid" name="sysVentanilla.Cerrados@Expediente-grid"/>
        <domain>self.abierto=false AND (self.centro.id IN (SELECT cu.centro.id FROM CentroUsuario cu WHERE cu.usuario.id = :usuarioId) OR :esAdministrador = true)</domain>
        <context name="_profile" expr="TRAMITADOR"/>
        <context name="usuarioId" expr="eval: __user__?.id"/>
        <context name="esAdministrador" expr="eval: __user__?.group?.code == 'admins'"/>
    </action-view>

    <grid name="sysVentanilla.Cerrados@Expediente-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          action="subsysTramitador-event-view-action"
    >
        <field name="numeroExpediente"/>
        <field name="tipoExpediente.name"/>
        <field name="namePhase"/>
        <field name="nameState"/>
        <field name="fechaUltimoEstado"/>
    </grid>

    <?sv-primary-actions?>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
