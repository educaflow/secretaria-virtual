<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <action-view name="sysVentanilla.JefaturaCerrados@Expediente-action" title="Jefatura de estudios: expedientes cerrados" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="grid" name="sysVentanilla.JefaturaCerrados@Expediente-grid"/>
        <domain>self.abierto = false AND self.tipoExpediente.tramite.unidadTramitadora.code = :unidadTramitadora AND self.centro.id IN (SELECT cu.centro.id FROM CentroUsuario cu WHERE cu.usuario.id = :usuarioId)</domain>
        <context name="unidadTramitadora" expr="JEFATURA_ESTUDIOS"/>
        <context name="usuarioId" expr="eval: __user__?.id"/>
    </action-view>

    <grid name="sysVentanilla.JefaturaCerrados@Expediente-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name" orderBy="-fechaUltimoEstado"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          action="sysVentanilla.Abrir@Expediente-Remote-abrirExpediente-action"
    >
        <field name="numeroExpediente" width="110px"/>
        <field name="tipoExpediente.name"/>
        <field name="centro" width="200px"/>
        <field name="namePhase" width="150px"/>
        <field name="nameState" width="200px"/>
        <field name="perfilEstado" width="120px"/>
        <field name="fechaUltimoEstado" width="150px"/>
    </grid>

    <?sv-primary-actions?>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
