<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <!-- Tree de trámites candidatos (paso 2 del asistente): vista independiente porque
         <panel-related> no admite tree-view. Modelo AsistenteNuevoExpediente porque su
         <context> evalúa los campos que ha calculado el form fantasma de
         sysVentanilla.ElegirTramite@AsistenteNuevoExpediente (centro, hayQueElegirCentro,
         tramitesDisponibles); los nodos del propio tree usan TipoTramite/Tramite. -->
    <action-view name="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-action"
                 title="Nuevo expediente: elija el trámite"
                 model="com.educaflow.system.ventanilla.db.AsistenteNuevoExpediente">
        <view type="tree" name="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-tree"/>
        <context name="_centroId" expr="eval: centro?.id"/>
        <context name="_hayQueElegirCentro" expr="eval: hayQueElegirCentro"/>
        <context name="_tramiteIds" expr="eval: tramitesDisponibles?.collect{it.id}"/>
    </action-view>

    <tree name="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-tree"
          title="Trámites disponibles" showHeader="false">

        <column name="name"/>

        <node model="com.educaflow.subsystem.expedientes.db.TipoTramite"
              domain="EXISTS (SELECT 1 FROM Tramite t WHERE t.tipoTramite=self AND t.id IN :_tramiteIds)">
            <field name="name" as="name"/>
        </node>

        <node model="com.educaflow.subsystem.expedientes.db.Tramite"
              domain="self.id IN :_tramiteIds"
              parent="tipoTramite" draggable="false"
              onClick="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-onClick-action">
            <field name="name" as="name"/>
        </node>

    </tree>

    <?sv-primary-actions?>
    <action-group name="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-onClick-action">
        <action name="sysVentanilla.Main@AsistenteNuevoExpediente-action"/>
        <action name="close"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
