<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- Las bandejas se pintan con un GRID y no con un tree a propósito: la vista tree de Axelor pide
         los hijos de cada nodo con el tamaño de página por defecto (40) y SIN paginación (axelor-front,
         views/tree/tree.tsx → onSearchNode llama a ds.search sin limit ni offset; la barra de paginación
         del árbol solo gobierna el nodo raíz), así que en cuanto un trámite supera los 40 expedientes
         abiertos el resto queda INALCANZABLE. El grid sí pagina y conserva la agrupación por trámite con
         groupBy. MUST NOT volver a colgar aquí un tree de expedientes mientras el framework no pagine
         los hijos.
         Ninguna bandeja fija un _profile: al pulsar una fila, BandejaController.abrirExpediente elige el
         perfil real del usuario sobre ese expediente. -->
    <?sv-view?>
    <action-view name="sysVentanilla.MisPendientes@Expediente-action" title="Mis trámites pendientes de mí" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="grid" name="sysVentanilla.MisPendientes@Expediente-grid"/>
        <domain>self.usuarioRegistrador.id = :usuarioId AND self.abierto = true AND self.perfilEstado = :perfilCreador</domain>
        <context name="usuarioId" expr="eval: __user__?.id"/>
        <context name="perfilCreador" expr="CREADOR"/>
    </action-view>

    <grid name="sysVentanilla.MisPendientes@Expediente-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name" orderBy="fechaUltimoEstado"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          action="sysVentanilla.Abrir@Expediente-Remote-abrirExpediente-action"
    >
        <field name="numeroExpediente" width="110px"/>
        <field name="tipoExpediente.name"/>
        <field name="centro" width="200px"/>
        <field name="namePhase" width="150px"/>
        <field name="nameState" width="200px"/>
        <field name="perfilEstado" width="120px"/>
        <field name="fechaUltimoEstado" width="150px"/>
    </grid>

    <?sv-primary-actions?>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
