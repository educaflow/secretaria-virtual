<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <action-view name="sysVentanilla.TodosAbiertos@Expediente-action" title="Expedientes abiertos de todos los centros" model="com.educaflow.subsystem.expedientes.db.Expediente">
        <view type="grid" name="sysVentanilla.TodosAbiertos@Expediente-grid"/>
        <domain>self.abierto = true</domain>
    </action-view>

    <grid name="sysVentanilla.TodosAbiertos@Expediente-grid" title="Expedientes" model="com.educaflow.subsystem.expedientes.db.Expediente"
          groups="admins,users"
          groupBy="tipoExpediente.tramite.name" orderBy="fechaUltimoEstado"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          action="sysVentanilla.Abrir@Expediente-Remote-abrirExpediente-action"
    >
        <field name="numeroExpediente" width="110px"/>
        <field name="tipoExpediente.name"/>
        <field name="centro" width="200px"/>
        <field name="namePhase" width="150px"/>
        <field name="nameState" width="200px"/>
        <field name="perfilEstado" width="120px"/>
        <field name="fechaUltimoEstado" width="150px"/>
    </grid>

    <?sv-primary-actions?>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
