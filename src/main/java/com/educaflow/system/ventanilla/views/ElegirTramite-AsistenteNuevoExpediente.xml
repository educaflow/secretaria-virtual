<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <?sv-view?>
    <action-view name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-action"
                 title="Nuevo expediente: elija el trámite"
                 model="com.educaflow.system.ventanilla.db.AsistenteNuevoExpediente">
        <view type="form" name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="show-confirm" value="false"/>
        <context name="_centroId" expr="eval: centro?.id ?: id"/>
        <context name="_hayQueElegirCentro"
                 expr="eval: hayQueElegirCentro == null ? __parent__?.hayQueElegirCentro : hayQueElegirCentro"/>
    </action-view>

    <!-- Form invisible: solo existe para que su onNew calcule los trámites candidatos y
         abra directamente el tree de sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente
         (mismo patrón "paso fantasma" que usa ElegirCentro cuando hay un único centro candidato).
         El botón Cancelar es la vía de escape si el cálculo falla antes de llegar a abrir el tree. -->
    <form name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-form"
          title="Nuevo expediente: elija el trámite"
          model="com.educaflow.system.ventanilla.db.AsistenteNuevoExpediente"
          onNew="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">

        <panel name="estadoPanel" title="" colSpan="12" showFrame="false">
            <field name="centro" hidden="true"/>
            <field name="hayQueElegirCentro" hidden="true"/>
            <field name="tramitesDisponibles" hidden="true"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancelar" title="Cancelar" colSpan="2" colOffset="10" outline="true"
                    onClick="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-btnCancelar-action"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-btnCancelar-action">
        <action name="close"/>
    </action-group>

    <action-group name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-onNew-action">
        <action name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-set-centroYHayQueElegirCentro-recibidos-action"/>
        <action name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-Remote-prepararTramites-action"/>
        <action name="sysVentanilla.ElegirTramiteTree@AsistenteNuevoExpediente-action"/>
        <action name="close"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>
    <action-record name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-set-centroYHayQueElegirCentro-recibidos-action"
                   model="com.educaflow.system.ventanilla.db.AsistenteNuevoExpediente">
        <field name="centro" expr="eval: __repo__(com.educaflow.subsystem.common.db.Centro).find(_centroId)"/>
        <field name="hayQueElegirCentro" expr="eval: _hayQueElegirCentro"/>
    </action-record>

    <?sv-remotes?>
    <action-method name="sysVentanilla.ElegirTramite@AsistenteNuevoExpediente-Remote-prepararTramites-action"
                   model="com.educaflow.system.ventanilla.db.AsistenteNuevoExpediente">
        <call class="com.educaflow.system.ventanilla.controller.AsistenteNuevoExpedienteController"
              method="prepararTramites"/>
    </action-method>

</object-views>
