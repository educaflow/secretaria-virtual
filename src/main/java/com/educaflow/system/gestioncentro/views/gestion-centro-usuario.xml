<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <grid name="sysGestionCentro.CentroUsuario@Main-grid" title=""
          model="com.educaflow.subsystem.importacion.db.TareaImportacion"
          canNew="true" canDelete="false" canEdit="false" canSave="false"
          allowSearchFields="true" orderBy="-createdOn"
          canViewOnClick="true" canAdvanceSearch="false" canRefresh="false"
          editable="false" edit-icon="false" x-selector="none">
        <field name="usuario.dni"       title="DNI"/>
        <field name="usuario.nombre"    title="Nombre"/>
        <field name="usuario.apellidos" title="Apellidos"/>
    </grid>

    <form name="sysGestionCentro.CentroUsuario@Edit-form" title="Usuario"
          model="com.educaflow.subsystem.security.db.CentroUsuario"
          width="large" canAttach="false">
        <panel title="">
            <field name="centro"  showIf="false"/>
            <field name="usuario" colSpan="12" readonly="true"/>
        </panel>
        <panel-related field="centroUsuarioTipoUsuario" title="Tipos" colSpan="12"
                       canNew="true" canDelete="true"
                       form-view="sysGestionCentro.CentroUsuarioTipoUsuario@Edit-form">
            <field name="tipoUsuario"/>
        </panel-related>
    </form>

    <form name="sysGestionCentro.CentroUsuarioTipoUsuario@Edit-form" title="Tipo"
          model="com.educaflow.subsystem.security.db.CentroUsuarioTipoUsuario"
          onNew="sysGestionCentro.CentroUsuarioTipoUsuario@OnNew-action"
          canAttach="false">
        <panel title="">
            <field name="centroUsuario" showIf="false"/>
            <field name="tipoUsuario"   colSpan="12" required="true"/>
        </panel>
    </form>

    <action-record name="sysGestionCentro.CentroUsuarioTipoUsuario@OnNew-action"
                   model="com.educaflow.subsystem.security.db.CentroUsuarioTipoUsuario">
        <field name="centroUsuario" expr="eval: __parent__"/>
    </action-record>

</object-views>