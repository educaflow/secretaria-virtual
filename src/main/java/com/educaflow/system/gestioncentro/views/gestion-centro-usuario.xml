<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="sysGestion.Main@UsuarioRegistrado-action" title="Usuarios registrados"
                 model="com.educaflow.subsystem.common.db.CentroUsuario">
        <view type="grid" name="sysGestion.Main@UsuarioRegistrado-grid"/>
        <domain>self.centro = :centroActivo</domain>
        <context name="centroActivo" expr="eval: __user__?.centroActivo"/>
    </action-view>

    <grid name="sysGestionCentro.Main@CentroUsuario-grid" title=""
          model="com.educaflow.subsystem.common.db.CentroUsuario"
          canNew="true" newButtonTitle="Añadir usuario" canDelete="false" canEdit="false" canSave="false"
          allowSearchFields="true"
          canViewOnClick="true" canAdvanceSearch="false" canRefresh="false"
          editable="false" edit-icon="false" x-selector="none">
        <field name="usuario.dni"       title="DNI"/>
        <field name="usuario.nombre"    title="Nombre"/>
        <field name="usuario.apellidos" title="Apellidos"/>
    </grid>

    <grid name="sysGestionCentro.Main@CentroUsuario.CentroUsuarioTipoUsuario-grid" title=""
          model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
          canNew="false" canDelete="true" canEdit="false" canSave="false"
          editable="false" edit-icon="false" x-selector="none">
        <field name="tipoUsuario" title="Tipo de usuario"/>
    </grid>

    <grid name="sysGestion.Main@UsuarioRegistrado-grid" title="Usuarios registrados"
          model="com.educaflow.subsystem.common.db.CentroUsuario"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="false">
        <field name="usuario.dni"       title="DNI"/>
        <field name="usuario.nombre"    title="Nombre"/>
        <field name="usuario.apellidos" title="Apellidos"/>
        <field name="usuario.email"     title="Correo electrónico"/>
    </grid>

    <form name="sysGestionCentro.Edit@CentroUsuario-form" title="Usuario"
          model="com.educaflow.subsystem.common.db.CentroUsuario"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="centroUsuarioDatosPanel" title="">
            <field name="centro"  showIf="false"/>
            <field name="usuario" colSpan="12" readonly="true"/>
        </panel>
        <panel-related name="centroUsuarioTipoUsuario" field="centroUsuarioTipoUsuario" title="Tipos de usuario" colSpan="12"
                       newButtonTitle="Añadir nuevo tipo de usuario"
                       grid-view="sysGestionCentro.Main@CentroUsuario.CentroUsuarioTipoUsuario-grid"
                       form-view="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-form"
                       showFooter="false" canEdit="false" canRemove="true" forceEdit="true"
                       canNew="true" canDelete="true"/>
        <panel name="centroUsuarioButtonsPanel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="close"       colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Guardar"  onClick="save,close"  colSpan="2"/>
        </panel>
    </form>

    <form name="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-form" title="Tipo de usuario"
          model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario"
          onNew="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="tipoUsuarioDatosPanel" title="">
            <field name="centroUsuario" showIf="false"/>
            <field name="tipoUsuario"   colSpan="12" required="true"/>
        </panel>
        <panel name="tipoUsuarioButtonsPanel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="close"                                                  colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Guardar"  onClick="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-btnSave-action" colSpan="2"/>
        </panel>
    </form>


    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de las tareas principales ****************************  -->
    <!-- *********************************************************************************************  -->

    <action-group name="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-btnSave-action">
        <action name="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-Local-validateSave-action"/>
        <action name="save"/>
        <action name="close"/>
    </action-group>


    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de Validaciones en local  ****************************  -->
    <!-- *********************************************************************************************  -->

    <action-validate name="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-Local-validateSave-action">
        <error message="Este tipo de usuario ya está asignado a este usuario en este centro"
               if="__parent__?.centroUsuarioTipoUsuario?.any { t -> t.tipoUsuario?.id == tipoUsuario?.id &amp;&amp; t.id != id }"/>
    </action-validate>


    <!-- *********************************************************************************************  -->
    <!-- ************************ Acciones básicas que cambian campos simples ************************  -->
    <!-- *********************************************************************************************  -->

    <action-record name="sysGestionCentro.Edit@CentroUsuarioTipoUsuario-onNew-action"
                   model="com.educaflow.subsystem.common.db.CentroUsuarioTipoUsuario">
        <field name="centroUsuario" expr="eval: __parent__"/>
    </action-record>

</object-views>