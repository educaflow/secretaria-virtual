<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <action-view name="sysGestion.Main@CentroAdmin-action" title="Mi Centro" model="com.educaflow.subsystem.common.db.Centro">
        <view type="form" name="sysGestionCentro.Main@Centro-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="show-toolbar-form" value="false"/>
        <context name="_showRecord" expr="eval: __user__?.centroActivo?.id"/>
    </action-view>

    <form name="sysGestionCentro.Main@Centro-form" title="Centro" model="com.educaflow.subsystem.common.db.Centro"
          onNew="sysGestionCentro.DatosOnNew@Centro-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="datosCentroPanel" title="Datos">
                <field name="code"         colSpan="3" required="true"/>
                <field name="name"         colSpan="6" required="true"/>
                <field name="curso"        colSpan="3" readonly="true"/>
                <field name="direccion"    colSpan="9"/>
                <field name="codigoPostal" colSpan="3"/>
                <field name="comunidadAutonoma" colSpan="4"
                       onChange="sysGestionCentro.OnChangeComunidadAutonoma@Centro-action"/>
                <field name="provincia" colSpan="4"
                       domain="self.comunidadAutonoma = :comunidadAutonoma"
                       onChange="sysGestionCentro.OnChangeProvincia@Centro-action"/>
                <field name="municipio"   colSpan="4" domain="self.provincia = :provincia"/>
                <field name="conselleria" colSpan="6"/>
            </panel>
            <panel name="cargosCentroPanel" title="Cargos">
                <!--
                <field name="director"       colSpan="6" readonly="true"/>
                <field name="vicedirector"   colSpan="6" readonly="true"/>
                <field name="secretario"     colSpan="6" readonly="true"/>
                <field name="vicesecretario" colSpan="6" readonly="true"/>
                -->
                <panel-related name="administradores" field="usuarios" title="Administradores"
                               domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'ADMINISTRADOR')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false"
                               canRemove="false" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
                <panel-related name="jefesEstudio" field="usuarios" title="Jefes de estudio"
                               domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'JEFE_ESTUDIOS')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false"
                               canRemove="false" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
            </panel>
            <panel-related name="profesores" title="Profesores" field="usuarios" colSpan="12"
                           grid-view="sysGestionCentro.Main@CentroUsuario-grid"
                           form-view="sysGestionCentro.Edit@CentroUsuario-form"
                           domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'PROFESOR')"
                           showFooter="false" canEdit="false" canRemove="false" forceEdit="true" canSearch="true"/>
            <panel-related name="alumnos" title="Alumnos" field="usuarios" colSpan="12"
                           grid-view="sysGestionCentro.Main@CentroUsuario-grid"
                           form-view="sysGestionCentro.Edit@CentroUsuario-form"
                           domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'ALUMNO')"
                           showFooter="false" canEdit="false" canRemove="false" forceEdit="true" canSearch="true"/>
            <panel name="cambioCursoPanel" title="Cambio de curso" showTitle="false" colSpan="12">
                <panel-dashlet action="sysGestionCentro.Main@ViewGestionCentroCambioCurso-action" colSpan="12"/>
            </panel>
        </panel-tabs>

        <panel name="buttonsPanel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="back"       colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Guardar"  onClick="save,back"  colSpan="2"/>
        </panel>
    </form>


    <grid name="sysGestionCentro.Main@TareaImportacion-grid" title="Tareas de importación"
          model="com.educaflow.subsystem.importacion.db.TareaImportacion"
          canNew="true" newButtonTitle="Importar nuevos datos"
          orderBy="-createdOn"
          canDelete="false" canSave="false" canEdit="false"
          canEditOnClick="true">
        <field name="tipoFichero" width="180px"/>
        <field name="curso" width="130px"/>
        <field name="usuario" width="180px"/>
        <field name="fichero" widget="binary-link"/>
        <field name="createdOn" title="Fecha de importación" width="160px"/>
    </grid>

    <form name="sysGestionCentro.Main@TareaImportacion-form" title="Importar fichero"
          model="com.educaflow.subsystem.importacion.db.TareaImportacion"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="importacionDatosPanel" title="" colSpan="12">
            <field name="tipoFichero" colSpan="6" widget="SwitchSelect" required="true"
                   selection-in="['PROFESORES', 'ALUMNOS', 'FAMILIARES']"/>
            <field name="fichero" colSpan="6" required="true" widget="binary-link"/>
        </panel>
        <panel name="importacionButtonsPanel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="back"       colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Importar"  onClick="save,back" colSpan="2"/>
        </panel>
    </form>

    <action-view name="sysGestion.Main@Importacion-action" title="Ficheros de importación"
                 model="com.educaflow.subsystem.importacion.db.TareaImportacion">
        <view type="grid" name="sysGestionCentro.Main@TareaImportacion-grid"/>
        <view type="form" name="sysGestion.Menu@TareaImportacion-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.centro = :centroActivo</domain>
        <context name="centroActivo" expr="eval: __user__?.centroActivo"/>
    </action-view>

    <form name="sysGestion.Menu@TareaImportacion-form" title="Importar fichero"
          model="com.educaflow.subsystem.importacion.db.TareaImportacion"
          onNew="sysGestion.OnNew@TareaImportacion-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="importacionMenuDatosPanel" title="" colSpan="12">
            <field name="tipoFichero" colSpan="6" widget="SwitchSelect" required="true"
                   selection-in="['PROFESORES', 'ALUMNOS', 'FAMILIARES']"/>
            <field name="fichero" colSpan="6" required="true" widget="binary-link"/>
        </panel>
        <panel name="importacionMenuButtonsPanel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="back"       colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Importar"  onClick="save,back" colSpan="2"/>
        </panel>
    </form>

    <action-record name="sysGestion.OnNew@TareaImportacion-action"
                   model="com.educaflow.subsystem.importacion.db.TareaImportacion">
        <field name="centro" expr="eval: __user__?.centroActivo"/>
    </action-record>

</object-views>