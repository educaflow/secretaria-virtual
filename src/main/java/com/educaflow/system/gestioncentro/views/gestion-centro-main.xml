<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- «Mi centro»: los centros de los que el usuario es supervisor. Primero un grid, aunque lo normal es
         que sea uno solo, porque puede ser supervisor de varios. -->
    <?sv-view?>
    <action-view name="sysGestionCentro.Main@Centro-action" title="Mi centro" model="com.educaflow.subsystem.common.db.Centro">
        <view type="grid" name="sysGestionCentro.Main@Centro-grid"/>
        <view type="form" name="sysGestionCentro.Main@Centro-form"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.id IN (SELECT cu.centro.id FROM CentroUsuario cu JOIN cu.centroUsuarioTipoUsuario cut WHERE cu.usuario.id = :usuarioId AND cut.tipoUsuario.codigo = 'SUPERVISOR')</domain>
        <context name="usuarioId" expr="eval: __user__?.id"/>
    </action-view>

    <grid name="sysGestionCentro.Main@Centro-grid" title="" model="com.educaflow.subsystem.common.db.Centro"
          orderBy="name" canNew="false"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="true"
          editable="false" edit-icon="false" x-selector="none" canEdit="false" canDelete="false" canSave="false"
          canEditOnClick="true">
        <field name="code" width="200px"/>
        <field name="name"/>
        <field name="curso"/>
    </grid>

    <form name="sysGestionCentro.Main@Centro-form" title="Centro" model="com.educaflow.subsystem.common.db.Centro"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel-tabs>
            <panel name="datosCentroPanel" title="Datos">
                <field name="code"         colSpan="3" required="true"/>
                <field name="name"         colSpan="6" required="true"/>
                <field name="curso"        colSpan="3" readonly="true"/>
                <field name="direccion"    colSpan="9"/>
                <field name="codigoPostal" colSpan="3"/>
                <field name="comunidadAutonoma" colSpan="4"
                       onChange="sysGestionCentro.Main@Centro-onChange-comunidadAutonoma-action"/>
                <field name="provincia" colSpan="4"
                       domain="self.comunidadAutonoma = :comunidadAutonoma"
                       onChange="sysGestionCentro.Main@Centro-onChange-provincia-action"/>
                <field name="municipio"   colSpan="4" domain="self.provincia = :provincia"/>
                <field name="conselleria" colSpan="6"/>
            </panel>
            <!-- Los cargos son filas de CentroUsuarioCargo (Cargo.code), no tipos de usuario: un panel por
                 cargo, de solo consulta. Se asignan desde «Usuarios» (pestaña Cargos de cada usuario). -->
            <panel name="cargosCentroPanel" title="Cargos">
                <panel-related name="director" field="usuarios" title="Director"
                               domain="self.id IN (SELECT c.centroUsuario.id FROM CentroUsuarioCargo c WHERE c.cargo.code = 'DIRECTOR')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
                <panel-related name="vicedirector" field="usuarios" title="Vicedirector"
                               domain="self.id IN (SELECT c.centroUsuario.id FROM CentroUsuarioCargo c WHERE c.cargo.code = 'VICEDIRECTOR')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
                <panel-related name="secretario" field="usuarios" title="Secretario"
                               domain="self.id IN (SELECT c.centroUsuario.id FROM CentroUsuarioCargo c WHERE c.cargo.code = 'SECRETARIO')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
                <panel-related name="vicesecretario" field="usuarios" title="Vicesecretario"
                               domain="self.id IN (SELECT c.centroUsuario.id FROM CentroUsuarioCargo c WHERE c.cargo.code = 'VICESECRETARIO')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
                <panel-related name="jefesEstudio" field="usuarios" title="Jefes de estudio"
                               domain="self.id IN (SELECT c.centroUsuario.id FROM CentroUsuarioCargo c WHERE c.cargo.code = 'JEFE_ESTUDIOS')"
                               x-selector="none" colSpan="12" showFooter="false"
                               edit-icon="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canViewOnClick="false">
                    <field name="usuario.nombre"    title="Nombre"/>
                    <field name="usuario.apellidos" title="Apellidos"/>
                </panel-related>
            </panel>
            <panel-related name="profesores" title="Profesores" field="usuarios" colSpan="12"
                           grid-view="sysGestionCentro.Main@CentroUsuario-grid"
                           form-view="sysGestionCentro.Main@Centro.CentroUsuario-form"
                           domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'PROFESOR')"
                           showFooter="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canSearch="true"/>
            <panel-related name="alumnos" title="Alumnos" field="usuarios" colSpan="12"
                           grid-view="sysGestionCentro.Main@CentroUsuario-grid"
                           form-view="sysGestionCentro.Main@Centro.CentroUsuario-form"
                           domain="self.id IN (SELECT t.centroUsuario.id FROM CentroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'ALUMNO')"
                           showFooter="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true" canSearch="true"/>
        </panel-tabs>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="sysGestionCentro.Main@Centro-btnCancel-action" colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Guardar"  onClick="sysGestionCentro.Main@Centro-btnSave-action"   colSpan="2"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="sysGestionCentro.Main@Centro-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="sysGestionCentro.Main@Centro-btnSave-action">
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="force-back"/>
    </action-group>

    <action-group name="sysGestionCentro.Main@Centro-onChange-comunidadAutonoma-action">
        <action name="sysGestionCentro.Main@Centro-set-provincia-null-action"/>
    </action-group>
    <action-group name="sysGestionCentro.Main@Centro-onChange-provincia-action">
        <action name="sysGestionCentro.Main@Centro-set-municipio-null-action"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>
    <action-record name="sysGestionCentro.Main@Centro-set-provincia-null-action" model="com.educaflow.subsystem.common.db.Centro">
        <field name="provincia" expr="eval: null"/>
        <field name="municipio" expr="eval: null"/>
    </action-record>
    <action-record name="sysGestionCentro.Main@Centro-set-municipio-null-action" model="com.educaflow.subsystem.common.db.Centro">
        <field name="municipio" expr="eval: null"/>
    </action-record>

    <?sv-remotes?>

    <!-- El usuario tal y como se edita desde las pestañas Profesores/Alumnos del centro (modal). -->
    <?sv-view?>
    <form name="sysGestionCentro.Main@Centro.CentroUsuario-form" title="Usuario"
          model="com.educaflow.subsystem.common.db.CentroUsuario"
          onNew="sysGestionCentro.Main@Centro.CentroUsuario-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="centroUsuarioDatosPanel" title="">
            <field name="centro"  showIf="false"/>
            <field name="usuario" colSpan="12" readonly="true"/>
        </panel>
        <panel-related name="centroUsuarioTipoUsuario" field="centroUsuarioTipoUsuario" title="Tipos de usuario" colSpan="12"
                       newButtonTitle="Añadir tipo de usuario"
                       grid-view="subsysCommon.Main@CentroUsuario.CentroUsuarioTipoUsuario-grid"
                       form-view="subsysCommon.Main@CentroUsuario.CentroUsuarioTipoUsuario-form"
                       showFooter="false" canEdit="false" canRemove="false" forceEdit="true"/>
        <panel-related name="centroUsuarioCargo" field="centroUsuarioCargo" title="Cargos" colSpan="12"
                       newButtonTitle="Añadir cargo"
                       grid-view="subsysCommon.Main@CentroUsuario.CentroUsuarioCargo-grid"
                       form-view="subsysCommon.Main@CentroUsuario.CentroUsuarioCargo-form"
                       showFooter="false" canEdit="false" canRemove="false" forceEdit="true"/>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="sysGestionCentro.Main@Centro.CentroUsuario-btnCancel-action" colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave"   title="Guardar"  onClick="sysGestionCentro.Main@Centro.CentroUsuario-btnSave-action"   colSpan="2"/>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="sysGestionCentro.Main@Centro.CentroUsuario-btnCancel-action">
        <action name="close"/>
    </action-group>
    <action-group name="sysGestionCentro.Main@Centro.CentroUsuario-btnSave-action">
        <action name="save-modal"/>
    </action-group>

    <action-group name="sysGestionCentro.Main@Centro.CentroUsuario-onNew-action">
        <action name="sysGestionCentro.Main@Centro.CentroUsuario-set-centro-parent-action"/>
    </action-group>

    <?sv-validations?>

    <?sv-rules?>
    <action-record name="sysGestionCentro.Main@Centro.CentroUsuario-set-centro-parent-action" model="com.educaflow.subsystem.common.db.CentroUsuario">
        <field name="centro" expr="eval: __parent__"/>
    </action-record>

    <?sv-remotes?>

</object-views>
