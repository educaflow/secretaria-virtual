<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="gruposnotas" package="com.educaflow.system.gruposnotas.db"/>

    <entity name="Grupo" repository="abstract">
        <string name="nombre" title="Nombre" namecolumn="true" required="true"/>
        <many-to-one name="curso" ref="com.educaflow.subsystem.sistemaeducativo.db.Curso" title="Curso" required="true"/>
        <integer name="cursoAcademico" title="Curso académico" help="Ejemplo: 2024" required="true"/>
        <many-to-one name="centro" ref="com.educaflow.subsystem.common.db.Centro" title="Centro" required="true"/>
        <enum name="estado" ref="EstadoGrupo" title="Estado" required="true"/>
        <datetime name="fechaCierre" title="Fecha de cierre"/>

        <!-- Composición: el Grupo es el propietario del ciclo de vida de sus ModuloGrupo y AlumnoGrupo;
             al borrar el grupo se borran (cascade="all") y, al quitarlos de la colección, se eliminan
             como huérfanos (orphanRemoval="true"). El borrado de un AlumnoGrupo arrastra a su vez sus
             Notas vía AlumnoGrupo.notas (orphanRemoval). -->
        <one-to-many name="modulosGrupo" ref="com.educaflow.system.gruposnotas.db.ModuloGrupo" mappedBy="grupo" title="Módulos del grupo" cascade="all" orphanRemoval="true"/>
        <one-to-many name="alumnosGrupo" ref="com.educaflow.system.gruposnotas.db.AlumnoGrupo" mappedBy="grupo" title="Alumnos del grupo" cascade="all" orphanRemoval="true"/>

        <unique-constraint columns="nombre,centro,cursoAcademico"/>

        <finder-method name="findByNombreCentroCursoAcademico"
                       using="String:nombre,com.educaflow.subsystem.common.db.Centro:centro,Integer:cursoAcademico"
                       filter="self.nombre = :nombre AND self.centro = :centro AND self.cursoAcademico = :cursoAcademico"/>
    </entity>

    <enum name="EstadoGrupo">
        <item name="ABIERTO" title="Abierto"/>
        <item name="CERRADO" title="Cerrado"/>
    </enum>

</domain-models>
