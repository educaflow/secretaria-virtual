<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="gruposnotas" package="com.educaflow.system.gruposnotas.db"/>

    <entity name="Nota" repository="abstract">
        <many-to-one name="moduloGrupo" ref="com.educaflow.system.gruposnotas.db.ModuloGrupo" title="Módulo del grupo" required="true"/>
        <many-to-one name="alumnoGrupo" ref="com.educaflow.system.gruposnotas.db.AlumnoGrupo" title="Alumno del grupo" required="true"/>
        <enum name="valor" ref="ValorNota" title="Valor" required="true"/>
        <datetime name="fechaCalificacion" title="Fecha de calificación"/>
        <datetime name="fechaUltimaModificacion" title="Fecha de última modificación"/>

        <unique-constraint columns="moduloGrupo,alumnoGrupo"/>
    </entity>

    <enum name="ValorNota">
        <item name="NO_EVALUADO" title="No evaluado"/>
        <item name="NOTA_01" title="1"/>
        <item name="NOTA_02" title="2"/>
        <item name="NOTA_03" title="3"/>
        <item name="NOTA_04" title="4"/>
        <item name="NOTA_05" title="5"/>
        <item name="NOTA_06" title="6"/>
        <item name="NOTA_07" title="7"/>
        <item name="NOTA_08" title="8"/>
        <item name="NOTA_09" title="9"/>
        <item name="NOTA_10" title="10"/>
        <item name="MATRICULA_HONOR" title="Matrícula de Honor"/>
    </enum>

</domain-models>
