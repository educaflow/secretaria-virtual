<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- Porción a fusionar en el fichero único src/main/java/com/educaflow/secretariavirtual/menus/menus.xml -->
    <!-- Estas tres líneas YA están presentes en el menús del proyecto: la fusión es idempotente. -->

    <!-- Notas → Grupos (pantalla del supervisor): visible si el usuario es SUPERVISOR -->
    <menuitem name="notas-menuitem" title="Notas" order="35" if="__user__?.tiposUsuarioActivos?.any { it.codigo == 'SUPERVISOR' }"/>
    <menuitem name="notas-grupos-menuitem" parent="notas-menuitem" title="Grupos" action="sysGruposNotas.Grupo@Supervisor-action" if="__user__?.tiposUsuarioActivos?.any { it.codigo == 'SUPERVISOR' }" order="1"/>

    <!-- Mis notas (pantalla del alumno): visible si el usuario es ALUMNO -->
    <menuitem name="misNotas-menuitem" title="Mis notas" order="36" action="sysGruposNotas.AlumnoGrupo@MisNotas-action" if="__user__?.tiposUsuarioActivos?.any { it.codigo == 'ALUMNO' }"/>

    <!-- Administración SV → Grupos (administración): visible para el grupo 'admins' -->
    <menuitem name="administracionSv-grupos-menuitem" parent="administracionSv-menuitem" title="Grupos (administración)" action="sysGruposNotas.Grupo@Administracion-action" groups="admins" order="20"/>

</object-views>
