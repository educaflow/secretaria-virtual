<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- ******************************************************************************** -->
    <!-- ****************************** Grupo : Vistas (Supervisor) ********************* -->
    <!-- ******************************************************************************** -->

    <action-view name="sysGruposNotas.Grupo@Supervisor-action" title="Grupos" model="com.educaflow.system.gruposnotas.db.Grupo">
        <view type="grid" name="sysGruposNotas.Grupo@Supervisor-grid"/>
        <view type="form" name="sysGruposNotas.Grupo@Supervisor-form"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
        <!-- Multi-centro: el supervisor solo ve los grupos de su centro activo (ESC-021). -->
        <domain>self.centro = :centroActivoUsuario</domain>
        <context name="centroActivoUsuario" expr="eval: __user__?.centroActivo"/>
    </action-view>

    <grid name="sysGruposNotas.Grupo@Supervisor-grid" title="" model="com.educaflow.system.gruposnotas.db.Grupo"
          orderBy="nombre" canNew="true" newButtonTitle="Nuevo grupo"
          canRefresh="false" canAdvanceSearch="false" allowSearchFields="true"
          editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true">
        <field name="cursoAcademico" width="130px"/>
        <field name="curso.ciclo" title="Ciclo"/>
        <field name="nombre"/>
        <field name="estado" width="120px"/>
    </grid>

    <form name="sysGruposNotas.Grupo@Supervisor-form" title="Grupo" model="com.educaflow.system.gruposnotas.db.Grupo"
          onNew="sysGruposNotas.Grupo@Supervisor-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">
        <panel name="Grupo" title="Datos del grupo" readonlyIf="estado == 'CERRADO'">
            <field name="nombre" colSpan="6"/>
            <field name="estado" colSpan="3" readonly="true"/>
            <field name="curso" colSpan="6" readonlyIf="id != null"
                   grid-view="subsysSistemaEducativo.Curso@Search-grid" form-view="subsysSistemaEducativo.Curso@View-form"/>
            <field name="centro" colSpan="6" readonly="true"/>
            <field name="cursoAcademico" colSpan="3" readonly="true"/>
            <field name="fechaCierre" colSpan="3" readonly="true"/>
        </panel>

        <panel-related name="modulosGrupo" field="modulosGrupo" title="Módulos"
                       grid-view="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-grid"
                       form-view="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-form"
                       colSpan="12" newButtonTitle=""
                       showFooter="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true"/>

        <panel-related name="alumnosGrupo" field="alumnosGrupo" title="Alumnos"
                       grid-view="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-grid"
                       form-view="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-form"
                       colSpan="12" newButtonTitle="Añadir alumno"
                       showFooter="false" canEdit="false" canRemove="true" forceEdit="true"/>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnDelete" title="Borrar" onClick="sysGruposNotas.Grupo@Supervisor-btnDelete-action"
                    css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
            <button name="btnCerrarGrupo" title="Cerrar grupo" onClick="sysGruposNotas.Grupo@Supervisor-btnCerrarGrupo-action"
                    colSpan="2" showIf="id != null &amp;&amp; estado == 'ABIERTO'"/>
            <button name="btnCancel" title="Cancelar" onClick="sysGruposNotas.Grupo@Supervisor-btnCancel-action"
                    colSpan="2" colOffset="4" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="sysGruposNotas.Grupo@Supervisor-btnSave-action"
                    colSpan="2"/>
        </panel>
    </form>

    <!-- *************** Grupo : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.Grupo@Supervisor-btnDelete-action">
        <action name="delete"/>
    </action-group>
    <action-group name="sysGruposNotas.Grupo@Supervisor-btnCerrarGrupo-action">
        <action name="sysGruposNotas.Grupo@Supervisor-Remote-cerrarGrupo-action"/>
    </action-group>
    <action-group name="sysGruposNotas.Grupo@Supervisor-btnCancel-action">
        <action name="back"/>
    </action-group>
    <action-group name="sysGruposNotas.Grupo@Supervisor-btnSave-action">
        <action name="save"/>
    </action-group>

    <action-group name="sysGruposNotas.Grupo@Supervisor-onNew-action">
        <action name="sysGruposNotas.Grupo@Supervisor-set-defaults-action"/>
    </action-group>

    <!-- *************** Grupo : Acciones de Validaciones en local *************** -->

    <!-- *************** Grupo : Acciones básicas que cambian campos simples *************** -->
    <!-- RUI-001/RUI-002: al crear, centro y curso académico se rellenan con los del centro del usuario y quedan en solo lectura. El servidor (RN-002) los reasigna de forma incondicional como defensa. -->
    <action-record name="sysGruposNotas.Grupo@Supervisor-set-defaults-action" model="com.educaflow.system.gruposnotas.db.Grupo">
        <field name="centro" expr="eval: __user__?.centroActivo"/>
        <field name="cursoAcademico" expr="eval: __user__?.centroActivo?.curso"/>
    </action-record>

    <!-- *************** Grupo : Acciones de llamadas Remotas al servidor *************** -->
    <action-method name="sysGruposNotas.Grupo@Supervisor-Remote-cerrarGrupo-action" model="com.educaflow.system.gruposnotas.db.Grupo">
        <call class="com.educaflow.system.gruposnotas.controller.GrupoController" method="cerrarGrupo"/>
    </action-method>


    <!-- ************************************************************************************************ -->
    <!-- ****************************** Grupo.ModuloGrupo : Vistas (Supervisor) ************************* -->
    <!-- ************************************************************************************************ -->

    <grid name="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-grid" title="" model="com.educaflow.system.gruposnotas.db.ModuloGrupo"
          orderBy="modulo.name"
          canRefresh="false" canAdvanceSearch="false"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true">
        <field name="modulo"/>
    </grid>

    <form name="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-form" title="Módulo del grupo" model="com.educaflow.system.gruposnotas.db.ModuloGrupo"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="ModuloGrupo" title="Módulo">
            <field name="modulo" colSpan="6" readonly="true"/>
        </panel>

        <panel-related name="notas" field="notas" title="Notas"
                       grid-view="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-grid"
                       form-view="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-form"
                       colSpan="12" newButtonTitle=""
                       showFooter="false" canNew="false" canEdit="false" canRemove="false" forceEdit="true"/>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cerrar" onClick="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-btnCancel-action"
                    colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <!-- *************** Grupo.ModuloGrupo : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.Grupo.ModuloGrupo@Supervisor-btnCancel-action">
        <action name="close"/>
    </action-group>

    <!-- *************** Grupo.ModuloGrupo : Acciones de Validaciones en local *************** -->

    <!-- *************** Grupo.ModuloGrupo : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** Grupo.ModuloGrupo : Acciones de llamadas Remotas al servidor *************** -->


    <!-- ******************************************************************************************************** -->
    <!-- ****************************** Grupo.ModuloGrupo.Nota : Vistas (Supervisor) *************************** -->
    <!-- ******************************************************************************************************** -->

    <grid name="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-grid" title="" model="com.educaflow.system.gruposnotas.db.Nota"
          orderBy="alumnoGrupo.alumno.name"
          canRefresh="false" canAdvanceSearch="false"
          editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true">
        <field name="alumnoGrupo.alumno" title="Alumno"/>
        <field name="valor" width="160px"/>
        <field name="fechaCalificacion" width="170px"/>
        <field name="fechaUltimaModificacion" width="190px"/>
    </grid>

    <form name="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-form" title="Nota" model="com.educaflow.system.gruposnotas.db.Nota"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Nota" title="Nota">
            <field name="alumnoGrupo" colSpan="6" readonly="true" title="Alumno"/>
            <field name="moduloGrupo" colSpan="6" readonly="true" title="Módulo"/>
            <!-- RUI-005: el valor solo es editable cuando el grupo está ABIERTO. -->
            <field name="valor" colSpan="6" readonlyIf="moduloGrupo.grupo.estado == 'CERRADO'"/>
            <field name="fechaCalificacion" colSpan="3" readonly="true"/>
            <field name="fechaUltimaModificacion" colSpan="3" readonly="true"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-btnCancel-action"
                    colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-btnSave-action"
                    colSpan="2"/>
        </panel>
    </form>

    <!-- *************** Grupo.ModuloGrupo.Nota : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-btnCancel-action">
        <action name="close"/>
    </action-group>
    <action-group name="sysGruposNotas.Grupo.ModuloGrupo.Nota@Supervisor-btnSave-action">
        <action name="save-modal"/>
    </action-group>

    <!-- *************** Grupo.ModuloGrupo.Nota : Acciones de Validaciones en local *************** -->

    <!-- *************** Grupo.ModuloGrupo.Nota : Acciones básicas que cambian campos simples *************** -->

    <!-- *************** Grupo.ModuloGrupo.Nota : Acciones de llamadas Remotas al servidor *************** -->


    <!-- ********************************************************************************************** -->
    <!-- ****************************** Grupo.AlumnoGrupo : Vistas (Supervisor) *********************** -->
    <!-- ********************************************************************************************** -->

    <grid name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-grid" title="" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo"
          orderBy="alumno.name"
          canRefresh="false" canAdvanceSearch="false"
          editable="false" edit-icon="false" x-selector="none"
          canNew="true" canEdit="false" canDelete="false" canSave="false" canEditOnClick="true">
        <field name="alumno"/>
        <field name="notaMedia" title="Nota media"/>
    </grid>

    <form name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-form" title="Alumno del grupo" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo"
          onNew="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-onNew-action"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="AlumnoGrupo" title="Alumno">
            <field name="grupo" showIf="false"/>
            <!-- VAL-012/ESC-020 (UX): el selector ofrece solo usuarios de tipo Alumno del centro del supervisor conectado. La defensa real es VAL-012 en el servidor. -->
            <field name="alumno" colSpan="6" readonlyIf="id != null"
                   domain="self.id IN (SELECT cu.usuario.id FROM CentroUsuario cu JOIN cu.centroUsuarioTipoUsuario t WHERE t.tipoUsuario.codigo = 'ALUMNO' AND cu.centro = (SELECT scu.centro FROM CentroUsuario scu JOIN scu.centroUsuarioTipoUsuario st WHERE scu.usuario = :__user__ AND st.tipoUsuario.codigo = 'SUPERVISOR'))"/>
            <field name="notaMedia" colSpan="3" readonly="true" title="Nota media" showIf="id != null"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-btnCancel-action"
                    colSpan="2" colOffset="8" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-btnSave-action"
                    colSpan="2"/>
        </panel>
    </form>

    <!-- *************** Grupo.AlumnoGrupo : Acciones de las tareas principales *************** -->
    <action-group name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-btnCancel-action">
        <action name="close"/>
    </action-group>
    <action-group name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-btnSave-action">
        <action name="save-modal"/>
    </action-group>

    <action-group name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-onNew-action">
        <action name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-set-grupo-parent-action"/>
    </action-group>

    <!-- *************** Grupo.AlumnoGrupo : Acciones de Validaciones en local *************** -->

    <!-- *************** Grupo.AlumnoGrupo : Acciones básicas que cambian campos simples *************** -->
    <!-- RUI-011: al añadir un alumno, su grupo se fija al grupo padre. -->
    <action-record name="sysGruposNotas.Grupo.AlumnoGrupo@Supervisor-set-grupo-parent-action" model="com.educaflow.system.gruposnotas.db.AlumnoGrupo">
        <field name="grupo" expr="eval: __parent__"/>
    </action-record>

    <!-- *************** Grupo.AlumnoGrupo : Acciones de llamadas Remotas al servidor *************** -->

</object-views>
