<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- Pantalla: Mis notas (alumno). Entrada sobre AlumnoGrupo, filtrada por el alumno conectado (solo ve sus pertenencias). Todo en solo lectura. -->
    <action-view name="sysGrupos.AlumnoGrupo@Alumno-action" title="Mis notas" model="com.educaflow.system.grupos.db.AlumnoGrupo">
        <view type="grid" name="sysGrupos.AlumnoGrupo@Alumno-grid"/>
        <view type="form" name="sysGrupos.AlumnoGrupo@Alumno-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.alumno = :usuarioActual</domain>
        <context name="usuarioActual" expr="eval: __user__"/>
    </action-view>

    <!-- ====================================== GRIDS ====================================== -->

    <grid name="sysGrupos.AlumnoGrupo@Alumno-grid" title="Mis notas" model="com.educaflow.system.grupos.db.AlumnoGrupo"
          orderBy="-grupo.cursoAcademico" allowSearchFields="false" canViewOnClick="true"
          canAdvanceSearch="false" canRefresh="false" editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false">
        <field name="grupo.cursoAcademico" title="Curso académico"/>
        <field name="grupo.curso.ciclo" title="Ciclo"/>
        <field name="grupo.nombre" title="Grupo"/>
        <field name="notaMedia" title="Nota media" width="150px"/>
    </grid>

    <grid name="sysGrupos.AlumnoGrupo.Nota@Alumno-grid" title="Mis notas" model="com.educaflow.system.grupos.db.Nota"
          orderBy="moduloGrupo.modulo.name" allowSearchFields="false" canViewOnClick="true"
          canAdvanceSearch="false" canRefresh="false" editable="false" edit-icon="false" x-selector="none"
          canNew="false" canEdit="false" canDelete="false" canSave="false">
        <field name="moduloGrupo" title="Módulo"/>
        <field name="valorTexto" title="Valor" width="150px"/>
        <field name="fechaCalificacion" width="180px"/>
    </grid>

    <!-- ====================================== FORMS ====================================== -->

    <form name="sysGrupos.AlumnoGrupo@Alumno-form" title="Mi grupo" model="com.educaflow.system.grupos.db.AlumnoGrupo"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" readonlyIf="true">
        <panel name="MiGrupo" title="Mi grupo">
            <field name="grupo.nombre" title="Grupo" colSpan="6"/>
            <field name="grupo.curso" title="Curso" colSpan="6"/>
            <field name="grupo.cursoAcademico" title="Curso académico" colSpan="3"/>
            <field name="notaMedia" title="Nota media" colSpan="3"/>
        </panel>
        <panel-related name="notas" field="notas" title="Mis notas" newButtonTitle=""
                       grid-view="sysGrupos.AlumnoGrupo.Nota@Alumno-grid" form-view="sysGrupos.AlumnoGrupo.Nota@Alumno-form"
                       colSpan="12" showFooter="false" canEdit="false" canRemove="false" canNew="false" forceEdit="true"/>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Volver" onClick="sysGrupos.AlumnoGrupo@Alumno-btnCancel-action" colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <form name="sysGrupos.AlumnoGrupo.Nota@Alumno-form" title="Mi nota" model="com.educaflow.system.grupos.db.Nota"
          width="large" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" readonlyIf="true">
        <panel name="MiNota" title="Mi nota">
            <field name="moduloGrupo" title="Módulo" colSpan="6"/>
            <field name="valorTexto" title="Valor" colSpan="3"/>
            <field name="fechaCalificacion" colSpan="3"/>
            <field name="fechaUltimaModificacion" colSpan="3"/>
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cerrar" onClick="sysGrupos.AlumnoGrupo.Nota@Alumno-btnCancel-action" colSpan="2" colOffset="10" outline="true"/>
        </panel>
    </form>

    <!-- *********************************************************************************************  -->
    <!-- ***************************** Acciones de las tareas principales ****************************  -->
    <!-- *********************************************************************************************  -->

    <action-group name="sysGrupos.AlumnoGrupo@Alumno-btnCancel-action">
        <action name="back"/>
    </action-group>

    <action-group name="sysGrupos.AlumnoGrupo.Nota@Alumno-btnCancel-action">
        <action name="close"/>
    </action-group>

</object-views>
