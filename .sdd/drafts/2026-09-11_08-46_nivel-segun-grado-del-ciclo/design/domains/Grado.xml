<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="sistemaeducativo" package="com.educaflow.subsystem.sistemaeducativo.db"/>
    <entity name="Grado">
        <string name="code"  required="true"  />
        <string name="name" namecolumn="true"  required="true" />
        <!--
          orphanRemoval="false" es OBLIGATORIO y NO es redundante: en una one-to-many BIDIRECCIONAL
          (con mappedBy) el generador de axelor-tools considera orphanRemoval = true cuando el
          atributo no se declara (Property.getOrphanRemoval(), axelor-tools .../entity/model/Property.java),
          y entonces emite @OneToMany(..., cascade = CascadeType.ALL, orphanRemoval = true).
          Eso haría que borrar un grado borrase sus niveles, justo lo que prohíbe la sección
          «Relaciones» de la spec. Declarándolo a false, resolveCascadeTypes vuelve a PERSIST,MERGE,
          no se emite orphanRemoval y, en runtime, Mapper marca la propiedad como `orphan` (orphan =
          !oneToMany.orphanRemoval()), con lo que ModelServiceValidationWalker deja de descender por
          Grado.niveles (solo desciende por las O2M de composición, las que tienen !isOrphan()).
        -->
        <one-to-many name="niveles" ref="com.educaflow.subsystem.sistemaeducativo.db.Nivel" mappedBy="grado" orphanRemoval="false" />
        <!--
          CC-Grado-001 — «admite nivel»: cierto si el grado tiene al menos un nivel NO archivado.
          MUST leerse el CAMPO `niveles` directamente, NUNCA getNiveles(): Mapper.findComputeDependencies
          (axelor-core) recorre el bytecode del compute* y solo registra como dependencia las
          instrucciones GETFIELD; con el getter (INVOKEVIRTUAL) el conjunto de dependencias queda
          vacío y ContextHandler.interceptComputeAccess no poblaría `niveles` sobre un Grado que
          llegue como proxy de Context, devolviendo false sin ningún error.
          Se ignoran los niveles archivados porque el selector de nivel del ciclo
          (domain="self.grado = :grado") tampoco los ofrece: contarlos dejaría un grado con todos sus
          niveles archivados exigiendo un nivel imposible de elegir (ver decisiones.md D7).
        -->
        <boolean name="admiteNivel" transient="true" title="Admite nivel">
            <![CDATA[
                if (niveles == null) {
                    return Boolean.FALSE;
                }
                for (com.educaflow.subsystem.sistemaeducativo.db.Nivel nivel : niveles) {
                    if (Boolean.TRUE.equals(nivel.getArchived()) == false) {
                        return Boolean.TRUE;
                    }
                }
                return Boolean.FALSE;
            ]]>
        </boolean>
    </entity>

</domain-models>
