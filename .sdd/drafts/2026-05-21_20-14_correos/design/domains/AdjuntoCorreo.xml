<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="correos" package="com.educaflow.subsystem.correos.db"/>

    <entity name="AdjuntoCorreo">
        <string      name="nombreFichero" title="Nombre del fichero" required="true"/>          <!-- cliente -->
        <many-to-one name="contenido" ref="com.axelor.meta.db.MetaFile" title="Contenido" required="true"/>  <!-- cliente -->
        <many-to-one name="correo" ref="Correo" title="Correo" required="true"/>                <!-- servidor: lo fija el padre (onNew __parent__) -->
    </entity>

</domain-models>
