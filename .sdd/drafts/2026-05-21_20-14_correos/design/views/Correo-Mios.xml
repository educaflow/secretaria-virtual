<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://axelor.com/xml/ns/object-views
https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- *************************************************************************** -->
    <!-- *************************** Correo Mios : Vistas *********************** -->
    <!-- *************************************************************************** -->

    <action-view name="subsysCorreos.Correo@Mios-action" title="Mis correos"
                 model="com.educaflow.subsystem.correos.db.Correo">
        <view type="grid" name="subsysCorreos.Correo@Mios-grid"/>
        <view type="form" name="subsysCorreos.Correo@Main-form"/>   <!-- detalle solo lectura (form compartido) -->
        <view-param name="show-toolbar-form" value="false"/>
        <domain>self.dniDestinatario = :__user__.dni</domain>       <!-- U-mis-001 (k-secure-coding §4) -->
    </action-view>

    <grid name="subsysCorreos.Correo@Mios-grid" model="com.educaflow.subsystem.correos.db.Correo"
          title="" orderBy="-fechaCreacion" allowSearchFields="true"
          canAdvanceSearch="false" canRefresh="false" canNew="false"
          editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="asunto"/>
        <field name="estado"/>
        <field name="fechaCreacion"/>
        <field name="fechaEnvio"/>
    </grid>

</object-views>
