<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="notificaciones" package="com.educaflow.subsystem.notificaciones.db"/>

    <!-- Notificación cuyo canal es el correo electrónico. Hereda todos los campos de Notificacion -->
    <entity name="Correo" extends="Notificacion">

        <string name="para" title="Para" help="Dirección de correo del destinatario principal (una sola)"/>
        <string name="enCopia" title="En copia" help="Direcciones de correo en copia (el «cc»), separadas por comas"/>
        <string name="enCopiaOculta" title="En copia oculta" help="Direcciones de correo en copia oculta (el «bcc»), separadas por comas"/>

        <!-- Sin max: el límite de 255 lo da CorreoServiceImpl con el mensaje de negocio -->
        <string name="asunto" title="Asunto"/>
        <string name="cuerpo" title="Cuerpo" large="true" multiline="true"/>

        <one-to-many name="adjuntos" ref="Adjunto" mappedBy="correo" title="Adjuntos"/>

        <!-- Tipo explícito en el using: estado es un campo heredado de Notificacion -->
        <finder-method name="findByEstado" using="com.educaflow.subsystem.notificaciones.db.EstadoNotificacion:estado"
                       filter="self.estado = :estado" all="true"/>

        <extra-code-model>
        <![CDATA[
            /** El destino de un correo es la dirección del «para». */
            @Override
            protected String computeDestino() {
                return getPara();
            }
        ]]>
        </extra-code-model>

    </entity>

</domain-models>
