<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!-- Form del correo en «Todas»: alta (desde la elección de canal) y detalle en solo lectura (desde una
         fila del listado común). No tiene <action-view>: lo abre en popup NotificacionController
         (continuarAlta / abrirTodas), así que no hay grid al que volver y sus botones cierran con close. -->
    <?sv-view?>
    <form name="subsysNotificaciones.Main@Correo-form" title="Correo" model="com.educaflow.subsystem.notificaciones.db.Correo"
          width="large" onNew="subsysNotificaciones.Main@Correo-onNew-action"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false" canBackOnSave="true">

        <panel name="Correo" title="Datos del correo" readonlyIf="(id != null) || (cid != null)">
            <field name="tipoNotificacion" colSpan="3" widget="RadioSelect" x-direction="horizontal" readonly="true"/>
            <field name="name" colSpan="9" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="centro" colSpan="4" requiredIf="(id == null) &amp;&amp; (cid == null)"
                   grid-view="subsysCommon.Ref@Centro-grid" form-view="subsysCommon.Ref@Centro-form"
                   onChange="subsysNotificaciones.Main@Correo-onChange-centro-action"/>
            <field name="historialEstado" colSpan="8" domain="self.expediente.centro = :centro"
                   target-name="nameState" canSuggest="false"
                   grid-view="subsysExpedientes.Ref@HistorialEstado-grid" form-view="subsysExpedientes.Ref@HistorialEstado-form"/>
            <field name="dniDestinatario" colSpan="3" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="nombre" colSpan="4" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="apellidos" colSpan="5" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="para" colSpan="4" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="enCopia" colSpan="4"/>
            <field name="enCopiaOculta" colSpan="4"/>
            <field name="asunto" colSpan="10" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
            <field name="cuerpo" colSpan="12" colOffset="2" widget="Text" requiredIf="(id == null) &amp;&amp; (cid == null)"/>
        </panel>

        <!-- En el alta: se añaden y quitan adjuntos en memoria (modal Main@Correo.Adjunto) -->
        <panel-related name="adjuntos" field="adjuntos" title="Adjuntos"
            grid-view="subsysNotificaciones.Main@Correo.Adjunto-grid" form-view="subsysNotificaciones.Main@Correo.Adjunto-form"
            colSpan="12" newButtonTitle="Añadir adjunto" showFooter="false" canEdit="false" canRemove="false" forceEdit="true"
            showIf="(id == null) &amp;&amp; (cid == null)"/>

        <!-- En el detalle: solo consulta y descarga (Ref@Adjunto) -->
        <panel-related name="adjuntosConsulta" field="adjuntos" title="Adjuntos"
            grid-view="subsysNotificaciones.Ref@Adjunto-grid" form-view="subsysNotificaciones.Ref@Adjunto-form"
            colSpan="12" canNew="false" showFooter="false" canEdit="false" canRemove="false" forceEdit="true"
            showIf="(id != null) || (cid != null)"/>

        <panel name="Envio" title="Datos del envío" colSpan="12" readonly="true" showIf="(id != null) || (cid != null)">
            <field name="estado" colSpan="6" widget="RadioSelect" x-direction="horizontal"/>
            <field name="numeroReintentos" colSpan="3" title="Nº reintentos__!!"/>
            <field name="fechaCreacion" colSpan="3"/>
            <field name="fechaPrimerIntentoEnvio" colSpan="3"/>
            <field name="fechaUltimoIntentoEnvio" colSpan="3"/>
            <field name="fechaEnvio" colSpan="3" colOffset="3" showIf="estado == 'ENVIADO'"/>
            <field name="descripcionUltimoFallo" colSpan="12" widget="Text" showIf="estado == 'FALLIDO'"/>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <panel name="buttonsAlta" title="" colSpan="12" showFrame="false"
                   showIf="(id == null) &amp;&amp; (cid == null)">
                <button name="btnCancelAlta" title="Cancelar" onClick="subsysNotificaciones.Main@Correo-btnCancel-action"
                        colSpan="2" colOffset="8" outline="true"/>
                <button name="btnSave" title="Guardar" onClick="subsysNotificaciones.Main@Correo-btnSave-action"
                        colSpan="2"/>
            </panel>
            <panel name="buttonsFallido" title="" colSpan="12" showFrame="false"
                   showIf="((id != null) || (cid != null)) &amp;&amp; (estado == 'FALLIDO')">
                <button name="btnReenviar" title="Reenviar" onClick="subsysNotificaciones.Main@Correo-btnReenviar-action"
                        colSpan="2"/>
                <button name="btnCancelSalirFallido" title="Salir" onClick="subsysNotificaciones.Main@Correo-btnCancel-action"
                        colSpan="2" colOffset="8" outline="true"/>
            </panel>
            <panel name="buttonsDetalle" title="" colSpan="12" showFrame="false"
                   showIf="((id != null) || (cid != null)) &amp;&amp; (estado != 'FALLIDO')">
                <button name="btnCancelSalir" title="Salir" onClick="subsysNotificaciones.Main@Correo-btnCancel-action"
                        colSpan="2" colOffset="10" outline="true"/>
            </panel>
        </panel>

    </form>

    <?sv-primary-actions?>

    <action-group name="subsysNotificaciones.Main@Correo-btnCancel-action">
        <action name="close"/>
    </action-group>

    <!-- remote-refreshTab-action refresca el listado de la pestaña porque refresh-tab llega a la pestaña ignorando
         los popups, y el alta se abre en popup sobre la elección de canal -->
    <action-group name="subsysNotificaciones.Main@Correo-btnSave-action">
        <action name="subsysNotificaciones.Main@Correo-Local-validateSave-action"/>
        <action name="remote-validationSave-action"/>
        <action name="save"/>
        <action name="remote-refreshTab-action"/>
        <action name="close"/>
    </action-group>

    <action-group name="subsysNotificaciones.Main@Correo-btnReenviar-action">
        <action name="subsysNotificaciones.Main@Correo-Remote-validateReenviar-action"/>
        <action name="subsysNotificaciones.Main@Correo-Remote-reenviar-action"/>
        <action name="remote-refreshTab-action"/>
    </action-group>

    <!-- Alta: el tipo de notificación lo dicta el servidor según la clase -->
    <action-group name="subsysNotificaciones.Main@Correo-onNew-action">
        <action name="subsysNotificaciones.Main@Correo-Remote-prepararAlta-action"/>
    </action-group>

    <action-group name="subsysNotificaciones.Main@Correo-onChange-centro-action">
        <action name="subsysNotificaciones.Main@Correo-set-historialEstado-null-action"/>
    </action-group>

    <?sv-validations?>

    <!-- Obligatorios en cliente, solo para evitar el viaje al servidor; la fuente
         de verdad es CorreoServiceImpl.validateInsert -->
    <action-condition name="subsysNotificaciones.Main@Correo-Local-validateSave-action">
        <check field="name" if="name == null || name.trim().isEmpty()"
               error="El motivo es obligatorio"/>
        <check field="centro" if="centro == null"
               error="El centro es obligatorio"/>
        <check field="dniDestinatario" if="dniDestinatario == null || dniDestinatario.trim().isEmpty()"
               error="El DNI del destinatario es obligatorio"/>
        <check field="nombre" if="nombre == null || nombre.trim().isEmpty()"
               error="El nombre es obligatorio"/>
        <check field="apellidos" if="apellidos == null || apellidos.trim().isEmpty()"
               error="Los apellidos son obligatorios"/>
        <check field="para" if="para == null || para.trim().isEmpty()"
               error="Debe indicar al menos un destinatario en el «para»"/>
        <check field="asunto" if="asunto == null || asunto.trim().isEmpty()"
               error="El asunto es obligatorio"/>
        <check field="cuerpo" if="cuerpo == null || cuerpo.trim().isEmpty()"
               error="El cuerpo es obligatorio"/>
    </action-condition>

    <?sv-rules?>

    <action-record name="subsysNotificaciones.Main@Correo-set-historialEstado-null-action" model="com.educaflow.subsystem.notificaciones.db.Correo">
        <field name="historialEstado" expr="eval: null"/>
    </action-record>

    <?sv-remotes?>

    <action-method name="subsysNotificaciones.Main@Correo-Remote-prepararAlta-action" model="com.educaflow.subsystem.notificaciones.db.Correo">
        <call class="com.educaflow.subsystem.notificaciones.controller.NotificacionController" method="prepararAlta"/>
    </action-method>

    <!-- También las usa Centro-Correo.xml -->
    <action-method name="subsysNotificaciones.Main@Correo-Remote-validateReenviar-action" model="com.educaflow.subsystem.notificaciones.db.Correo">
        <call class="com.educaflow.subsystem.notificaciones.controller.CorreoController" method="validateReenviar"/>
    </action-method>

    <action-method name="subsysNotificaciones.Main@Correo-Remote-reenviar-action" model="com.educaflow.subsystem.notificaciones.db.Correo">
        <call class="com.educaflow.subsystem.notificaciones.controller.CorreoController" method="reenviar"/>
    </action-method>

    <?sv-view?>

    <grid name="subsysNotificaciones.Main@Correo.Adjunto-grid" title="" model="com.educaflow.subsystem.notificaciones.db.Adjunto"
          canNew="true" newButtonTitle="Añadir adjunto" allowSearchFields="false" orderBy="nombreFichero"
          canAdvanceSearch="false" canRefresh="false" editable="false" edit-icon="false" x-selector="none"
          canEdit="false" canDelete="false" canSave="false" canEditOnClick="true">
        <field name="nombreFichero"/>
    </grid>

    <form name="subsysNotificaciones.Main@Correo.Adjunto-form" title="Adjunto" model="com.educaflow.subsystem.notificaciones.db.Adjunto"
          width="large" onNew="subsysNotificaciones.Main@Correo.Adjunto-onNew-action"
          canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel name="Adjunto" title="">
            <field name="nombreFichero" colSpan="8" required="true"/>
            <field name="contenido" colSpan="4" widget="binary-link" required="true"/>
            <field name="correo" showIf="false"/>
        </panel>
        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <panel name="buttonsAlta" title="" colSpan="12" showFrame="false"
                   showIf="(id == null) &amp;&amp; (cid == null)">
                <button name="btnCancelAlta" title="Cancelar" onClick="subsysNotificaciones.Main@Correo.Adjunto-btnCancel-action"
                        colSpan="2" colOffset="8" outline="true"/>
                <button name="btnSaveAlta" title="Guardar" onClick="subsysNotificaciones.Main@Correo.Adjunto-btnSave-action"
                        colSpan="2"/>
            </panel>
            <panel name="buttonsEdicion" title="" colSpan="12" showFrame="false"
                   showIf="(id != null) || (cid != null)">
                <button name="btnDelete" title="Borrar" onClick="subsysNotificaciones.Main@Correo.Adjunto-btnDelete-action"
                        css="btn-danger" colSpan="2" outline="true" showIf="(id!=null) || (cid!=null)"/>
                <button name="btnCancelSalir" title="Cancelar" onClick="subsysNotificaciones.Main@Correo.Adjunto-btnCancel-action"
                        colSpan="2" colOffset="6" outline="true"/>
                <button name="btnSaveEdicion" title="Guardar" onClick="subsysNotificaciones.Main@Correo.Adjunto-btnSave-action"
                        colSpan="2"/>
            </panel>
        </panel>
    </form>

    <?sv-primary-actions?>

    <action-group name="subsysNotificaciones.Main@Correo.Adjunto-btnCancel-action">
        <action name="close"/>
    </action-group>

    <!-- Añade el adjunto a la lista en memoria; se guarda de verdad al guardar el correo -->
    <action-group name="subsysNotificaciones.Main@Correo.Adjunto-btnSave-action">
        <action name="subsysNotificaciones.Main@Correo.Adjunto-Local-validateSave-action"/>
        <action name="save-modal"/>
    </action-group>

    <action-group name="subsysNotificaciones.Main@Correo.Adjunto-btnDelete-action">
        <action name="delete-modal"/>
    </action-group>

    <action-group name="subsysNotificaciones.Main@Correo.Adjunto-onNew-action">
        <action name="subsysNotificaciones.Main@Correo.Adjunto-set-correo-parent-action"/>
    </action-group>

    <?sv-validations?>

    <!-- Form modal: es la ÚNICA validación antes de cerrar la ventana, así que duplica todas las validaciones
         del adjunto evaluables en cliente. El límite de 10 MB lo aplica ya el subidor de la plataforma al subir.
         Es un <action-validate> y no un <action-condition> porque hay varias reglas sobre el mismo campo:
         ActionCondition guarda un único error por campo y el último <check> pisa a los anteriores, mientras
         que ActionValidate se para en el primer <error> que se cumple. El orden de los <error> es el de
         prioridad del aviso. -->
    <action-validate name="subsysNotificaciones.Main@Correo.Adjunto-Local-validateSave-action">
        <error if="nombreFichero == null || nombreFichero.trim().isEmpty()"
               message="El nombre del fichero es obligatorio"/>
        <error if="contenido == null"
               message="Debe adjuntar el fichero"/>
        <error if="nombreFichero != null &amp;&amp; nombreFichero =~ /[\/\\\p{Cntrl}]/"
               message="El nombre del fichero no puede contener los caracteres / \\ ni caracteres de control"/>
        <error if="nombreFichero != null &amp;&amp; nombreFichero.length() &gt; 255"
               message="El nombre del fichero no puede superar 255 caracteres"/>
        <error if="nombreFichero != null &amp;&amp; (nombreFichero.trim() == '.' || nombreFichero.trim() == '..')"
               message="El nombre del fichero no puede ser «.» ni «..»"/>
        <error if="contenido != null &amp;&amp; contenido.fileSize == 0"
               message="El fichero adjunto está vacío"/>
    </action-validate>

    <?sv-rules?>

    <action-record name="subsysNotificaciones.Main@Correo.Adjunto-set-correo-parent-action" model="com.educaflow.subsystem.notificaciones.db.Adjunto">
        <field name="correo" expr="eval: __parent__"/>
    </action-record>

    <?sv-remotes?>

</object-views>
