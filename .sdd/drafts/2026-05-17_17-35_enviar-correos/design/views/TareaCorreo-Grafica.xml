<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-view name="subsysCorreos.TareaCorreo@Grafica-action" title="Gráfica de correos enviados" model="com.educaflow.subsystem.correos.db.TareaCorreo">
        <view type="chart" name="subsysCorreos.TareaCorreo@Grafica-chart"/>
    </action-view>

    <chart name="subsysCorreos.TareaCorreo@Grafica-chart" title="Correos enviados por día"
           stacked="true" onInit="subsysCorreos.TareaCorreo@Grafica-onInit-action">
        <search-fields>
            <field type="date" name="fechaInicial" title="Fecha inicial" required="true"/>
            <field type="date" name="fechaFinal" title="Fecha final" required="true"/>
        </search-fields>
        <dataset type="jpql">
        <![CDATA[
        SELECT
            COUNT(self.id) AS total,
            CAST(self.fechaCreacion AS date) AS dia,
            CAST(self.estado AS string) AS estado
        FROM
            TareaCorreo self
        WHERE
            CAST(self.fechaCreacion AS date) >= :fechaInicial
            AND CAST(self.fechaCreacion AS date) <= :fechaFinal
        GROUP BY
            CAST(self.fechaCreacion AS date),
            self.estado
        ORDER BY
            dia
        ]]>
        </dataset>
        <category key="dia" type="date" title="Día"/>
        <series key="total" groupBy="estado" type="bar" title="Nº de correos"/>
        <actions>
            <action name="btnRefrescar" title="Refrescar" action="subsysCorreos.TareaCorreo@Grafica-btnRefrescar-action"/>
        </actions>
    </chart>


    <!-- *************** TareaCorreo@Grafica : Acciones de las tareas principales *************** -->
    <action-group name="subsysCorreos.TareaCorreo@Grafica-btnRefrescar-action">
        <action name="subsysCorreos.TareaCorreo@Grafica-Local-validateRangoFechas-action"/>
    </action-group>


    <!-- *************** TareaCorreo@Grafica : Acciones de Validaciones en local *************** -->
    <action-validate name="subsysCorreos.TareaCorreo@Grafica-Local-validateRangoFechas-action">
        <error message="El rango de fechas no es válido: la fecha inicial es posterior a la fecha final."
               if="fechaInicial != null &amp;&amp; fechaFinal != null &amp;&amp; fechaInicial &gt; fechaFinal"/>
    </action-validate>


    <!-- *************** TareaCorreo@Grafica : Acciones básicas que cambian campos simples *************** -->
    <action-record name="subsysCorreos.TareaCorreo@Grafica-onInit-action" model="com.educaflow.subsystem.correos.db.TareaCorreo">
        <field name="fechaInicial" expr="eval: LocalDate.now().withDayOfMonth(1)"/>
        <field name="fechaFinal" expr="eval: LocalDate.now()"/>
    </action-record>

</object-views>
