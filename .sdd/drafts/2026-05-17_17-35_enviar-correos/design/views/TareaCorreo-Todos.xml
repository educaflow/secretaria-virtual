<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <action-view name="subsysCorreos.TareaCorreo@Todos-action" title="Todos los correos" model="com.educaflow.subsystem.correos.db.TareaCorreo">
        <view type="grid" name="subsysCorreos.TareaCorreo@Todos-grid"/>
        <view type="form" name="subsysCorreos.TareaCorreo@Todos-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="reload-grid" value="true"/>
    </action-view>

    <grid name="subsysCorreos.TareaCorreo@Todos-grid" title="Todos los correos" model="com.educaflow.subsystem.correos.db.TareaCorreo"
          editable="false" edit-icon="false" x-selector="none" canNew="true" canEdit="false" canDelete="false" canSave="false"
          orderBy="-fechaCreacion" canEditOnClick="true">
        <field name="fechaCreacion"/>
        <field name="asunto"/>
        <field name="dniDestinatario"/>
        <field name="emailDestinatario"/>
        <field name="centro"/>
        <field name="estado"/>
    </grid>

    <form name="subsysCorreos.TareaCorreo@Todos-form" title="Detalle de correo" model="com.educaflow.subsystem.correos.db.TareaCorreo"
          canEdit="true" canAttach="false" canBack="false" canBackOnSave="true" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          related='{"adjuntos":["nombreFichero","contenidoFichero"]}'>

        <panel name="datosDelCorreo" title="Datos del correo" colSpan="12" readonlyIf="id != null">
            <field name="asunto" colSpan="12"/>
            <field name="dniDestinatario" colSpan="6"/>
            <field name="emailDestinatario" colSpan="6"/>
            <field name="centro" colSpan="6"/>
            <field name="historialEstado" colSpan="6"/>
        </panel>

        <panel name="contenido" title="Contenido" colSpan="12" readonlyIf="id != null">
            <field name="cuerpo" colSpan="12" widget="html" showTitle="false"/>
        </panel>

        <panel-related name="adjuntos" title="Adjuntos" field="adjuntos" colSpan="12"
                       grid-view="subsysCorreos.TareaCorreo.AdjuntoCorreo@Todos-grid"
                       form-view="subsysCorreos.TareaCorreo.AdjuntoCorreo@Todos-form"
                       readonlyIf="id != null"/>

        <panel name="estadoDelEnvio" title="Estado del envío" colSpan="12" readonly="true" showIf="id != null">
            <field name="estado" colSpan="4"/>
            <field name="fechaCreacion" colSpan="4"/>
            <field name="fechaUltimoIntento" colSpan="4"/>
            <field name="numeroIntentos" colSpan="4"/>
            <field name="motivoFallo" colSpan="12" showIf="motivoFallo != null"/>
        </panel>

        <panel name="buttons-panel" colSpan="12" showFrame="false">
            <button name="btnCancel" title="Cancelar" onClick="back" css="btn-secondary" colSpan="3" outline="true"/>
            <button name="btnSave" title="Guardar" onClick="save" colSpan="3" colOffset="3" showIf="id == null"/>
            <button name="btnReenviar" title="Reenviar" onClick="subsysCorreos.TareaCorreo@Todos-btnReenviar-action" colSpan="3" showIf="estado == 'FALLADO'"/>
        </panel>

    </form>

    <grid name="subsysCorreos.TareaCorreo.AdjuntoCorreo@Todos-grid" title="Adjuntos" model="com.educaflow.subsystem.correos.db.AdjuntoCorreo"
          edit-icon="false" x-selector="none" canNew="true" canEdit="true" canDelete="true" canSave="false" canViewOnClick="false"
          orderBy="nombreFichero">
        <field name="nombreFichero"/>
        <field name="contenidoFichero"/>
    </grid>

    <form name="subsysCorreos.TareaCorreo.AdjuntoCorreo@Todos-form" title="Adjunto" model="com.educaflow.subsystem.correos.db.AdjuntoCorreo"
          canAttach="false" canEdit="true" canBack="true" canDelete="false" canNew="false" canSave="true" canMore="false">
        <panel name="datosAdjunto" colSpan="12">
            <field name="nombreFichero" colSpan="12"/>
            <field name="contenidoFichero" colSpan="12"/>
        </panel>
    </form>


    <!-- *************** TareaCorreo@Todos : Acciones de las tareas principales *************** -->
    <action-group name="subsysCorreos.TareaCorreo@Todos-btnReenviar-action">
        <action name="subsysCorreos.TareaCorreo@Todos-Remote-reenviar-action"/>
        <action name="force-back"/>
    </action-group>


    <!-- *************** TareaCorreo@Todos : Acciones de llamadas Remotas al servidor *************** -->
    <action-method name="subsysCorreos.TareaCorreo@Todos-Remote-reenviar-action" model="com.educaflow.subsystem.correos.db.TareaCorreo">
        <call class="com.educaflow.subsystem.correos.controller.TareaCorreoController" method="btnReenviar"/>
    </action-method>

</object-views>
