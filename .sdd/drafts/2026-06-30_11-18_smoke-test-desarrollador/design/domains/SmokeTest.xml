<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
               https://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

    <module name="smoketest" package="com.educaflow.subsystem.smoketest.db"/>

    <!--
        Entidad de prueba sin valor de negocio.
        - texto:                   campo cliente; no lleva required="true" en el dominio para que
                                   la validación con el mensaje exacto del spec la gestione
                                   validateInsert/validateUpdate en el servicio (V-SmokeTest-001).
        - fechaCreacion:           campo servidor (CC-001); NO lleva required="true" porque lo
                                   asigna el servidor en insert vía R-SmokeTest-001.
        - fechaUltimaModificacion: campo servidor (CC-002); NO lleva required="true" porque lo
                                   asigna el servidor en insert y update vía R-SmokeTest-002.
    -->
    <entity name="SmokeTest">
        <string name="texto" title="Texto" large="true"/>
        <datetime name="fechaCreacion" title="Fecha de creación"/>
        <datetime name="fechaUltimaModificacion" title="Fecha de última modificación"/>
    </entity>

</domain-models>
