<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views
              https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">

    <!--
        Porción a FUSIONAR en src/main/java/com/educaflow/secretariavirtual/menus/menus.xml.

        El menuitem raíz «Desarrollador» (name="desarrollador-menuitem", groups="admins", order="90")
        YA EXISTE en el fichero de menús del proyecto (verificado en la exploración del código).
        Solo se añade el ítem hijo «Smoke test» en order="1".

        Las Utilidades de PDF ya cuelgan de «Desarrollador» con groups="admins" (order="2");
        no requieren modificación.
    -->
    <menuitem name="smoketest-menuitem"
              parent="desarrollador-menuitem"
              title="Smoke test"
              action="subsysSmokeTest.SmokeTest@Main-action"
              groups="admins"
              order="1"/>

</object-views>
