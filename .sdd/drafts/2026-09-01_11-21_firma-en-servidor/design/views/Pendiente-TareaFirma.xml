<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.1.xsd">


    <?sv-view?>
    <action-view name="subsysFirmas.Pendiente@TareaFirma-action" title="Documentos pendientes de firma" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <view type="grid" name="subsysFirmas.Pendiente@TareaFirma-grid"/>
        <view type="form" name="subsysFirmas.Pendiente@TareaFirma-form"/>
        <view-param name="show-toolbar-grid" value="false"/>
        <view-param name="show-toolbar-form" value="false"/>
        <view-param name="forceEdit" value="true"/>
        <view-param name="reload-grid" value="true"/>
        <domain>self.estadoTareaFirma= :estadoTareaFirma and firmante.id= :firmanteId</domain>
        <context name="estadoTareaFirma" expr="PENDIENTE"/>
        <context name="firmanteId" expr="eval:__user__.id"/>
    </action-view>

    <grid name="subsysFirmas.Pendiente@TareaFirma-grid" title="" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          editable="false" edit-icon="false" x-selector="none" canNew="false" canEdit="false" canDelete="false" canSave="false"
          orderBy="fechaSolicitud" canEditOnClick="true"
    >
        <field name="fechaSolicitud"/>
        <field name="firmante"/>
        <field name="motivoFirma"/>
        <field name="estadoTareaFirma"/>
    </grid>

    <form name="subsysFirmas.Pendiente@TareaFirma-form" title="Firma de documento" model="com.educaflow.subsystem.firmas.db.TareaFirma"
          canEdit="true" canAttach="false" canBack="false" canDelete="false" canNew="false" canSave="false" canCancel="false" canMore="false"
          onLoad="subsysFirmas.Pendiente@TareaFirma-onLoad-action" related='{"documentosFirma":["documentoOriginal","documentoFirmado"]}'
    >
        <panel name="tareaFirmaInsertDTO" title="Estado de la tarea a firmar" colSpan="12" readonly="true">
            <field name="motivoFirma"   colSpan="8"/>
            <field name="estadoTareaFirma"   colSpan="4"/>
            <field name="fechaSolicitud"   colSpan="4"/>
            <field name="fechaResolucion"   colSpan="4" showIf="fechaResolucion!=null"/>
            <field name="pasoActual" showIf="false"/>
            <field name="situacionFirma" showIf="false"/>
        </panel>


        <panel-related name="documentosFirma" title="Documentos a firmar" field="documentosFirma" colSpan="12"  readonly="true"
            grid-view="subsysFirmas.Pendiente@TareaFirma.DocumentoFirma-grid"
            form-view="subsysFirmas.Pendiente@TareaFirma.DocumentoFirma-form"
            canNew="false" showFooter="false" canEdit="false" canRemove="false" forceEdit="true"
        />



        <panel name="paso2Rechazado" title="Rechazar firmar el documento" colSpan="12"  showIf="pasoActual=='paso2Rechazado'">
            <field name="motivoRechazo"   colSpan="12" widget="Text"/>
        </panel>

        <panel name="paso2FirmarSinCertificado" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='SIN_CERTIFICADO'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Para firmar los documentos debe tener la aplicación de <a href="https://sede.serviciosmin.gob.es/es-es/firmaelectronica/paginas/autofirma.aspx" target="_blank">AutoFirma</a> instalada y un certificado digital válido.]]></help>
        </panel>

        <panel name="paso2FirmarDispositivoConPin" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='DISPOSITIVO_CON_PIN'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Los documentos se firmarán en el servidor con su certificado digital.]]></help>
        </panel>

        <panel name="paso2FirmarDispositivoSinPin" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='DISPOSITIVO_SIN_PIN'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Los documentos se firmarán en el servidor con su certificado digital. Introduzca el PIN de su dispositivo criptográfico.]]></help>
            <field name="claveFirma" title="PIN" widget="password" required="true" colSpan="4"/>
        </panel>

        <panel name="paso2FirmarFicheroConClave" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='FICHERO_CON_CLAVE'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Los documentos se firmarán en el servidor con su certificado digital.]]></help>
        </panel>

        <panel name="paso2FirmarFicheroSinClave" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='FICHERO_SIN_CLAVE'">
            <help variant="info" colSpan="12" colOffset="0" ><![CDATA[Los documentos se firmarán en el servidor con su certificado digital. Introduzca la contraseña de su certificado.]]></help>
            <field name="claveFirma" title="Contraseña" widget="password" required="true" colSpan="4"/>
        </panel>

        <panel name="paso2FirmarSinDni" title="Firmar el documento" colSpan="12"
               showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='SIN_DNI'">
            <help variant="warning" colSpan="12" colOffset="0" ><![CDATA[No es posible firmar los documentos porque su usuario no tiene un DNI. Póngase en contacto con el administrador.]]></help>
        </panel>

        <panel name="buttons-panel" title="" colSpan="12" showFrame="false">
            <panel name="buttonsPaso1Inicio" title="" colSpan="12" showFrame="false" showIf="pasoActual=='paso1Inicio'">
                <button name="btnPaso1InicioRechazar"   onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso1InicioRechazar-action" title="Rechazar firmar"           css="btn-secondary"  colSpan="3" outline="true" />
                <button name="btnPaso1InicioFirmar"     onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso1InicioFirmar-action"   title="Firmar todos los documentos"      colSpan="3" colOffset="6"  />
            </panel>
            <panel name="buttonsPaso2Rechazado" title="" colSpan="12" showFrame="false" showIf="pasoActual=='paso2Rechazado'">
                <button name="btnPaso2RechazadoAtras"   onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2RechazadoAtras-action"   title="Atrás"                      css="btn-secondary" colSpan="3" outline="true" />
                <button name="btnPaso2RechazadoGuardar" onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2RechazadoGuardar-action" title="Finalizar"                     colSpan="3" colOffset="6"  />
            </panel>
            <panel name="buttonsPaso2FirmarAutoFirma" title="" colSpan="12" showFrame="false"
                   showIf="pasoActual=='paso2Firmar' &amp;&amp; situacionFirma=='SIN_CERTIFICADO'">
                <button name="btnPaso2FirmarAtrasAutoFirma"  onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarAtras-action"  title="Atrás"   css="btn-secondary" colSpan="3" outline="true" />
                <button name="btnPaso2FirmarGuardar"    onClick="serial:subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarGuardar-firmarConAutoFirma-action,subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarGuardar-action" title="Firmar todos los documentos con AutoFirma__!! y finalizar"      colSpan="5" colOffset="4"  />
            </panel>
            <panel name="buttonsPaso2FirmarServidor" title="" colSpan="12" showFrame="false"
                   showIf="pasoActual=='paso2Firmar' &amp;&amp; (situacionFirma=='DISPOSITIVO_CON_PIN' || situacionFirma=='DISPOSITIVO_SIN_PIN' || situacionFirma=='FICHERO_CON_CLAVE' || situacionFirma=='FICHERO_SIN_CLAVE')">
                <button name="btnPaso2FirmarAtrasServidor"   onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarAtras-action"  title="Atrás"   css="btn-secondary" colSpan="3" outline="true" />
                <button name="btnPaso2FirmarServidorGuardar" onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarServidorGuardar-action" title="Firmar todos los documentos y finalizar"      colSpan="5" colOffset="4"  />
            </panel>
            <panel name="buttonsPaso2FirmarSinDni" title="" colSpan="12" showFrame="false"
                   showIf="pasoActual=='paso2Firmar' &amp;&amp; !(situacionFirma=='SIN_CERTIFICADO' || situacionFirma=='DISPOSITIVO_CON_PIN' || situacionFirma=='DISPOSITIVO_SIN_PIN' || situacionFirma=='FICHERO_CON_CLAVE' || situacionFirma=='FICHERO_SIN_CLAVE')">
                <button name="btnPaso2FirmarAtrasSinDni"    onClick="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarAtras-action"  title="Atrás"   css="btn-secondary" colSpan="3" outline="true" />
            </panel>
        </panel>
    </form>

    <?sv-primary-actions?>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso1InicioRechazar-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso2Rechazado-action"/>
    </action-group>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso1InicioFirmar-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-set-claveFirma-null-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso2Firmar-action"/>
    </action-group>

    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2RechazadoAtras-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso1Inicio-action"/>
    </action-group>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2RechazadoGuardar-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-Local-validateMarcarComoRechazada-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-marcarComoRechazada-action"/>
        <action name="force-back"/>
    </action-group>

    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarAtras-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso1Inicio-action"/>
    </action-group>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarGuardar-firmarConAutoFirma-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-firmarDocumentosConAutoFirma-action"/>
    </action-group>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarGuardar-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-validarDocumentosFirmados-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-marcarComoFirmada-action"/>
        <action name="force-back"/>
    </action-group>
    <action-group name="subsysFirmas.Pendiente@TareaFirma-btnPaso2FirmarServidorGuardar-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-Local-validateFirmarEnServidor-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-validateFirmarEnServidor-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-Remote-firmarEnServidor-action"/>
        <action name="force-back"/>
    </action-group>

    <action-group name="subsysFirmas.Pendiente@TareaFirma-onLoad-action">
        <action name="subsysFirmas.Pendiente@TareaFirma-set-claveFirma-null-action"/>
        <action name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso1Inicio-action"/>
    </action-group>


    <?sv-validations?>
    <action-condition name="subsysFirmas.Pendiente@TareaFirma-Local-validateMarcarComoRechazada-action">
        <check field="motivoRechazo"/>
    </action-condition>

    <action-validate name="subsysFirmas.Pendiente@TareaFirma-Local-validateFirmarEnServidor-action">
        <error message="El PIN es obligatorio" if="situacionFirma=='DISPOSITIVO_SIN_PIN' &amp;&amp; (claveFirma==null || claveFirma=='')"/>
        <error message="La contraseña es obligatoria" if="situacionFirma=='FICHERO_SIN_CLAVE' &amp;&amp; (claveFirma==null || claveFirma=='')"/>
    </action-validate>



    <?sv-rules?>
    <action-record name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso1Inicio-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso1Inicio" />
    </action-record>
    <action-record name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso2Rechazado-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Rechazado" />
    </action-record>
    <action-record name="subsysFirmas.Pendiente@TareaFirma-set-pasoActual-paso2Firmar-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="pasoActual" expr="paso2Firmar" />
    </action-record>
    <action-record name="subsysFirmas.Pendiente@TareaFirma-set-claveFirma-null-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <field name="claveFirma" expr="eval: null" />
    </action-record>




    <?sv-remotes?>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-validarDocumentosFirmados-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="validarDocumentosFirmados" />
    </action-method>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-marcarComoFirmada-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="marcarComoFirmada" />
    </action-method>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-marcarComoRechazada-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="marcarComoRechazada" />
    </action-method>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-firmarDocumentosConAutoFirma-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="firmarDocumentosConAutoFirma" />
    </action-method>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-validateFirmarEnServidor-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="validateFirmarEnServidor" />
    </action-method>
    <action-method name="subsysFirmas.Pendiente@TareaFirma-Remote-firmarEnServidor-action" model="com.educaflow.subsystem.firmas.db.TareaFirma">
        <call class="com.educaflow.subsystem.firmas.controller.TareaFirmaController" method="firmarEnServidor" />
    </action-method>


    <?sv-view?>
    <grid name="subsysFirmas.Pendiente@TareaFirma.DocumentoFirma-grid" title="" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          editable="false" edit-icon="false" x-selector="none" orderBy="documentoOriginal.fileName"
          canNew="false" canEdit="false" canDelete="false" canSave="false" canViewOnClick="true">
        <field name="documentoOriginal.fileName"/>
    </grid>
    <form name="subsysFirmas.Pendiente@TareaFirma.DocumentoFirma-form" title="Documento" model="com.educaflow.subsystem.firmas.db.DocumentoFirma"
          canAttach="false" canEdit="false" canBack="false" canDelete="false" canNew="false" canSave="false" canMore="false">
        <panel-tabs>
            <panel name="tabDocumentoOriginal" title="Documento original" colSpan="12">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoOriginal"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoOriginal.id}/content/download?inline=true&name=${documentoOriginal.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
            <panel name="tabDocumentoFirmado" title="Documento firmado" colSpan="12" showIf="documentoFirmado!=null">
                <field name="new" showTitle="false" readonly="true" colSpan="12">
                    <viewer depends="documentoFirmado"><![CDATA[
                        <>
                        <Box as="iframe" height="500" border="0" src={`ws/rest/com.axelor.meta.db.MetaFile/${documentoFirmado.id}/content/download?inline=true&name=${documentoFirmado.fileName}`}></Box>
                        </>
                    ]]></viewer>
                </field>
            </panel>
        </panel-tabs>
    </form>

    <?sv-primary-actions?>

    <?sv-validations?>

    <?sv-rules?>

    <?sv-remotes?>

</object-views>
