@startuml

class InstanciaGeneral {
  + exposición
  + solicitud
  + tipo de resolución
  + respuesta
  + datos a subsanar
  + fecha de presentación
  + fecha de resolución
  + documento de la instancia
  + documento de la respuesta
}

enum TipoResolucion {
  RESPONDER
  SUBSANAR_DATOS
}

class AdjuntoInstancia {
  + nombre descriptivo
  + fichero
}

InstanciaGeneral --> TipoResolucion
InstanciaGeneral "1" *-- "0..*" AdjuntoInstancia : adjuntos
@enduml
